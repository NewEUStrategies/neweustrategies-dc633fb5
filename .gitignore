# Raporty bramek CI (kontrakt bazy, parytet i18n, raport wdrożenia)
# Uwaga na wzorzec: `reports/` (z ukośnikiem) wyklucza KATALOG, a wtedy `!plik`
# w środku nie ma prawa go odzyskać - git nie wchodzi do wykluczonego katalogu.
# Dlatego wykluczamy ZAWARTOŚĆ (`reports/*`).
reports/*
# ...ale DWA raporty są kontraktem, nie artefaktem lokalnym, więc idą do repo:
# `i18n-parity.json` (stan parytetu słowników) oraz `bundle-baseline.json`
# (rozmiary chunków, wobec których bramka rozmiaru nazywa CO urosło). Baseline
# w katalogu ignorowanym jest per-developer, czyli w CI go nigdy nie ma - a bez
# niego bramka umie powiedzieć tylko „urosło o 12 KB", nie „urosło TO".
!reports/i18n-parity.json
!reports/bundle-baseline.json
.audit-findings.json

# Lockfile menedżera, którego ten projekt NIE używa. Kanoniczny lockfile to
# `bun.lock`; `npm install` jest tu wyłącznie obejściem na czas testów, gdy
# prywatny rejestr odrzuca `bun install --frozen-lockfile` bez tokena (403).
# Drugi lockfile w repo rozjeżdża rozwiązywanie zależności między CI i lokalnie,
# a jest generowany przy każdym takim obejściu - stąd wykluczenie, nie dyscyplina.
package-lock.json

# Claude Code: `.claude/settings.json` JEST kontraktem zespołu (marketplace
# wtyczek i lista włączonych wtyczek), więc idzie do repo. Wariant
# `*.local.json` to warstwa osobista - trafiają tam m.in. bloki `env`
# z kluczami API, których nie wolno commitować.
.claude/settings.local.json
.claude/*.local.json
