{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "./src/lib/i18n.ts",
    "./src/lib/i18n-*.ts"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/clean-vite-cache.mjs",
    "dev": "NODE_OPTIONS=\"--max-old-space-size=6144\" vite dev",
    "clean:vite-cache": "node scripts/clean-vite-cache.mjs",
    "build": "node scripts/clean-build-output.mjs && NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "build:dev": "node scripts/clean-build-output.mjs && NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:tsc && npm run typecheck:scripts",
    "typecheck:tsc": "NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:static": "bun run scripts/verify-static.ts",
    "verify:blocking": "bun run verify:static && bun run typecheck && bun run lint && bun run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:smoke": "node scripts/clean-build-output.mjs && NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --config vite.smoke.config.ts",
    "test:e2e:artifact": "playwright test --config playwright.artifact.config.ts",
    "test:e2e:performance": "node scripts/performance/run-first-visit.mjs",
    "measure:boot-ab": "bun run scripts/measure-boot-ab.ts",
    "db:test": "supabase test db",
    "migrate:blocks-to-builder": "bun run scripts/migrate-blocks-to-builder.ts",
    "verify:migration": "bun run scripts/verify-migration.ts",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "check:chunks": "bun run scripts/check-chunk-graph.ts",
    "check:chunk-parity": "vitest run src/lib/ci/__tests__/viteChunkParity.test.ts",
    "check:entry-purity": "bun run scripts/check-entry-purity.ts",
    "check:server-entry-purity": "bun run scripts/check-server-entry-purity.ts",
    "report:chunk-inventory": "bun run scripts/chunk-inventory.ts",
