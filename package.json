    "check:permissions-parity": "vitest run src/lib/authz src/lib/ci/__tests__/authzGates.test.ts src/components/admin/permissions",
    "check:sql-tenant-scope": "bun run scripts/check-sql-tenant-scope.ts",
    "check:sql-app-role": "bun run scripts/check-sql-app-role-literals.ts",
    "check:sql-anon-insert": "bun run scripts/check-sql-anon-insert.ts",
    "check:public-assets": "bun run scripts/check-public-asset-shadowing.ts",
    "check:legacy-payment-refs": "bun run scripts/check-legacy-payment-refs.ts",
    "check:stale-never-casts": "bun run scripts/check-stale-never-casts.ts",
