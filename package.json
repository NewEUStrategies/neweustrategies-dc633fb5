    "check:migration-ledger": "bun run scripts/check-migration-ledger.ts",
    "check:types-freshness": "bun run scripts/check-generated-types-freshness.ts",
    "check:db-row-casts": "bun run scripts/check-db-row-casts.ts",
    "check:i18n-hardcoded": "bun run scripts/check-i18n-hardcoded.ts",
    "check:i18n-default-value": "bun run scripts/check-i18n-default-value.ts",
    "codemod:i18n-default-value": "bun run scripts/codemod-i18n-default-value.ts",
    "check:i18n-overlay-imports": "bun run scripts/check-i18n-overlay-imports.ts",
    "check:i18n-parity": "vitest run src/__tests__/i18nParity.gate.test.ts src/__tests__/i18nKeyDrift.gate.test.ts src/lib/ci/__tests__/i18nParity.test.ts src/lib/ci/__tests__/i18nKeyUsage.test.ts src/lib/ci/__tests__/i18nDefaultValue.test.ts src/lib/ci/__tests__/i18nOverlayImports.test.ts src/lib/ci/__tests__/hardcodedLanguage.test.ts src/components/network/__tests__/networkI18nKeys.gate.test.ts src/components/clubs/__tests__/clubI18nKeys.gate.test.ts src/components/admin/events/__tests__/eventsI18nKeys.gate.test.ts src/components/admin/post-editor/__tests__/i18nParity.test.ts src/components/admin/post-editor/__tests__/workflowTriggerParity.gate.test.ts",
    "check:ci-gates": "vitest run src/lib/ci/__tests__",
    "check:widget-fidelity": "FIDELITY_REPORT=1 vitest run src/components/admin/builder/__tests__/settingsFidelity.gate.test.tsx src/components/admin/builder/__tests__/sampleDataLeak.gate.test.tsx src/lib/builder/__tests__/localizedQueryKeys.gate.test.ts",
    "report:deployment": "bun run scripts/deployment-report.ts",
    "report:route-loaders": "bun run scripts/report-public-route-loaders.ts",
    "cron:tick": "node scripts/scheduler-tick.mjs",
    "check:pg-harness": "bash scripts/pg-harness/run.sh",
    "check:careers-harness": "bash scripts/careers-harness/run.sh",
    "check:programs-harness": "bash scripts/programs-harness/run.sh",
    "check:events-harness": "bash scripts/events-harness/run.sh",
    "check:feature-taxonomy": "bun run scripts/check-feature-taxonomy.ts",
    "check:tenant-isolation": "bash scripts/tenant-isolation-harness/run.sh",
    "test:pgtap-local": "bash scripts/pgtap-local/run.sh",
    "test:platform": "vitest run --config vitest.platform.config.ts --coverage",
    "check:platform-coverage": "bun run scripts/check-platform-coverage.ts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit",
    "check:first-visit-regression": "node scripts/performance/compare-first-visit.mjs",
    "test:e2e:cms-performance": "node scripts/performance/run-cms-widgets.mjs",
    "test:cms-performance-harness": "tsc --noEmit -p tsconfig.cms-performance.json && node --test scripts/performance/cms-harness.test.mjs"
