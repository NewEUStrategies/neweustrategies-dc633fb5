    "check:content-layering": "bun run scripts/check-content-layering.ts",
    "check:dangerous-html": "bun run scripts/check-dangerous-html.ts",
    "check:client-ip-source": "bun run scripts/check-client-ip-source.ts",
    "check:ssr-budgets": "bun run scripts/check-ssr-budgets.ts",
