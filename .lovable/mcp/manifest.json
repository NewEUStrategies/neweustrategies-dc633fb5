{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://unnltowbgszpdzwpawdu.supabase.co/auth/v1",
    "resource_name": "New European Strategies",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ],
    "jwks_uri": "https://unnltowbgszpdzwpawdu.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "mcp": {
    "server": {
      "name": "new-european-strategies",
      "version": "1.0.0",
      "title": "New European Strategies"
    },
    "tools": [
      {
        "name": "list_recent_posts",
        "title": "List recent posts",
        "description": "List the most recently published New European Strategies articles, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lang": {
              "default": "pl",
              "description": "Language variant: 'pl' (Polish, default) or 'en' (English).",
              "type": "string",
              "enum": [
                "pl",
                "en"
              ]
            },
            "limit": {
              "default": 10,
              "description": "Maximum posts to return (1-50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cover_image_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "published_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "post_format": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "title",
                  "excerpt",
                  "cover_image_url",
                  "published_at",
                  "post_format"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "results"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "search_posts",
        "title": "Search posts",
        "description": "Search published New European Strategies articles by keyword in titles and excerpts of the chosen language. Returns slug, title, excerpt, publish date, format and cover image.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Search phrase."
            },
            "lang": {
              "default": "pl",
              "description": "Language variant: 'pl' (Polish, default) or 'en' (English).",
              "type": "string",
              "enum": [
                "pl",
                "en"
              ]
            },
            "limit": {
              "default": 10,
              "description": "Maximum posts to return (1-50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "excerpt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cover_image_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "published_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "post_format": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "title",
                  "excerpt",
                  "cover_image_url",
                  "published_at",
                  "post_format"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "results"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "get_post",
        "title": "Get post by slug",
        "description": "Fetch one published New European Strategies article by its slug, including the full body when the signed-in account has access to it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Post slug."
            },
            "lang": {
              "default": "pl",
              "description": "Language variant: 'pl' (Polish, default) or 'en' (English).",
              "type": "string",
              "enum": [
                "pl",
                "en"
              ]
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "post": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "excerpt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "cover_image_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "published_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "post_format": {
                      "type": "string"
                    },
                    "body": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "body_available": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "excerpt",
                    "cover_image_url",
                    "published_at",
                    "post_format",
                    "body",
                    "body_available"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "post"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
}
