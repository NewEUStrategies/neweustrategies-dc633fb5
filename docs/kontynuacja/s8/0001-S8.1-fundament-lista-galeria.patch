+// Tworzenie ścieżki (S8): instalacja szablonu z galerii albo pusta ścieżka.
+//
+// SZABLON: klucz techniczny, nazwa i - dla szablonu usługowego - język
+// podstawy prawnej (szablon niesie ją w PL i EN). Instalacja zakłada SZKIC
+// z grafem i treścią maili (`installJourneyTemplate`); nic nie jest wysyłane,
+// dopóki admin nie przeczyta treści i nie opublikuje ścieżki.
+//
+// PUSTA ŚCIEŻKA WYMAGA WYZWALACZA. `admin_journey_create` zapisuje szkic
+// `{graph:{nodes:[],edges:[]}, settings:{}}`, który nie przechodzi
+// `JourneyDraftSchema` (brak `settings.triggerEventType`) - edytor dostałby
+// szkic „niepoprawny” od pierwszej sekundy. Dlatego formularz pyta
+// o wyzwalacz, a `useCreateJourney` od razu zapisuje pusty graf
+// (`emptyJourneyGraph()`: wyzwalacz -> koniec) z tokenem z utworzenia.
+// Gdyby ten drugi zapis się nie udał, ścieżka i tak istnieje - mówimy to
+// i otwieramy edytor, gdzie wyzwalacz da się ustawić.
+//
+// LIMITY = LICZNIKI, ODRZUCENIE ZAMIAST PRZYCIĘCIA (AGENTS). Pola nie mają
+// `maxLength` (przeglądarka ucinałaby wklejony tekst bez słowa) - licznik
+// pokazuje limit bazy, a przekroczenie blokuje zapis z komunikatem. Zajęty
+// klucz (`duplicate`/`key_taken`) wraca jako błąd pola, nie ogólny toast.
+import { useId, useMemo, useState, type ReactNode } from "react";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+
+import { MfaRequiredNotice } from "@/components/admin/revenue/molecules/MfaRequiredNotice";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { PlatformSelect } from "@/components/ui/platform-select";
+import { Textarea } from "@/components/ui/textarea";
+import { isMfaRequiredError } from "@/lib/admin/journeys/access";
+import type { JourneyTemplateCatalogEntry } from "@/lib/admin/journeys/journeyEditor.functions";
+import {
+  mutationErrorText,
+  useCreateJourney,
+  useInstallJourneyTemplate,
+  type JourneyMutationFailure,
+} from "@/lib/admin/journeys/journeyMutations";
+import {
+  JOURNEY_CATEGORY_HINT_KEY,
+  JOURNEY_CATEGORY_LABEL_KEY,
+} from "@/lib/admin/journeys/summaries";
+import { ensureI18n as ensureJourneysI18n } from "@/lib/i18n-admin-journeys";
+import { ensureI18n } from "@/lib/i18n-admin-journeys-list";
+import {
+  journeyLabelKey,
+  journeyTemplateLabelKeys,
+  journeyTriggerLabelKey,
+} from "@/lib/journeys/labels";
+import { JOURNEY_CATEGORIES, JOURNEY_LIMITS, type JourneyCategory } from "@/lib/journeys/limits";
+import { JOURNEY_TRIGGERS, journeyTrigger, type TriggerGroup } from "@/lib/journeys/triggers";
+
+export type JourneyCreateMode =
+  { kind: "template"; entry: JourneyTemplateCatalogEntry } | { kind: "blank" };
+
+export interface JourneyCreateDialogProps {
+  mode: JourneyCreateMode | null;
+  onOpenChange: (open: boolean) => void;
+  tenantId: string | null;
+  /** Klucze ścieżek najemcy - podpowiedź wolnego klucza i błąd przed zapisem. */
+  existingKeys: ReadonlySet<string>;
+  onCreated: (journeyId: string) => void;
+}
+
+/** Grupy wyzwalaczy w kolejności katalogu S5 (pierwsze wystąpienie). */
+const TRIGGER_GROUPS: readonly TriggerGroup[] = [
+  ...new Set(JOURNEY_TRIGGERS.map((trigger) => trigger.group)),
+];
+
+/** Klucz z nazwy: małe litery ASCII, cyfry i „-” (polskie znaki bez ogonków). */
+function slugify(text: string): string {
+  return text
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/ł/g, "l")
+    .replace(/Ł/g, "L")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 64)
+    .replace(/-+$/g, "");
+}
+
+/** Pierwszy wolny klucz: `baza`, `baza-2`, `baza-3`… */
+function freeKey(base: string, taken: ReadonlySet<string>): string {
+  if (!taken.has(base)) return base;
+  for (let n = 2; ; n += 1) {
+    const candidate = `${base.slice(0, 60)}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
+}
+
+export function JourneyCreateDialog({
+  mode,
+  onOpenChange,
+  tenantId,
+  existingKeys,
+  onCreated,
+}: JourneyCreateDialogProps) {
+  ensureJourneysI18n();
+  ensureI18n();
+  const { t } = useTranslation();
+  const templateName =
+    mode?.kind === "template" ? t(journeyTemplateLabelKeys(mode.entry.key).name) : "";
+  return (
+    <Dialog open={mode !== null} onOpenChange={onOpenChange}>
+      <DialogContent
+        data-testid="journey-create-dialog"
+        className="max-h-[90vh] max-w-xl overflow-y-auto rounded-[6px]"
+      >
+        <DialogHeader>
+          <DialogTitle>
+            {mode?.kind === "template"
+              ? t("adminJourneys.create.templateTitle", { name: templateName })
+              : t("adminJourneys.create.blankTitle")}
+          </DialogTitle>
+          <DialogDescription>
+            {mode?.kind === "template"
+              ? t("adminJourneys.create.templateDescription")
+              : t("adminJourneys.create.blankDescription")}
+          </DialogDescription>
+        </DialogHeader>
+        {mode !== null ? (
+          <CreateForm
+            key={mode.kind === "template" ? mode.entry.key : "blank"}
+            mode={mode}
+            defaultName={templateName}
+            tenantId={tenantId}
+            existingKeys={existingKeys}
+            onCancel={() => onOpenChange(false)}
+            onCreated={onCreated}
+          />
+        ) : null}
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+type FieldKey = "key" | "name" | "legalBasis" | "description" | "trigger";
+
+function CreateForm({
+  mode,
+  defaultName,
+  tenantId,
+  existingKeys,
+  onCancel,
+  onCreated,
+}: {
+  mode: JourneyCreateMode;
+  defaultName: string;
+  tenantId: string | null;
+  existingKeys: ReadonlySet<string>;
+  onCancel: () => void;
+  onCreated: (journeyId: string) => void;
+}) {
+  const { t } = useTranslation();
+  const id = useId();
+  const template = mode.kind === "template" ? mode.entry : null;
+  const [name, setName] = useState(defaultName);
+  const [key, setKey] = useState(() => (template ? freeKey(template.key, existingKeys) : ""));
+  const [keyEdited, setKeyEdited] = useState(template !== null);
+  const [category, setCategory] = useState<JourneyCategory>("marketing");
+  const [legalBasis, setLegalBasis] = useState("");
+  const [description, setDescription] = useState("");
+  const [trigger, setTrigger] = useState("");
+  const [locale, setLocale] = useState<"pl" | "en">("pl");
+  const [touched, setTouched] = useState(false);
+  const [serverKeyTaken, setServerKeyTaken] = useState<string | null>(null);
+  const [failure, setFailure] = useState<string | null>(null);
+  const [mfaRequired, setMfaRequired] = useState(false);
+  const install = useInstallJourneyTemplate(tenantId);
+  const create = useCreateJourney(tenantId);
+  const pending = install.isPending || create.isPending;
+
+  const effectiveKey = keyEdited ? key : slugify(name);
+  const errors = useMemo(() => {
+    const out: Partial<Record<FieldKey, string>> = {};
+    if (!JOURNEY_LIMITS.keyPattern.test(effectiveKey)) out.key = "adminJourneys.create.keyInvalid";
+    else if (existingKeys.has(effectiveKey) || serverKeyTaken === effectiveKey) {
+      out.key = "adminJourneys.create.keyTaken";
+    }
+    const trimmed = name.trim();
+    if (trimmed.length < JOURNEY_LIMITS.nameMin || trimmed.length > JOURNEY_LIMITS.nameMax) {
+      out.name = "adminJourneys.create.nameInvalid";
+    }
+    if (template === null) {
+      if (category === "service") {
+        const basis = legalBasis.trim();
+        if (basis.length === 0 || basis.length > JOURNEY_LIMITS.legalBasisMax) {
+          out.legalBasis = "adminJourneys.create.legalBasisRequired";
+        }
+      }
+      if (description.trim().length > JOURNEY_LIMITS.descriptionMax) {
+        out.description = "adminJourneys.create.descriptionTooLong";
+      }
+      if (trigger === "") out.trigger = "adminJourneys.create.triggerRequired";
+    }
+    return out;
+  }, [
+    effectiveKey,
+    existingKeys,
+    serverKeyTaken,
+    name,
+    template,
+    category,
+    legalBasis,
+    description,
+    trigger,
+  ]);
+  const valid = Object.keys(errors).length === 0;
+  // Błąd pola widać po pierwszej próbie zapisu; wcześniej tylko te, które
+  // pomagają w trakcie pisania (klucz zajęty/zły, za długi opis) - pusty
+  // formularz nie zaczyna od czerwieni.
+  const show = (field: FieldKey) =>
+    errors[field] &&
+    (touched || (field === "key" && effectiveKey !== "") || field === "description")
+      ? t(errors[field] as string)
+      : undefined;
+
+  const handleFailure = (result: JourneyMutationFailure) => {
+    if (result.error === "duplicate" || result.reason === "key_taken") {
+      setServerKeyTaken(effectiveKey);
+      return;
+    }
+    if (result.error === "template_unavailable") {
+      setFailure(t("adminJourneys.create.templateUnavailable"));
+      return;
+    }
+    setFailure(mutationErrorText(t, result));
+  };
+
+  const submit = async () => {
+    setTouched(true);
+    setFailure(null);
+    if (!valid || pending) return;
+    try {
+      if (template !== null) {
+        const result = await install.mutateAsync({
+          templateKey: template.key,
+          key: effectiveKey,
+          name: name.trim(),
+          locale,
+        });
+        if (!result.ok) return handleFailure(result);
+        toast.success(t("adminJourneys.create.installed"));
+        onCreated(result.data.id);
+        return;
+      }
+      const result = await create.mutateAsync({
+        key: effectiveKey,
+        name: name.trim(),
+        category,
+        legalBasis: category === "service" ? legalBasis.trim() : null,
+        description: description.trim() || null,
+        triggerEventType: trigger,
+      });
+      if (!result.ok) return handleFailure(result);
+      if (result.draftSaved) toast.success(t("adminJourneys.create.created"));
+      else toast.warning(t("adminJourneys.create.draftNotSaved"));
+      onCreated(result.data.id);
+    } catch (error) {
+      if (isMfaRequiredError(error)) setMfaRequired(true);
+      else setFailure(t("adminJourneys.create.error"));
+    }
+  };
+
+  if (mfaRequired) return <MfaRequiredNotice />;
+
+  const describedBy = (...parts: (string | false | undefined)[]) =>
+    parts.filter(Boolean).join(" ") || undefined;
+  const nameLength = name.trim().length;
+  const selectedTrigger = trigger ? journeyTrigger(trigger) : null;
+
+  return (
+    <form
+      noValidate
+      className="space-y-4"
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submit();
+      }}
+    >
+      <FormField
+        id={`${id}-name`}
+        label={t("adminJourneys.create.name")}
+        counter={t("adminJourneys.common.counter", {
+          count: nameLength,
+          max: JOURNEY_LIMITS.nameMax,
+        })}
+        error={show("name")}
+      >
+        <Input
+          id={`${id}-name`}
+          value={name}
+          required
+          aria-invalid={show("name") ? true : undefined}
+          aria-describedby={describedBy(`${id}-name-counter`, show("name") && `${id}-name-error`)}
+          onChange={(event) => setName(event.target.value)}
+        />
+      </FormField>
+
+      <FormField
+        id={`${id}-key`}
+        label={t("adminJourneys.create.key")}
+        hint={t("adminJourneys.create.keyHint")}
+        error={show("key")}
+      >
+        <Input
+          id={`${id}-key`}
+          value={effectiveKey}
+          required
+          spellCheck={false}
+          autoCapitalize="off"
+          className="font-mono"
+          aria-invalid={show("key") ? true : undefined}
+          aria-describedby={describedBy(`${id}-key-hint`, show("key") && `${id}-key-error`)}
+          onChange={(event) => {
+            setKeyEdited(true);
+            setKey(event.target.value);
+          }}
+        />
+      </FormField>
+
+      {template !== null ? (
+        template.hasLegalBasis ? (
+          <FormField
+            id={`${id}-locale`}
+            label={t("adminJourneys.create.language")}
+            hint={t("adminJourneys.create.languageHint")}
+          >
+            <PlatformSelect
+              id={`${id}-locale`}
+              value={locale}
+              aria-describedby={`${id}-locale-hint`}
+              onChange={(event) => setLocale(event.target.value === "en" ? "en" : "pl")}
+            >
+              <option value="pl">{t("adminJourneys.create.languagePl")}</option>
+              <option value="en">{t("adminJourneys.create.languageEn")}</option>
+            </PlatformSelect>
+          </FormField>
+        ) : null
+      ) : (
+        <>
+          <FormField
+            id={`${id}-trigger`}
+            label={t("adminJourneys.create.trigger")}
+            hint={
+              selectedTrigger?.emailForbidden
+                ? t("adminJourneys.create.triggerEmailForbidden")
+                : t("adminJourneys.create.triggerHint")
+            }
+            error={show("trigger")}
+          >
+            <PlatformSelect
+              id={`${id}-trigger`}
+              value={trigger}
+              required
+              placeholder={t("adminJourneys.create.triggerPlaceholder")}
+              aria-invalid={show("trigger") ? true : undefined}
+              aria-describedby={describedBy(
+                `${id}-trigger-hint`,
+                show("trigger") && `${id}-trigger-error`,
+              )}
+              onChange={(event) => setTrigger(event.target.value)}
+            >
+              {TRIGGER_GROUPS.map((group) => (
+                <optgroup key={group} label={t(journeyLabelKey("triggerGroup", group))}>
+                  {JOURNEY_TRIGGERS.filter((def) => def.group === group).map((def) => (
+                    <option key={def.eventType} value={def.eventType}>
+                      {t(journeyTriggerLabelKey(def.eventType))}
+                    </option>
+                  ))}
+                </optgroup>
+              ))}
+            </PlatformSelect>
+          </FormField>
+
+          <FormField
+            id={`${id}-category`}
+            label={t("adminJourneys.create.category")}
+            hint={t(JOURNEY_CATEGORY_HINT_KEY[category])}
+          >
+            <PlatformSelect
+              id={`${id}-category`}
+              value={category}
+              aria-describedby={`${id}-category-hint`}
+              onChange={(event) =>
+                setCategory(event.target.value === "service" ? "service" : "marketing")
+              }
+            >
+              {JOURNEY_CATEGORIES.map((value) => (
+                <option key={value} value={value}>
+                  {t(JOURNEY_CATEGORY_LABEL_KEY[value])}
+                </option>
+              ))}
+            </PlatformSelect>
+          </FormField>
+
+          {category === "service" ? (
+            <FormField
+              id={`${id}-legal`}
+              label={t("adminJourneys.create.legalBasis")}
+              hint={t("adminJourneys.create.legalBasisHint")}
+              counter={t("adminJourneys.common.counter", {
+                count: legalBasis.trim().length,
+                max: JOURNEY_LIMITS.legalBasisMax,
+              })}
+              error={show("legalBasis")}
+            >
+              <Textarea
+                id={`${id}-legal`}
+                value={legalBasis}
+                required
+                rows={2}
+                aria-invalid={show("legalBasis") ? true : undefined}
+                aria-describedby={describedBy(
+                  `${id}-legal-hint`,
+                  `${id}-legal-counter`,
+                  show("legalBasis") && `${id}-legal-error`,
+                )}
+                onChange={(event) => setLegalBasis(event.target.value)}
+              />
+            </FormField>
+          ) : null}
+
+          <FormField
+            id={`${id}-description`}
+            label={t("adminJourneys.create.description")}
+            counter={t("adminJourneys.common.counter", {
+              count: description.trim().length,
+              max: JOURNEY_LIMITS.descriptionMax,
+            })}
+            error={show("description")}
+          >
+            <Textarea
+              id={`${id}-description`}
+              value={description}
+              rows={2}
+              aria-invalid={show("description") ? true : undefined}
+              aria-describedby={describedBy(
+                `${id}-description-counter`,
+                show("description") && `${id}-description-error`,
+              )}
+              onChange={(event) => setDescription(event.target.value)}
+            />
+          </FormField>
+        </>
+      )}
+
+      {failure !== null ? (
+        <p role="alert" className="text-sm text-destructive">
+          {failure}
+        </p>
+      ) : null}
+
+      <DialogFooter className="gap-2 sm:gap-0">
+        <Button type="button" variant="outline" onClick={onCancel}>
+          {t("adminJourneys.common.cancel")}
+        </Button>
+        <Button type="submit" disabled={pending || (touched && !valid)}>
+          {pending
+            ? t("adminJourneys.create.submitting")
+            : template !== null
+              ? t("adminJourneys.create.submitTemplate")
+              : t("adminJourneys.create.submitBlank")}
+        </Button>
+      </DialogFooter>
+    </form>
+  );
+}
+
+function FormField({
+  id,
+  label,
+  hint,
+  counter,
+  error,
+  children,
+}: {
+  id: string;
+  label: string;
+  hint?: string;
+  counter?: string;
+  error?: string;
+  children: ReactNode;
+}) {
+  return (
+    <div className="space-y-1">
+      <Label htmlFor={id} className="text-xs font-medium">
+        {label}
+      </Label>
+      {children}
+      <div className="flex flex-wrap items-start justify-between gap-2 text-xs">
+        <div className="min-w-0 space-y-0.5">
+          {hint ? (
+            <p id={`${id}-hint`} className="text-muted-foreground">
+              {hint}
+            </p>
+          ) : null}
+          {error ? (
+            <p id={`${id}-error`} className="text-destructive">
+              {error}
+            </p>
+          ) : null}
+        </div>
+        {counter ? (
+          <span id={`${id}-counter`} className="shrink-0 tabular-nums text-muted-foreground">
+            {counter}
+          </span>
+        ) : null}
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/admin/journeys/list/JourneyEngineHealthStrip.tsx b/src/components/admin/journeys/list/JourneyEngineHealthStrip.tsx
new file mode 100644
index 000000000..62df8bf36
--- /dev/null
+++ b/src/components/admin/journeys/list/JourneyEngineHealthStrip.tsx
@@ -0,0 +1,242 @@
+// Pasek zdrowia silnika ścieżek nad listą (S8, SPEC §6.3) - czy silnik działa,
+// ile kontaktów czeka, kiedy wykonał się ostatni krok i czy były błędy.
+//
+// PO CO NAD LISTĄ. Ścieżka „aktywna” przy wyłączonym silniku, wyłączniku
+// awaryjnym albo niepodpiętym harmonogramie wygląda na liście tak samo jak
+// działająca - a nie wysyła niczego. Pasek mówi to JEDNYM komunikatem
+// (`engineHealthNotice`, od najważniejszego), zanim admin zacznie szukać
+// błędu w samej ścieżce.
+//
+// Z-S5-03. Runner ścieżek nie jest jeszcze podpięty do `jobs-tick` (I9), więc
+// włączony silnik z kontaktami „do wykonania” i bez żadnego wykonanego kroku
+// to stan oczekiwany, nie awaria - komunikat mówi wprost, że kroki ruszą po
+// podpięciu harmonogramu. Odczyt odświeża się co minutę
+// (`JOURNEY_HEALTH_REFETCH_MS`), a poprzednia liczba „do wykonania” pozwala
+// odróżnić kolejkę rosnącą od opróżnianej.
+//
+// KOLOR NIGDY SAM: stan silnika to ikona + słowo, komunikat to `role="status"`
+// z treścią. Wejście w ustawienia: admin edytuje, redaktor widzi podgląd.
+import { useEffect, useId, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { AlertTriangle, CheckCircle2, Info, XCircle } from "lucide-react";
+import { useTranslation } from "react-i18next";
+
+import { Button } from "@/components/ui/button";
+import {
+  JOURNEY_ENGINE_NOTICE_KEY,
+  engineHealthNotice,
+  type JourneyEngineNotice,
+} from "@/lib/admin/journeys/summaries";
+import { chartLangFrom } from "@/lib/charts/format";
+import { ensureI18n as ensureJourneysI18n } from "@/lib/i18n-admin-journeys";
+import { ensureI18n } from "@/lib/i18n-admin-journeys-list";
+import type { JourneyEngineHealthDto } from "@/lib/journeys/dto";
+import { journeyLabelKey } from "@/lib/journeys/labels";
+import { journeyEngineHealthQueryOptions } from "@/lib/journeys/queries";
+
+const LOCALE = { pl: "pl-PL", en: "en-GB" } as const;
+
+export interface JourneyEngineHealthStripProps {
+  tenantId: string | null;
+  /** Admin - ustawienia do edycji; redaktor - podgląd. */
+  canManageEngine: boolean;
+  onOpenSettings: () => void;
+}
+
+export function JourneyEngineHealthStrip({
+  tenantId,
+  canManageEngine,
+  onOpenSettings,
+}: JourneyEngineHealthStripProps) {
+  ensureJourneysI18n();
+  ensureI18n();
+  const { t } = useTranslation();
+  const headingId = useId();
+  const query = useQuery(journeyEngineHealthQueryOptions(tenantId));
+  const health = query.data?.state === "ready" ? query.data.data : null;
+
+  return (
+    <section
+      aria-labelledby={headingId}
+      data-tour="journeys-engine"
+      data-testid="journey-engine-health"
+      className="space-y-3 rounded-[6px] border border-border bg-card p-4"
+    >
+      <div className="flex flex-wrap items-start justify-between gap-2">
+        <div className="flex flex-wrap items-center gap-2">
+          <h2 id={headingId} className="text-base font-semibold">
+            {t("adminJourneys.health.title")}
+          </h2>
+          {health ? <EngineStatePill health={health} /> : null}
+        </div>
+        {query.data?.state === "unavailable" ? null : (
+          <Button
+            type="button"
+            size="sm"
+            variant="outline"
+            className="h-7"
+            onClick={onOpenSettings}
+          >
+            {t(
+              canManageEngine
+                ? "adminJourneys.engineStrip.settings"
+                : "adminJourneys.engineStrip.preview",
+            )}
+          </Button>
+        )}
+      </div>
+      {query.isLoading ? (
+        <p role="status" aria-live="polite" className="text-sm text-muted-foreground">
+          {t("adminJourneys.engineStrip.loading")}
+        </p>
+      ) : query.isError ? (
+        <div className="flex flex-wrap items-center gap-2 text-sm">
+          <p className="text-destructive">{t("adminJourneys.engineStrip.loadError")}</p>
+          <Button
+            type="button"
+            size="sm"
+            variant="ghost"
+            className="h-7"
+            onClick={() => void query.refetch()}
+          >
+            {t("adminJourneys.common.retry")}
+          </Button>
+        </div>
+      ) : query.data?.state === "unavailable" ? (
+        <p role="status" className="text-sm text-muted-foreground">
+          {t("adminJourneys.engineStrip.unavailable")}
+        </p>
+      ) : health ? (
+        <HealthBody health={health} dataUpdatedAt={query.dataUpdatedAt} />
+      ) : null}
+    </section>
+  );
+}
+
+function EngineStatePill({ health }: { health: JourneyEngineHealthDto }) {
+  const { t } = useTranslation();
+  const [Icon, key] = health.killSwitch
+    ? [AlertTriangle, "adminJourneys.engineStrip.killSwitch"]
+    : health.enabled
+      ? [CheckCircle2, "adminJourneys.engineStrip.enabled"]
+      : [XCircle, "adminJourneys.engineStrip.disabled"];
+  return (
+    <span
+      data-engine-state={
+        health.killSwitch ? "kill_switch" : health.enabled ? "enabled" : "disabled"
+      }
+      className="inline-flex items-center gap-1 rounded-full border border-border px-2 py-0.5 text-xs font-medium"
+    >
+      <Icon className="h-3.5 w-3.5" aria-hidden="true" />
+      {t(key)}
+    </span>
+  );
+}
+
+function HealthBody({
+  health,
+  dataUpdatedAt,
+}: {
+  health: JourneyEngineHealthDto;
+  dataUpdatedAt: number;
+}) {
+  const { t, i18n } = useTranslation();
+  const locale = LOCALE[chartLangFrom(i18n.language)];
+  // Poprzedni odczyt „do wykonania” - rosnąca kolejka bez kroków to Z-S5-03.
+  const [trend, setTrend] = useState<{ at: number; due: number; previous: number | null } | null>(
+    null,
+  );
+  useEffect(() => {
+    setTrend((current) =>
+      current?.at === dataUpdatedAt
+        ? current
+        : { at: dataUpdatedAt, due: health.dueNow, previous: current?.due ?? null },
+    );
+  }, [dataUpdatedAt, health.dueNow]);
+
+  const notice: JourneyEngineNotice = engineHealthNotice(
+    health,
+    Date.now(),
+    trend?.previous ?? null,
+  );
+  const formatTime = (iso: string | null) =>
+    iso === null
+      ? t("adminJourneys.engineStrip.never")
+      : new Intl.DateTimeFormat(locale, { dateStyle: "short", timeStyle: "short" }).format(
+          new Date(iso),
+        );
+  const number = (value: number) => new Intl.NumberFormat(locale).format(value);
+
+  const metrics: readonly { key: string; label: string; value: string }[] = [
+    {
+      key: "journeysActive",
+      label: t("adminJourneys.health.journeysActive"),
+      value: number(health.journeysActive),
+    },
+    {
+      key: "inboxPending",
+      label: t("adminJourneys.health.inboxPending"),
+      value: number(health.inboxPending),
+    },
+    { key: "dueNow", label: t("adminJourneys.health.dueNow"), value: number(health.dueNow) },
+    {
+      key: "lastStepAt",
+      label: t("adminJourneys.health.lastStepAt"),
+      value: formatTime(health.lastStepAt),
+    },
+    {
+      key: "messages24h",
+      label: t("adminJourneys.health.messages24h"),
+      value: number(health.messages24h),
+    },
+    {
+      key: "failed24h",
+      label: t("adminJourneys.health.failed24h"),
+      value: number(health.failed24h),
+    },
+  ];
+
+  return (
+    <div className="space-y-3">
+      <dl className="grid grid-cols-2 gap-x-4 gap-y-2 text-xs sm:grid-cols-3 lg:grid-cols-6">
+        {metrics.map((metric) => (
+          <div key={metric.key} data-metric={metric.key} className="min-w-0 space-y-0.5">
+            <dt className="text-muted-foreground">{metric.label}</dt>
+            <dd className="font-medium tabular-nums text-foreground">{metric.value}</dd>
+          </div>
+        ))}
+      </dl>
+      {notice !== null ? (
+        <p
+          role="status"
+          data-notice={notice}
+          className="flex items-start gap-2 rounded-[6px] border border-border bg-muted/30 p-2 text-xs text-foreground"
+        >
+          {notice === "kill_switch" || notice === "stalled" || notice === "errors" ? (
+            <AlertTriangle className="mt-0.5 h-3.5 w-3.5 shrink-0" aria-hidden="true" />
+          ) : (
+            <Info className="mt-0.5 h-3.5 w-3.5 shrink-0" aria-hidden="true" />
+          )}
+          <span>{t(JOURNEY_ENGINE_NOTICE_KEY[notice])}</span>
+        </p>
+      ) : null}
+      {health.lastErrors.length > 0 ? (
+        <details className="text-xs">
+          <summary className="cursor-pointer font-medium">
+            {t("adminJourneys.health.lastErrors")} ({health.lastErrors.length})
+          </summary>
+          <ul className="mt-2 space-y-1">
+            {health.lastErrors.map((entry, index) => (
+              <li key={`${entry.createdAt}-${index}`} className="text-muted-foreground">
+                <span className="font-medium text-foreground">
+                  {t(journeyLabelKey("enginePhase", entry.phase))}
+                </span>{" "}
+                · {formatTime(entry.createdAt)} · {entry.error}
+              </li>
+            ))}
+          </ul>
+        </details>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/admin/journeys/list/JourneyList.tsx b/src/components/admin/journeys/list/JourneyList.tsx
new file mode 100644
index 000000000..e5db2bf12
--- /dev/null
+++ b/src/components/admin/journeys/list/JourneyList.tsx
@@ -0,0 +1,375 @@
+// Lista ścieżek komunikacji (S8, SPEC §6.3) - tabela z wyszukiwaniem i filtrem
+// statusu w ADRESIE (`?q=`, `?status=`), wiersz prowadzi do edytora
+// (`/admin/revenue/journeys/$journeyId`).
+//
+// KOLUMNY = PYTANIA ADMINA: jak się nazywa i z jakiego szablonu, czy działa,
+// na co startuje, ilu kontaktów jest w toku, ilu weszło i ilu doszło do celu
+// w 30 dni, która wersja jest opublikowana. Liczby z `admin_journey_list`
+// (zapisy testowe wykluczone po stronie bazy).
+//
+// FILTR W ADRESIE, NIE W STANIE. Link „Ścieżki · Wstrzymane” wysłany koledze
+// i powrót z edytora (okruszki) pokazują tę samą listę; zakładka przepisuje
+// `?q=` z `replace`, więc pisanie nie zaśmieca historii przeglądarki.
+//
+// AKCJE STATUSU TYLKO DLA ADMINA (`setJourneyStatus` = `requireAdmin`):
+// wstrzymaj, wznów, archiwizuj - każda z potwierdzeniem i tokenem
+// `updated_at` (wyścig z edytorem w innej karcie kończy się komunikatem
+// o konflikcie zamiast cichego nadpisania). Wynik `ok:false` nie rzuca -
+// tłumaczymy kod i powód (`mutationErrorText`).
+//
+// DOSTĘPNOŚĆ: tabela z `caption` i `scope`, nazwa ścieżki to nagłówek wiersza
+// z odnośnikiem (klik w wiersz to tylko skrót myszy), przewijany region
+// z `tabIndex=0` i nazwą (wąski ekran nie dostaje poziomego paska strony).
+import { useId, useState } from "react";
+import { Link, useNavigate } from "@tanstack/react-router";
+import { CheckCircle2, Info, Lock, Timer } from "lucide-react";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+
+import { ConfirmDialog, type ConfirmState } from "@/components/admin/ConfirmDialog";
+import { AdminCatalogListState } from "@/components/admin/molecules/AdminCatalogListState";
+import { AdminListToolbar } from "@/components/admin/molecules/AdminListToolbar";
+import { Button } from "@/components/ui/button";
+import { PlatformSelect } from "@/components/ui/platform-select";
+import { isMfaRequiredError } from "@/lib/admin/journeys/access";
+import { mutationErrorText, useSetJourneyStatus } from "@/lib/admin/journeys/journeyMutations";
+import { JOURNEY_STATUS_LABEL_KEY, matchesSearch } from "@/lib/admin/journeys/summaries";
+import { chartLangFrom } from "@/lib/charts/format";
+import { ensureI18n as ensureJourneysI18n } from "@/lib/i18n-admin-journeys";
+import { ensureI18n } from "@/lib/i18n-admin-journeys-list";
+import type { JourneyListItem } from "@/lib/journeys/dto";
+import { journeyTriggerLabelKey } from "@/lib/journeys/labels";
+import { JOURNEY_STATUSES, type JourneyStatus } from "@/lib/revenue/search";
+
+const LOCALE = { pl: "pl-PL", en: "en-GB" } as const;
+
+const STATUS_ICON = {
+  draft: Info,
+  active: CheckCircle2,
+  paused: Timer,
+  archived: Lock,
+} as const satisfies Record<JourneyStatus, unknown>;
+
+type StatusAction = "paused" | "active" | "archived";
+
+export interface JourneyListProps {
+  items: readonly JourneyListItem[] | null;
+  isLoading: boolean;
+  /** Komunikat awarii odczytu albo `null`. */
+  errorMessage: string | null;
+  status: JourneyStatus | null;
+  query: string;
+  onStatusChange: (status: JourneyStatus | null) => void;
+  onQueryChange: (query: string) => void;
+  tenantId: string | null;
+  /** Admin: pauza, wznowienie, archiwum. */
+  canChangeStatus: boolean;
+  /** Pusta lista bez filtra - zakładka pokazuje obok galerię. */
+  emptyLabel: string;
+  /** Odmowa `aal2` przy zmianie statusu - zakładka pokazuje `MfaRequiredNotice`. */
+  onMfaRequired?: () => void;
+}
+
+export function JourneyList({
+  items,
+  isLoading,
+  errorMessage,
+  status,
+  query,
+  onStatusChange,
+  onQueryChange,
+  tenantId,
+  canChangeStatus,
+  emptyLabel,
+  onMfaRequired,
+}: JourneyListProps) {
+  ensureJourneysI18n();
+  ensureI18n();
+  const { t, i18n } = useTranslation();
+  const locale = LOCALE[chartLangFrom(i18n.language)];
+  const navigate = useNavigate();
+  const captionId = useId();
+  const statusId = useId();
+  const [confirm, setConfirm] = useState<ConfirmState | null>(null);
+  const setStatus = useSetJourneyStatus(tenantId);
+
+  const triggerLabel = (item: JourneyListItem) =>
+    item.triggerEventType
+      ? t(journeyTriggerLabelKey(item.triggerEventType))
+      : t("adminJourneys.list.noTrigger");
+
+  // Szukanie obejmuje też PRZETŁUMACZONĄ nazwę wyzwalacza - admin wpisuje
+  // „porzucona kasa”, a nie `checkout.abandoned.v1`.
+  const visible = (items ?? []).filter(
+    (item) =>
+      (status === null || item.status === status) &&
+      matchesSearch(query, item.name, item.key, item.triggerEventType ? triggerLabel(item) : ""),
+  );
+
+  const number = (value: number) => new Intl.NumberFormat(locale).format(value);
+  const percent = (value: number) =>
+    new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 1 }).format(value);
+
+  const run = async (item: JourneyListItem, next: StatusAction) => {
+    try {
+      const result = await setStatus.mutateAsync({
+        journeyId: item.id,
+        status: next,
+        expectedUpdatedAt: item.updatedAt,
+      });
+      if (result.ok) toast.success(t(DONE_KEY[next]));
+      else toast.error(mutationErrorText(t, result));
+    } catch (error) {
+      if (isMfaRequiredError(error)) onMfaRequired?.();
+      else toast.error(t("adminJourneys.list.statusError"));
+    }
+  };
+
+  const ask = (item: JourneyListItem, next: StatusAction) =>
+    setConfirm({
+      title: t(CONFIRM_KEY[next].title, { name: item.name }),
+      description: t(CONFIRM_KEY[next].body),
+      confirmLabel: t(ACTION_KEY[next].label),
+      cancelLabel: t("adminJourneys.common.cancel"),
+      destructive: next === "archived",
+      onConfirm: () => run(item, next),
+    });
+
+  const filtered = status !== null || query.trim() !== "";
+
+  return (
+    <div className="space-y-2">
+      <AdminListToolbar
+        search={query}
+        onSearch={onQueryChange}
+        searchPlaceholder={t("adminJourneys.list.searchPlaceholder")}
+        hideStatus
+        hideLang
+        hideAuthor
+        resultsCount={items ? visible.length : undefined}
+        totalCount={items?.length}
+        extraRight={
+          <div className="flex items-center gap-2">
+            <label htmlFor={statusId} className="sr-only">
+              {t("adminJourneys.list.statusFilter")}
+            </label>
+            <PlatformSelect
+              id={statusId}
+              value={status ?? ""}
+              className="h-8 w-44 text-xs"
+              onChange={(event) => {
+                const value = event.target.value;
+                onStatusChange(
+                  (JOURNEY_STATUSES as readonly string[]).includes(value)
+                    ? (value as JourneyStatus)
+                    : null,
+                );
+              }}
+            >
+              <option value="">{t("adminJourneys.list.statusAll")}</option>
+              {JOURNEY_STATUSES.map((value) => (
+                <option key={value} value={value}>
+                  {t(JOURNEY_STATUS_LABEL_KEY[value])}
+                </option>
+              ))}
+            </PlatformSelect>
+          </div>
+        }
+      />
+      <AdminCatalogListState
+        isLoading={isLoading}
+        loadingLabel={t("adminJourneys.list.loading")}
+        errorMessage={errorMessage}
+        isEmpty={visible.length === 0}
+        emptyLabel={filtered ? t("adminJourneys.list.emptyFiltered") : emptyLabel}
+      >
+        <div
+          role="region"
+          aria-label={t("adminJourneys.list.scrollRegion")}
+          tabIndex={0}
+          className="overflow-x-auto rounded-[6px] border border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+        >
+          <table className="w-full min-w-[760px] text-left text-xs">
+            <caption id={captionId} className="sr-only">
+              {t("adminJourneys.list.caption")}
+            </caption>
+            <thead className="bg-muted/30 text-muted-foreground">
+              <tr>
+                <th scope="col" className="px-3 py-2 font-medium">
+                  {t("adminJourneys.list.columns.name")}
+                </th>
+                <th scope="col" className="px-3 py-2 font-medium">
+                  {t("adminJourneys.list.columns.status")}
+                </th>
+                <th scope="col" className="px-3 py-2 font-medium">
+                  {t("adminJourneys.list.columns.trigger")}
+                </th>
+                <th scope="col" className="px-3 py-2 text-right font-medium">
+                  {t("adminJourneys.list.columns.active")}
+                </th>
+                <th scope="col" className="px-3 py-2 text-right font-medium">
+                  {t("adminJourneys.list.columns.enrolled30d")}
+                </th>
