+function actionsFor(item: JourneyListItem): StatusAction[] {
+  const out: StatusAction[] = [];
+  if (item.status === "active") out.push("paused");
+  if (item.status === "paused") out.push("active");
+  if (item.status !== "archived") out.push("archived");
+  return out;
