+    expect(engineHealthNotice(health(), NOW)).toBeNull();
+  });
+
+  it("kolejka malejąca (ktoś wykonuje kroki) to nie „harmonogram niepodpięty”", () => {
+    expect(engineHealthNotice(health({ dueNow: 2 }), NOW, 5)).toBeNull();
+  });
+
+  it("każdy komunikat i etykieta stanu ma tłumaczenie", () => {
+    for (const key of [
+      ...Object.values(JOURNEY_ENGINE_NOTICE_KEY),
+      ...Object.values(JOURNEY_STATUS_LABEL_KEY),
+      ...Object.values(JOURNEY_CATEGORY_LABEL_KEY),
+      ...Object.values(JOURNEY_CATEGORY_HINT_KEY),
+      ...Object.values(JOURNEY_REENTRY_LABEL_KEY),
+    ]) {
+      noRawKey(pl(key));
+      noRawKey(en(key));
+    }
+  });
+});
+
+// ── Słownik S8-A ────────────────────────────────────────────────────────────
+
+type Tree = { [key: string]: string | Tree };
+
+function leaves(tree: Tree, prefix = ""): string[] {
+  return Object.entries(tree).flatMap(([key, value]) =>
+    typeof value === "string" ? [`${prefix}${key}`] : leaves(value, `${prefix}${key}.`),
+  );
+}
+
+const PLURAL = /_(zero|one|two|few|many|other)$/;
+
+function productionSources(dir: string): string[] {
+  return readdirSync(dir).flatMap((entry) => {
+    const path = join(dir, entry);
+    if (statSync(path).isDirectory()) return entry === "__tests__" ? [] : productionSources(path);
+    return /\.(ts|tsx)$/.test(entry) && !/\.test\./.test(entry) ? [readFileSync(path, "utf8")] : [];
+  });
+}
+
+describe("słownik `i18n-admin-journeys-list` (S8-A)", () => {
+  const plTree = journeysListDictionaries.pl as unknown as Tree;
+  const enTree = journeysListDictionaries.en as unknown as Tree;
+  const plKeys = leaves(plTree);
+
+  it("parytet PL/EN: te same klucze, EN niepusty i różny tam, gdzie to zdanie", () => {
+    expect(leaves(enTree)).toEqual(plKeys);
+    for (const key of plKeys) {
+      const value = key.split(".").reduce<unknown>((node, part) => (node as Tree)[part], enTree);
+      expect(typeof value === "string" && value.trim() !== "", key).toBe(true);
+    }
+  });
+
+  it("liczebniki: każda grupa ma formy _one/_few/_many/_other", () => {
+    const bases = new Set(plKeys.filter((k) => PLURAL.test(k)).map((k) => k.replace(PLURAL, "")));
+    for (const base of bases) {
+      for (const form of ["one", "few", "many", "other"])
+        expect(plKeys, base).toContain(`${base}_${form}`);
+    }
+  });
+
+  it("zero kolizji z kluczami S5 (`i18n-admin-journeys`)", () => {
+    const s5 = new Set(leaves(journeysDictionaries.pl as unknown as Tree));
+    const s5Branches = new Set(
+      leaves(journeysDictionaries.pl as unknown as Tree).map((k) =>
+        k.split(".").slice(0, 2).join("."),
+      ),
+    );
+    expect(plKeys.filter((key) => s5.has(key))).toEqual([]);
+    const mine = new Set(plKeys.map((k) => k.split(".").slice(0, 2).join(".")));
+    expect([...mine].filter((branch) => s5Branches.has(branch))).toEqual([]);
+    expect([...mine].sort()).toEqual([
+      "adminJourneys.common",
+      "adminJourneys.create",
+      "adminJourneys.engineSettings",
+      "adminJourneys.engineStrip",
+      "adminJourneys.gallery",
+      "adminJourneys.list",
+    ]);
+  });
+
+  it("każdy klucz ma czytelnika w kodzie produkcyjnym S8-A", () => {
+    const sources = [
+      ...productionSources("src/lib/admin/journeys"),
+      ...productionSources("src/components/admin/journeys/list"),
+      readFileSync("src/components/admin/revenue/tabs/RevenueJourneysTab.tsx", "utf8"),
+    ].join("\n");
+    const unread = plKeys
+      .map((key) => key.replace(PLURAL, ""))
+      .filter((key, index, all) => all.indexOf(key) === index)
+      .filter((key) => !sources.includes(`"${key}"`));
+    expect(unread).toEqual([]);
+  });
+});
diff --git a/src/lib/admin/journeys/__tests__/viewModel.test.ts b/src/lib/admin/journeys/__tests__/viewModel.test.ts
new file mode 100644
index 000000000..0f5eca7d8
--- /dev/null
+++ b/src/lib/admin/journeys/__tests__/viewModel.test.ts
@@ -0,0 +1,280 @@
+// Model widoku ścieżki (S8): DAG -> drzewo z chipami scaleń i numeracją.
+//
+// CO TEN PLIK DOWODZI.
+//   1. Krok z kilkoma rodzicami stoi pod PIERWSZYM (kolejność krawędzi),
+//      reszta wejść to chipy „→ dalej jak w kroku …” z numerem celu.
+//   2. Dzieci w kolejności gałęzi typu (tak przed nie, A przed B), niezależnie
+//      od kolejności krawędzi w tablicy.
+//   3. Numeracja hierarchiczna: ciąg główny 1, 2, 3…, gałąź i kroku k ->
+//      „k.i.1”, dalej „k.i.2”… Stabilna przy zmianie kolejności niezwiązanych
+//      krawędzi, po wstawieniu kroku w innej gałęzi i po dopisaniu brakującej
+//      gałęzi „tak” (gałąź „nie” zostaje „k.2.*”).
+//   4. Graf niepoprawny (cykl, sieroty, brak wyzwalacza, pusty szkic, krawędź
+//      wisząca, zdublowany identyfikator) daje widok, nie wyjątek.
+//   5. Każdy z 14 szablonów S5 ma pełną, unikalną numerację.
+import { describe, expect, it } from "vitest";
+
+import { insertAfter } from "../ops";
+import { buildJourneyView, compareStepNumbers, type JourneyGraphLike } from "../viewModel";
+import { emptyJourneyGraph, type JourneyGraph } from "@/lib/journeys/graph";
+import type { JourneyEdgeBranch, JourneyNodeType } from "@/lib/journeys/nodeTypes";
+import { JOURNEY_TEMPLATES } from "@/lib/journeys/templates";
+
+const node = (id: string, type: JourneyNodeType, params: unknown = {}) => ({ id, type, params });
+const edge = (from: string, to: string, branch: JourneyEdgeBranch = "next") => ({
+  from,
+  to,
+  branch,
+});
+
+const IF_PARAMS = { match: "all", predicates: [{ kind: "consent", marketing: true }] };
+const AB_PARAMS = { weights: { A: 50, B: 50 }, winnerMetric: "click" };
+const WAIT = { mode: "duration", minutes: 60 };
+
+/** Wyzwalacz -> mail -> warunek; tak -> cel; nie -> czekanie -> mail -> koniec. */
+function branchy(): JourneyGraph {
+  return {
+    nodes: [
+      node("t", "trigger"),
+      node("m1", "send_email"),
+      node("if", "if_else", IF_PARAMS),
+      node("g", "goal"),
+      node("w", "wait", WAIT),
+      node("m2", "send_email"),
+      node("x", "exit"),
+    ],
+    // Gałąź „nie” CELOWO przed „tak” - kolejność dzieci ma iść z typu kroku.
+    edges: [
+      edge("t", "m1"),
+      edge("m1", "if"),
+      edge("if", "w", "no"),
+      edge("if", "g", "yes"),
+      edge("w", "m2"),
+      edge("m2", "x"),
+    ],
+  };
+}
+
+/** Test A/B, oba ramiona zbiegają się w jednym czekaniu (scalenie). */
+function merged(): JourneyGraph {
+  return {
+    nodes: [
+      node("t", "trigger"),
+      node("split", "ab_split", AB_PARAMS),
+      node("ma", "send_email"),
+      node("mb", "send_email"),
+      node("join", "wait", WAIT),
+      node("x", "exit"),
+    ],
+    edges: [
+      edge("t", "split"),
+      edge("split", "ma", "A"),
+      edge("split", "mb", "B"),
+      edge("ma", "join"),
+      edge("mb", "join"),
+      edge("join", "x"),
+    ],
+  };
+}
+
+function numbers(graph: JourneyGraphLike | null): Record<string, string> {
+  return Object.fromEntries(buildJourneyView(graph).numbering);
+}
+
+describe("drzewo z DAG", () => {
+  it("dzieci w kolejności gałęzi typu: tak przed nie, mimo odwrotnej kolejności krawędzi", () => {
+    const view = buildJourneyView(branchy());
+    expect(view.nodes.get("if")?.children).toEqual(["g", "w"]);
+    expect(view.nodes.get("g")).toMatchObject({
+      parentId: "if",
+      branch: "yes",
+      depth: 3,
+      branchLevel: 1,
+    });
+    expect(view.nodes.get("w")).toMatchObject({
+      parentId: "if",
+      branch: "no",
+      depth: 3,
+      branchLevel: 1,
+    });
+    expect(view.order).toEqual(["t", "m1", "if", "g", "w", "m2", "x"]);
+    expect(view.root?.id).toBe("t");
+    expect(view.merges).toEqual([]);
+    expect(view.unreachable).toEqual([]);
+  });
+
+  it("krok z dwoma rodzicami stoi pod PIERWSZYM, drugie wejście to chip z numerem celu", () => {
+    const view = buildJourneyView(merged());
+    expect(view.nodes.get("join")?.parentId).toBe("ma");
+    expect(view.nodes.get("mb")?.children).toEqual([]);
+    expect(view.nodes.get("mb")?.slots).toEqual([{ kind: "merge", branch: "next", to: "join" }]);
+    expect(view.merges).toEqual([
+      { from: "mb", to: "join", branch: "next", targetNumber: "2.1.2" },
+    ]);
+    // Krok scalenia nie dubluje się w kolejności widoku.
+    expect(view.order.filter((id) => id === "join")).toHaveLength(1);
+  });
+
+  it("brakująca gałąź to wyjście „open” w swojej pozycji", () => {
+    const graph = branchy();
+    graph.edges = graph.edges.filter((e) => e.branch !== "yes");
+    graph.nodes = graph.nodes.filter((n) => n.id !== "g");
+    const view = buildJourneyView(graph);
+    expect(view.nodes.get("if")?.slots).toEqual([
+      { kind: "open", branch: "yes" },
+      { kind: "child", branch: "no", id: "w" },
+    ]);
+  });
+});
+
+describe("numeracja hierarchiczna", () => {
+  it("ciąg główny 1, 2, 3…, gałąź i kroku k: k.i.1, k.i.2…", () => {
+    expect(numbers(branchy())).toEqual({
+      t: "1",
+      m1: "2",
+      if: "3",
+      g: "3.1.1",
+      w: "3.2.1",
+      m2: "3.2.2",
+      x: "3.2.3",
+    });
+    expect(numbers(merged())).toEqual({
+      t: "1",
+      split: "2",
+      ma: "2.1.1",
+      join: "2.1.2",
+      x: "2.1.3",
+      mb: "2.2.1",
+    });
+    expect(numbers(emptyJourneyGraph())).toEqual({ trigger: "1", exit: "2" });
+  });
+
+  it("jest stabilna przy zmianie kolejności NIEZWIĄZANYCH krawędzi", () => {
+    const base = numbers(merged());
+    const graph = merged();
+    // Odwrócona tablica z zachowaną kolejnością dwóch wejść do `join`.
+    const shuffled = [...graph.edges].reverse();
+    const intoJoin = shuffled.filter((e) => e.to === "join").reverse();
+    let k = 0;
+    graph.edges = shuffled.map((e) => (e.to === "join" ? intoJoin[k++] : e));
+    expect(numbers(graph)).toEqual(base);
+  });
+
+  it("kolejność krawędzi WCHODZĄCYCH do scalenia decyduje o rodzicu (reguła udokumentowana)", () => {
+    const graph = merged();
+    const [a, b] = [graph.edges[3], graph.edges[4]];
+    graph.edges[3] = b;
+    graph.edges[4] = a;
+    const view = buildJourneyView(graph);
+    expect(view.nodes.get("join")?.parentId).toBe("mb");
+    expect(view.numbering.get("join")).toBe("2.2.2");
+    expect(view.merges).toEqual([
+      { from: "ma", to: "join", branch: "next", targetNumber: "2.2.2" },
+    ]);
+  });
+
+  it("wstawienie kroku w jednej gałęzi nie zmienia numerów drugiej ani kroków przed nią", () => {
+    const before = numbers(merged());
+    const result = insertAfter(merged(), "mb", "next", "wait");
+    if (!result.ok) throw new Error(result.error);
+    const after = numbers(result.graph);
+    for (const id of ["t", "split", "ma", "join", "x", "mb"]) expect(after[id]).toBe(before[id]);
+    expect(after[result.created[0]]).toBe("2.2.2");
+  });
+
+  it("dopisanie brakującej gałęzi „tak” nie przenumerowuje gałęzi „nie”", () => {
+    const graph = branchy();
+    graph.edges = graph.edges.filter((e) => e.branch !== "yes");
+    graph.nodes = graph.nodes.filter((n) => n.id !== "g");
+    const incomplete = numbers(graph);
+    expect(incomplete.w).toBe("3.2.1");
+    expect(numbers(branchy()).w).toBe("3.2.1");
+  });
+
+  it("compareStepNumbers porządkuje składowa po składowej, pusty numer na końcu", () => {
+    const sorted = ["10", "3.2.1", "", "2", "3.1.1", "3", "3.1.10", "3.1.2"].sort(
+      compareStepNumbers,
+    );
+    expect(sorted).toEqual(["2", "3", "3.1.1", "3.1.2", "3.1.10", "3.2.1", "10", ""]);
+  });
+});
+
+describe("graf niepoprawny - widok bez wyjątku", () => {
+  it("pusty szkic i brak grafu: brak korzenia, pusta kolejność", () => {
+    for (const graph of [{ nodes: [], edges: [] }, null, undefined]) {
+      const view = buildJourneyView(graph);
+      expect(view.root).toBeNull();
+      expect(view.order).toEqual([]);
+      expect(view.unreachable).toEqual([]);
+    }
+  });
+
+  it("cykl kończy się chipem scalenia, a nie pętlą", () => {
+    const graph = {
+      nodes: [node("t", "trigger"), node("a", "wait", WAIT), node("b", "wait", WAIT)],
+      edges: [edge("t", "a"), edge("a", "b"), edge("b", "a")],
+    };
+    const view = buildJourneyView(graph);
+    expect(view.order).toEqual(["t", "a", "b"]);
+    expect(view.merges).toEqual([{ from: "b", to: "a", branch: "next", targetNumber: "2" }]);
+  });
+
+  it("cykl odcinający „pierwszego” rodzica: krok i tak trafia do drzewa", () => {
+    const graph = {
+      nodes: [node("t", "trigger"), node("a", "wait", WAIT), node("b", "wait", WAIT)],
+      // Pierwsza krawędź do `a` wychodzi z `b`, które jest osiągalne tylko przez `a`.
+      edges: [edge("b", "a"), edge("t", "a"), edge("a", "b")],
+    };
+    const view = buildJourneyView(graph);
+    expect(new Set(view.order)).toEqual(new Set(["t", "a", "b"]));
+    expect(view.nodes.get("a")?.parentId).toBe("t");
+    expect(view.merges.map((m) => `${m.from}->${m.to}`)).toEqual(["b->a"]);
+  });
+
+  it("sieroty: lista nieosiągalnych, osobne drzewo bez numerów", () => {
+    const graph = {
+      nodes: [node("t", "trigger"), node("e", "exit"), node("o", "wait", WAIT), node("oe", "exit")],
+      edges: [edge("t", "e"), edge("o", "oe")],
+    };
+    const view = buildJourneyView(graph);
+    expect(view.unreachable).toEqual(["o", "oe"]);
+    expect(view.detachedRoots).toEqual(["o"]);
+    expect(view.nodes.get("oe")).toMatchObject({ parentId: "o", number: "", reachable: false });
+    expect(view.order).toEqual(["t", "e", "o", "oe"]);
+    expect(view.numbering.has("o")).toBe(false);
+  });
+
+  it("brak wyzwalacza: korzenia brak, wszystko poza przepływem", () => {
+    const graph = { nodes: [node("w", "wait", WAIT), node("e", "exit")], edges: [edge("w", "e")] };
+    const view = buildJourneyView(graph);
+    expect(view.root).toBeNull();
+    expect(view.unreachable).toEqual(["w", "e"]);
+    expect(view.detachedRoots).toEqual(["w"]);
+  });
+
+  it("krawędź wisząca znika, zdublowany identyfikator - wygrywa pierwszy wpis", () => {
+    const graph = {
+      nodes: [node("t", "trigger"), node("e", "exit"), node("e", "goal")],
+      edges: [edge("t", "e"), edge("t", "ghost", "yes")],
+    };
+    const view = buildJourneyView(graph);
+    expect(view.nodes.get("e")?.type).toBe("exit");
+    expect(view.order).toEqual(["t", "e"]);
+    expect(view.nodes.get("t")?.slots).toEqual([{ kind: "child", branch: "next", id: "e" }]);
+  });
+});
+
+describe("szablony S5", () => {
+  it.each(
+    Object.values(JOURNEY_TEMPLATES).map((template) => [template.key, template.graph] as const),
+  )("%s: każdy krok ma unikalny numer, kolejność obejmuje wszystkie kroki", (_key, graph) => {
+    const view = buildJourneyView(graph);
+    expect(view.root?.type).toBe("trigger");
+    expect(view.root?.number).toBe("1");
+    expect(view.order).toHaveLength(graph.nodes.length);
+    expect(new Set(view.order)).toEqual(new Set(graph.nodes.map((n) => n.id)));
+    const all = [...view.numbering.values()];
+    expect(new Set(all).size).toBe(graph.nodes.length);
+    expect(view.unreachable).toEqual([]);
+  });
+});
diff --git a/src/lib/admin/journeys/access.ts b/src/lib/admin/journeys/access.ts
new file mode 100644
index 000000000..170170db0
--- /dev/null
+++ b/src/lib/admin/journeys/access.ts
@@ -0,0 +1,95 @@
+// UPRAWNIENIA I MFA W UI ŚCIEŻEK (S8) - lustro bramek serwera, nie autorytet.
+//
+// KTO CO MOŻE (SPEC §2.5, `journeys.functions.ts`): odczyt, szkic, treść maila,
+// test na sobie i wyjście kontaktu - `requireCrmStaff` (admin albo redaktor);
+// publikacja, status, ustawienia silnika i pominięcie czekania -
+// `requireAdmin`. Panel nie proponuje akcji, którą serwer odrzuci: redaktor
+// widzi ustawienia silnika w podglądzie, a nie formularz kończący się
+// odmową po kliknięciu „Zapisz”.
+//
+// ROLE DOKŁADNE, NIE `isAdmin`. `useAuth().isAdmin` liczy też `super_admin`,
+// a polityki ścieżek (`is_admin_or_editor()`, `has_role(…, 'admin')`) pytają
+// o wiersz `admin`/`editor` w najemcy - sam `super_admin` dostałby edytor,
+// w którym baza bez błędu zwraca zero wierszy. Ta sama reguła co
+// `RevenueHubLayout` i `hubTabsFor(roles)`.
+//
+// MFA. Middleware `requireCrmStaff`/`requireAdmin` rzuca
+// `Error("Forbidden: mfa_required …")` wyłącznie dla kont z drugim składnikiem
+// i sesją `aal1` (`require-staff.ts`). Rozpoznajemy dosłowny token, jak
+// `platformGateDenial` w panelu płatności - komunikat odmowy ROLI ma inny tekst
+// („Forbidden: … role … required”), a wszystko inne to zwykły błąd odczytu.
+//
+// Moduł bez zależności runtime (liść).
+
+/** Role, które UI ścieżek rozróżnia (pozostałe nie dają żadnej zdolności). */
+export type JourneyRole = "admin" | "editor";
+
+export interface JourneyCapabilities {
+  /** Szkic: graf, ustawienia, treść maili, tworzenie i instalacja szablonu. */
+  canEdit: boolean;
+  /** Publikacja wersji oraz pauza, wznowienie i archiwum. */
+  canPublish: boolean;
+  /** Ustawienia silnika (włączenie, limit, cisza nocna, nadawca, piksel). */
+  canManageEngine: boolean;
+  /** „Pomiń oczekiwanie” zapisu testowego. */
+  canSkipWait: boolean;
+  /** „Testuj na sobie” i wyjście własnego zapisu testowego. */
+  canTest: boolean;
+}
+
+const NONE: JourneyCapabilities = {
+  canEdit: false,
+  canPublish: false,
+  canManageEngine: false,
+  canSkipWait: false,
+  canTest: false,
+};
+
+export function journeyCapabilities(roles: readonly string[]): JourneyCapabilities {
+  const admin = roles.includes("admin");
+  const editor = roles.includes("editor");
+  if (!admin && !editor) return NONE;
+  return {
+    canEdit: true,
+    canPublish: admin,
+    canManageEngine: admin,
+    canSkipWait: admin,
+    canTest: true,
+  };
+}
+
+function messageOf(error: unknown): string {
+  if (error instanceof Error) return error.message;
+  if (typeof error === "string") return error;
+  if (typeof error === "object" && error !== null) {
+    const message = (error as { message?: unknown }).message;
+    if (typeof message === "string") return message;
+  }
+  return "";
+}
+
+/** Odmowa z powodu braku `aal2` (dosłowny token middleware). */
+export function isMfaRequiredError(error: unknown): boolean {
+  return /mfa_required/.test(messageOf(error));
+}
+
+/**
+ * Odmowa ROLI z middleware (`Forbidden: CRM staff role … required`,
+ * `Forbidden: admin role required`). Weryfikacja roli zakończona awarią
+ * („could not verify”) to NIE jest odmowa - ponowienie może przejść.
+ */
+export function isRoleDeniedError(error: unknown): boolean {
+  const message = messageOf(error);
+  if (isMfaRequiredError(error)) return false;
+  return /^Forbidden: (?!could not verify).*role.* required$/.test(message);
+}
+
+/** Jedno rozstrzygnięcie dla ekranu: co pokazać zamiast treści. */
+export type JourneyAccessDenial = "mfa_required" | "role" | null;
+
+export function journeyAccessDenial(error: unknown): JourneyAccessDenial {
+  if (error === null || error === undefined) return null;
+  if (isMfaRequiredError(error)) return "mfa_required";
+  if (isRoleDeniedError(error)) return "role";
+  return null;
+}
diff --git a/src/lib/admin/journeys/hash.ts b/src/lib/admin/journeys/hash.ts
