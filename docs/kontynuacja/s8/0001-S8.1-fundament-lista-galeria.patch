+// Uprawnienia i MFA w UI ścieżek (S8) - lustro bramek serwera.
+//
+// CO TEN PLIK DOWODZI.
+//   1. Zdolności liczone z DOKŁADNYCH ról: admin wszystko, redaktor szkic
+//      i test, sam `super_admin` (bez wiersza admin/editor) - nic, bo polityki
+//      ścieżek go nie wpuszczają.
+//   2. `mfa_required` rozpoznajemy po dosłownym tokenie middleware, odmowę
+//      roli po jej komunikacie, a awaria weryfikacji roli NIE jest odmową.
+import { describe, expect, it } from "vitest";
+
+import {
+  isMfaRequiredError,
+  isRoleDeniedError,
+  journeyAccessDenial,
+  journeyCapabilities,
+} from "../access";
+
+const MFA = new Error(
+  "Forbidden: mfa_required - verify your second factor (aal2) to perform CRM staff role (admin/editor) actions",
+);
+const ROLE = new Error("Forbidden: CRM staff role (admin/editor) required");
+const ADMIN_ROLE = new Error("Forbidden: admin role required");
+const VERIFY = new Error("Forbidden: could not verify CRM staff role (admin/editor) (timeout)");
+
+describe("journeyCapabilities", () => {
+  it("admin ma wszystkie zdolności", () => {
+    expect(journeyCapabilities(["admin"])).toEqual({
+      canEdit: true,
+      canPublish: true,
+      canManageEngine: true,
+      canSkipWait: true,
+      canTest: true,
+    });
+  });
+
+  it("redaktor edytuje i testuje na sobie, ale nie publikuje i nie zmienia silnika", () => {
+    expect(journeyCapabilities(["editor"])).toEqual({
+      canEdit: true,
+      canPublish: false,
+      canManageEngine: false,
+      canSkipWait: false,
+      canTest: true,
+    });
+  });
+
+  it.each([[["author"]], [["super_admin"]], [["user"]], [[]]])(
+    "rola %j nie daje żadnej zdolności (baza zostawiłaby ekran pusty)",
+    (roles) => {
+      expect(Object.values(journeyCapabilities(roles)).every((value) => value === false)).toBe(
+        true,
+      );
+    },
+  );
+
+  it("super_admin z wierszem admin to admin", () => {
+    expect(journeyCapabilities(["super_admin", "admin"]).canPublish).toBe(true);
+  });
+});
+
+describe("rozpoznanie odmów middleware", () => {
+  it("mfa_required: Error, napis i obiekt z message", () => {
+    expect(isMfaRequiredError(MFA)).toBe(true);
+    expect(isMfaRequiredError(MFA.message)).toBe(true);
+    expect(isMfaRequiredError({ message: MFA.message })).toBe(true);
+    expect(isMfaRequiredError(ROLE)).toBe(false);
+    expect(isMfaRequiredError(null)).toBe(false);
+    expect(isMfaRequiredError(42)).toBe(false);
+  });
+
+  it("odmowa roli - tak; awaria weryfikacji i mfa - nie", () => {
+    expect(isRoleDeniedError(ROLE)).toBe(true);
+    expect(isRoleDeniedError(ADMIN_ROLE)).toBe(true);
+    expect(isRoleDeniedError(VERIFY)).toBe(false);
+    expect(isRoleDeniedError(MFA)).toBe(false);
+    expect(isRoleDeniedError(new Error("network down"))).toBe(false);
+  });
+
+  it("journeyAccessDenial: jedno rozstrzygnięcie dla ekranu", () => {
+    expect(journeyAccessDenial(MFA)).toBe("mfa_required");
+    expect(journeyAccessDenial(ROLE)).toBe("role");
+    expect(journeyAccessDenial(VERIFY)).toBeNull();
+    expect(journeyAccessDenial(null)).toBeNull();
+    expect(journeyAccessDenial(undefined)).toBeNull();
+  });
+});
diff --git a/src/lib/admin/journeys/__tests__/hash.test.ts b/src/lib/admin/journeys/__tests__/hash.test.ts
new file mode 100644
index 000000000..fccba7ff0
--- /dev/null
+++ b/src/lib/admin/journeys/__tests__/hash.test.ts
@@ -0,0 +1,91 @@
+// Skróty kluczy cache ścieżek (S8): stabilny JSON i szybki skrót.
+//
+// CO TEN PLIK DOWODZI. Klucz szacunku i symulacji zmienia się WYŁĄCZNIE przy
+// realnej zmianie treści: kolejność pól (jsonb, nowy obiekt po renderze) nie
+// ma znaczenia, a kolejność elementów tablic - ma (warunki, krawędzie).
+import { describe, expect, it } from "vitest";
+
+import { conditionHash, draftChecksum, fastHash, stableStringify } from "../hash";
+import { emptyJourneyGraph } from "@/lib/journeys/graph";
+
+describe("stableStringify", () => {
+  it("sortuje klucze obiektów na każdym poziomie i zachowuje kolejność tablic", () => {
+    expect(stableStringify({ b: 1, a: { d: [3, 1], c: "x" } })).toBe(
+      '{"a":{"c":"x","d":[3,1]},"b":1}',
+    );
+    expect(stableStringify({ a: { c: "x", d: [3, 1] }, b: 1 })).toBe(
+      stableStringify({ b: 1, a: { d: [3, 1], c: "x" } }),
+    );
+    expect(stableStringify([1, 2])).not.toBe(stableStringify([2, 1]));
+  });
+
+  it("zasady JSON.stringify: undefined znika w obiekcie, w tablicy to null; NaN to null", () => {
+    expect(stableStringify({ a: undefined, b: null })).toBe('{"b":null}');
+    expect(stableStringify([undefined, () => 1])).toBe("[null,null]");
+    expect(stableStringify({ n: Number.NaN, i: Infinity })).toBe('{"i":null,"n":null}');
+    expect(stableStringify(new Date("2026-10-20T00:00:00.000Z"))).toBe(
+      '"2026-10-20T00:00:00.000Z"',
+    );
+    expect(stableStringify('ż"')).toBe(JSON.stringify('ż"'));
+    expect(stableStringify(undefined)).toBe("null");
+  });
+
+  it("dla obiektu bez wielu kluczy daje to samo co JSON.stringify", () => {
+    const value = { a: [1, { b: true, c: null }], d: "e" };
+    expect(stableStringify(value)).toBe(JSON.stringify(value));
+  });
+
+  it("cykl w danych to błąd, a nie zawieszenie", () => {
+    const cyclic: Record<string, unknown> = {};
+    cyclic.self = cyclic;
+    expect(() => stableStringify(cyclic)).toThrow(/cykl/);
+    // Ten sam obiekt dwa razy (bez cyklu) jest poprawny.
+    const shared = { x: 1 };
+    expect(stableStringify({ a: shared, b: shared })).toBe('{"a":{"x":1},"b":{"x":1}}');
+  });
+});
+
+describe("fastHash", () => {
+  it("jest deterministyczny, ma stałą długość 14 znaków szesnastkowych", () => {
+    expect(fastHash("abc")).toBe(fastHash("abc"));
+    for (const input of ["", "a", "ścieżka", "x".repeat(10_000)]) {
+      expect(fastHash(input)).toMatch(/^[0-9a-f]{14}$/);
+    }
+  });
+
+  it("rozróżnia bliskie napisy i reaguje na ziarno", () => {
+    const hashes = new Set(Array.from({ length: 500 }, (_, i) => fastHash(`klucz-${i}`)));
+    expect(hashes.size).toBe(500);
+    expect(fastHash("abc", 1)).not.toBe(fastHash("abc", 0));
+  });
+});
+
+describe("conditionHash i draftChecksum", () => {
+  it("brak warunku i warunek pusty to ten sam szacunek", () => {
+    expect(conditionHash({})).toBe(conditionHash(undefined));
+    expect(conditionHash(null)).toBe(conditionHash({}));
+  });
+
+  it("kolejność pól warunku nie zmienia skrótu, wartość - zmienia", () => {
+    expect(conditionHash({ kind: "subscription", has_coupon: true })).toBe(
+      conditionHash({ has_coupon: true, kind: "subscription" }),
+    );
+    expect(conditionHash({ kind: "subscription" })).not.toBe(conditionHash({ kind: "one_time" }));
+  });
+
+  it("suma szkicu zmienia się z treścią, nie z kolejnością pól", () => {
+    const draft = {
+      graph: emptyJourneyGraph(),
+      settings: { triggerEventType: "account.registered.v1" },
+    };
+    const reordered = {
+      settings: { triggerEventType: "account.registered.v1" },
+      graph: emptyJourneyGraph(),
+    };
+    expect(draftChecksum(draft)).toBe(draftChecksum(reordered));
+    expect(draftChecksum({ ...draft, settings: { triggerEventType: "paywall.hit.v1" } })).not.toBe(
+      draftChecksum(draft),
+    );
+    expect(draftChecksum(null)).toBe(draftChecksum(undefined));
+  });
+});
diff --git a/src/lib/admin/journeys/__tests__/issues.test.ts b/src/lib/admin/journeys/__tests__/issues.test.ts
