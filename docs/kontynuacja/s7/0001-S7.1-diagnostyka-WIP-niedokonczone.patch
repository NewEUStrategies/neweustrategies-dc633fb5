+    expect(facts.areas.workflows).toEqual({ cancelRecipe: null });
+    expect(facts.areas.paywall).toEqual({ lastHitAt: null, firstGatedAt: null });
+  });
+
+  it("listy tekstów odrzucają elementy nietekstowe", () => {
+    const facts = parseRevenueFacts({
+      v: 1,
+      areas: { sync: { silentDaily: ["a", 1, null, "b"], silentWeekly: [] } },
+    });
+    expect(facts.areas.sync).toEqual({ silentDaily: ["a", "b"], silentWeekly: [] });
+  });
+
+  it("prezentacja kasy przyjmuje wyłącznie pl/en", () => {
+    const facts = parseRevenueFacts({
+      v: 1,
+      areas: {
+        checkout: {
+          presentation: [
+            { lang: "pl", displayCurrency: "PLN", chargeCurrencies: ["PLN"] },
+            { lang: "de", displayCurrency: "EUR", chargeCurrencies: ["EUR"] },
+          ],
+        },
+      },
+    });
+    expect(facts.areas.checkout?.presentation).toEqual([
+      { lang: "pl", displayCurrency: "PLN", chargeCurrencies: ["PLN"] },
+    ]);
+  });
+});
+
+describe("cegiełki oceny", () => {
+  it("OK i UNKNOWN to stany bez dowodów", () => {
+    expect(OK).toEqual({ state: "ok" });
+    expect(UNKNOWN).toEqual({ state: "unknown" });
+  });
+
+  it("finding przyjmuje jeden dowód albo listę i pomija puste pola", () => {
+    expect(finding("warn", { evidence: ev("doiOff") })).toEqual({
+      state: "warn",
+      evidence: [{ key: "doiOff", params: {} }],
+    });
+    expect(
+      finding("error", { count: 2, refs: ["a"], evidence: [ev("x", { count: 2 }), ev("y")] }),
+    ).toEqual({
+      state: "error",
+      count: 2,
+      refs: ["a"],
+      evidence: [
+        { key: "x", params: { count: 2 } },
+        { key: "y", params: {} },
+      ],
+    });
+  });
+
+  it.each([
+    ["critical", "error", "high"],
+    ["warning", "error", "high"],
+    ["info", "error", "medium"],
+    ["critical", "warn", "medium"],
+    ["warning", "warn", "low"],
+    ["info", "warn", "low"],
+    ["critical", "unknown", "low"],
+    ["critical", "ok", "low"],
+  ] as const)("defaultImpact(%s, %s) = %s", (severity, state, impact) => {
+    expect(defaultImpact(severity, state)).toBe(impact);
+  });
+
+  it("factHashOf jest deterministyczny i ma prefiks wersji", () => {
+    expect(factHashOf({ state: "error", count: 1, refs: ["x"] })).toBe(
+      factHashOf({ state: "error", count: 1, refs: ["x"] }),
+    );
+    expect(factHashOf({ state: "error", count: 1 })).toMatch(/^f1:[0-9a-f]{8}$/);
+  });
+
+  it("sumKnown pomija brakujące pola, a bez żadnego daje undefined", () => {
+    expect(sumKnown(1, undefined, 2)).toBe(3);
+    expect(sumKnown(undefined, undefined)).toBeUndefined();
+  });
+});
diff --git a/src/lib/revenue/diagnostics/__tests__/registry.test.ts b/src/lib/revenue/diagnostics/__tests__/registry.test.ts
new file mode 100644
index 000000000..9fa17b173
--- /dev/null
+++ b/src/lib/revenue/diagnostics/__tests__/registry.test.ts
@@ -0,0 +1,253 @@
+// Rejestr reguł diagnostyki (S7, SPEC §5.7): zamknięta lista 54 + 1 reguł,
+// zgodność plików `checks/*` z listą, odnośniki napraw i modułów na trasy,
+// które ISTNIEJĄ (z parametrami z kontraktu deep linków §2.6), lista
+// niewyciszalnych, wyciszenia i kolejność listy.
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+
+import { REVENUE_AREAS, REVENUE_SEVERITIES } from "@/lib/admin/revenue/hubTabs";
+import { parseBillingSearch } from "@/lib/admin/billingTabs";
+import { parsePaywallSearch } from "@/lib/admin/paywallTabs";
+import { parsePricingSearch } from "@/lib/admin/pricingTabs";
+import { isRevenueTab, parseRevenueHubSearch } from "@/lib/revenue/search";
+import { EMPTY_REVENUE_FACTS, factHashOf, type RevenueFacts } from "../facts";
+import {
+  CHECK_KNOWLEDGE,
+  REVENUE_CHECK_IDS,
+  REVENUE_CHECKS,
+  REVENUE_FIX_DIALOG_IDS,
+  SPEC_CHECK_COUNT,
+  UNSNOOZABLE_CHECK_IDS,
+  compareFindings,
+  evaluateRegistry,
+  isOpenFinding,
+  isRevenueCheckId,
+  isRevenueFixDialogId,
+  revenueCheck,
+  snoozeApplies,
+  type RevenueFinding,
+  type RevenueSnooze,
+} from "../registry";
+
+const ROUTE_PATHS: ReadonlySet<string> = new Set(
+  [...readFileSync("src/routeTree.gen.ts", "utf8").matchAll(/fullPath: '([^']+)'/g)].map((m) =>
+    m[1] === "/" ? "/" : m[1].replace(/\/$/, ""),
+  ),
+);
+
+/** Adres konkretny → trasa drzewa (dosłownie albo `$tab` huba z poprawną zakładką). */
+function resolvesToRoute(path: string): boolean {
+  if (ROUTE_PATHS.has(path)) return true;
+  const match = /^\/admin\/revenue\/([a-z_]+)$/.exec(path);
+  return match !== null && isRevenueTab(match[1]) && match[1] !== "overview";
+}
+
+/** Walidatory adresów modułów - parametr musi przejść BEZ utraty wartości. */
+const MODULE_SEARCH: Readonly<Record<string, (raw: Record<string, unknown>) => object>> = {
+  "/admin/paywall": parsePaywallSearch,
+  "/admin/pricing": parsePricingSearch,
+  "/admin/billing": parseBillingSearch,
+  // Walidatory w plikach tras (chunk wejściowy) - wartości przepisane z nich.
+  "/admin/workflows": (raw) => (raw.tab === "definitions" ? { tab: "definitions" } : {}),
+  "/admin/community/clubs/applications": (raw) =>
+    ["pending", "review", "accepted", "rejected", "needs_info"].includes(String(raw.status))
+      ? { status: raw.status }
+      : {},
+};
+
+/** Parametry po walidatorze trasy (`null` = trasa bez znanego walidatora). */
+function parsedSearch(to: string, search: Readonly<Record<string, string>>): object | null {
+  if (to.startsWith("/admin/revenue")) return parseRevenueHubSearch({ ...search });
+  const parse = MODULE_SEARCH[to];
+  return parse ? parse({ ...search }) : null;
+}
+
+describe("zamknięta lista reguł", () => {
+  it("54 reguły SPEC + opcjonalna catalog.team_seats_over_cap, bez duplikatów", () => {
+    expect(SPEC_CHECK_COUNT).toBe(54);
+    expect(REVENUE_CHECK_IDS).toHaveLength(SPEC_CHECK_COUNT + 1);
+    expect(new Set(REVENUE_CHECK_IDS).size).toBe(REVENUE_CHECK_IDS.length);
+    expect(REVENUE_CHECK_IDS).toContain("catalog.team_seats_over_cap");
+  });
+
+  it("pliki checks/* = lista identyfikatorów (w obie strony)", () => {
+    expect(REVENUE_CHECKS.map((c) => c.id).sort()).toEqual([...REVENUE_CHECK_IDS].sort());
+  });
+
+  it("obszar reguły = prefiks identyfikatora, waga z unii", () => {
+    for (const check of REVENUE_CHECKS) {
+      expect(check.id.startsWith(`${check.area}.`), check.id).toBe(true);
+      expect(REVENUE_AREAS).toContain(check.area);
+      expect(REVENUE_SEVERITIES).toContain(check.severity);
+      expect(revenueCheck(check.id)).toBe(check);
+    }
+  });
+
+  it("każdy z 16 obszarów ma co najmniej jedną regułę", () => {
+    for (const area of REVENUE_AREAS) {
+      expect(REVENUE_CHECKS.some((c) => c.area === area), area).toBe(true);
+    }
+  });
+
+  it("strażnicy typów", () => {
+    expect(isRevenueCheckId("crm.qualified_without_owner")).toBe(true);
+    expect(isRevenueCheckId("crm.unknown")).toBe(false);
+    expect(isRevenueCheckId(42)).toBe(false);
+    expect(isRevenueFixDialogId("plan_tier")).toBe(true);
+    expect(isRevenueFixDialogId("catalog.plan_without_tier")).toBe(false);
+  });
+});
+
+describe("naprawy i odnośniki modułów", () => {
+  it.each(REVENUE_CHECKS.map((c) => [c.id, c] as const))("%s: odnośniki prowadzą na istniejące trasy", (_id, check) => {
+    expect(resolvesToRoute(check.owner.to), `owner ${check.owner.to}`).toBe(true);
+    if (check.owner.search) {
+      expect(parsedSearch(check.owner.to, check.owner.search), check.owner.to).toEqual(check.owner.search);
+    }
+    if (check.fix?.kind === "link") {
+      expect(resolvesToRoute(check.fix.to), `fix ${check.fix.to}`).toBe(true);
+      if (check.fix.search) {
+        expect(parsedSearch(check.fix.to, check.fix.search), check.fix.to).toEqual(check.fix.search);
+      }
+    }
+    if (check.fix?.kind === "code") expect(check.fix.issueRef).toBe(check.id);
+  });
+
+  it("każdy dialog naprawy ma co najmniej jedną regułę, a reguła wskazuje dialog z listy", () => {
+    const used = new Set<string>();
+    for (const check of REVENUE_CHECKS) {
+      if (check.fix?.kind === "dialog") {
+        expect(isRevenueFixDialogId(check.fix.dialog), check.id).toBe(true);
+        used.add(check.fix.dialog);
+      }
+    }
+    expect([...used].sort()).toEqual([...REVENUE_FIX_DIALOG_IDS].sort());
+  });
+
+  it("wiedza Insidera dotyczy wyłącznie istniejących reguł i niesie same identyfikatory", () => {
+    for (const [id, knowledge] of Object.entries(CHECK_KNOWLEDGE)) {
+      expect(isRevenueCheckId(id), id).toBe(true);
+      for (const ref of [...(knowledge?.scenarios ?? []), ...(knowledge?.frameworks ?? [])]) {
+        expect(ref).toMatch(/^[a-z0-9_-]+$/);
+      }
+    }
+  });
+});
+
+describe("niewyciszalne", () => {
+  it("krytyczne reguły sync i data_quality - dokładnie emit_errors i ledger_drift", () => {
+    expect([...UNSNOOZABLE_CHECK_IDS].sort()).toEqual(["data_quality.ledger_drift", "sync.emit_errors"]);
+    for (const check of REVENUE_CHECKS) {
+      expect(check.snoozable, check.id).toBe(!UNSNOOZABLE_CHECK_IDS.includes(check.id));
+    }
+  });
+});
+
+const NOW_MS = Date.parse("2026-10-20T12:00:00.000Z");
+
+function snooze(overrides: Partial<RevenueSnooze> = {}): RevenueSnooze {
+  return {
+    id: "s1",
+    checkId: "crm.auto_tasks_without_assignee",
+    scopeKey: "*",
+    kind: "days",
+    until: new Date(NOW_MS + 86_400_000).toISOString(),
+    reason: null,
+    scopeHash: null,
+    createdAt: null,
+    ...overrides,
+  };
+}
+
+const CRM_OPEN: RevenueFacts = {
+  v: 1,
+  computedAt: "2026-10-20T12:00:00.000Z",
+  areas: { crm: { autoTasksUnassigned: { open: 3, overdue: 1 } } },
+};
+
+function crmFinding(facts: RevenueFacts, snoozes: RevenueSnooze[] = []): RevenueFinding {
+  return evaluateRegistry(facts, snoozes, NOW_MS).find((f) => f.checkId === "crm.auto_tasks_without_assignee")!;
+}
+
+describe("evaluateRegistry i wyciszenia", () => {
+  it("pusty zestaw faktów: każda reguła `unknown`, żadna otwarta", () => {
+    const findings = evaluateRegistry(EMPTY_REVENUE_FACTS, [], NOW_MS);
+    expect(findings).toHaveLength(REVENUE_CHECK_IDS.length);
+    expect(findings.every((f) => f.state === "unknown")).toBe(true);
+    expect(findings.filter(isOpenFinding)).toEqual([]);
+  });
+
+  it("diagnoza niesie odcisk faktów, wpływ i właściciela", () => {
+    const finding = crmFinding(CRM_OPEN);
+    expect(finding).toMatchObject({ state: "error", count: 3, impact: "high", snooze: null });
+    expect(finding.factHash).toBe(factHashOf({ state: "error", count: 3, refs: [] }));
+    expect(finding.owner.to).toBe("/admin/crm");
+    expect(isOpenFinding(finding)).toBe(true);
+  });
+
+  it("wyciszenie na czas obowiązuje do terminu", () => {
+    expect(crmFinding(CRM_OPEN, [snooze()]).snooze?.id).toBe("s1");
+    const expired = snooze({ until: new Date(NOW_MS - 1).toISOString() });
+    expect(crmFinding(CRM_OPEN, [expired]).snooze).toBeNull();
+  });
+
+  it("wyciszenie „świadomie” obowiązuje tylko przy tym samym odcisku faktów", () => {
+    const hash = factHashOf({ state: "error", count: 3, refs: [] });
+    const intentional = snooze({ kind: "intentional", until: null, scopeHash: hash, reason: "B2B" });
+    expect(crmFinding(CRM_OPEN, [intentional]).snooze?.id).toBe("s1");
+    const changed: RevenueFacts = {
+      ...CRM_OPEN,
+      areas: { crm: { autoTasksUnassigned: { open: 4, overdue: 1 } } },
+    };
+    const finding = crmFinding(changed, [intentional]);
+    expect(finding.snooze).toBeNull();
+    expect(isOpenFinding(finding)).toBe(true);
+  });
+
+  it("wyciszenie innego zakresu albo innej reguły nie działa", () => {
+    expect(crmFinding(CRM_OPEN, [snooze({ scopeKey: "lead:1" })]).snooze).toBeNull();
+    expect(crmFinding(CRM_OPEN, [snooze({ checkId: "crm.qualified_without_owner" })]).snooze).toBeNull();
+  });
+
+  it("reguła niewyciszalna ignoruje każde wyciszenie", () => {
+    expect(snoozeApplies(snooze(), { factHash: "f1:0", snoozable: false }, NOW_MS)).toBe(false);
+    const facts: RevenueFacts = { ...CRM_OPEN, areas: { sync: { emitErrors24h: 2, emitErrors7d: 2 } } };
+    const finding = evaluateRegistry(facts, [snooze({ checkId: "sync.emit_errors" })], NOW_MS).find(
+      (f) => f.checkId === "sync.emit_errors",
+    );
+    expect(finding?.snooze).toBeNull();
+    expect(finding?.state).toBe("error");
+  });
+
+  it("factHash nie zależy od kolejności refs, zależy od stanu i liczby", () => {
+    expect(factHashOf({ state: "warn", count: 2, refs: ["b", "a"] })).toBe(
+      factHashOf({ state: "warn", count: 2, refs: ["a", "b"] }),
+    );
+    expect(factHashOf({ state: "warn", count: 2 })).not.toBe(factHashOf({ state: "error", count: 2 }));
+    expect(factHashOf({ state: "warn", count: 2 })).toMatch(/^f1:[0-9a-f]{8}$/);
+  });
+});
+
+describe("compareFindings - kolejność listy", () => {
+  it("waga, potem skutek trwający przed uśpionym, potem liczba", () => {
+    const facts: RevenueFacts = {
+      v: 1,
+      computedAt: "2026-10-20T12:00:00.000Z",
+      areas: {
+        crm: {
+          autoTasksUnassigned: { open: 2, overdue: 0 },
+          qualifiedWithoutOwner: { mqlSql: 0, opportunity: 1, refs: [] },
+        },
+        sync: { emitErrors24h: 0, emitErrors7d: 1 },
+        newsletter: { defaultSender: true, campaignsSent30d: 4 },
+      },
+    };
+    const open = evaluateRegistry(facts, [], NOW_MS).filter(isOpenFinding).sort(compareFindings);
+    expect(open.map((f) => f.checkId)).toEqual([
+      "newsletter.default_sender",
+      "sync.emit_errors",
+      "crm.auto_tasks_without_assignee",
+      "crm.qualified_without_owner",
+    ]);
+  });
+});
diff --git a/src/lib/revenue/diagnostics/checks/catalog.ts b/src/lib/revenue/diagnostics/checks/catalog.ts
new file mode 100644
index 000000000..cfae16e84
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/catalog.ts
@@ -0,0 +1,293 @@
+// Reguły obszaru „Katalog planów" (SPEC §5.7) - plan ↔ warstwa ↔ para
+// katalogowa ↔ cena u operatora ↔ cennik.
+//
+// STAN `error` = skutek TRWA (ktoś może dziś kupić coś, czego nie dostanie,
+// albo płaci inną kwotę niż w cenniku); `warn` = ten sam błąd uśpiony
+// (plan wycofany, warstwa schowana) - wróci przy pierwszym włączeniu.
+import { isEnquiryOnlyPlan } from "@/lib/billing/enquiryPlans";
+import { TEAM_TIER_MAX_SEATS } from "@/lib/organizations/teamSeats";
+import { areaFacts, ev, finding, OK, UNKNOWN, type CatalogPlanFact } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/** Rok to 12 okresów miesięcznych - granica „rabatu" rocznego, nie benchmark. */
+const MONTHS_PER_YEAR = 12;
+
+const PAYWALL_PLANS = { to: "/admin/paywall", search: { tab: "plans" } } as const;
+
+function selling(plan: CatalogPlanFact): boolean {
+  return plan.active && plan.forSale;
+}
+
+/** Plany sprzedawane pierwsze - `refs` prowadzą najpierw do tych, które bolą. */
+function refsOf(plans: readonly CatalogPlanFact[]): string[] {
+  return [...plans].sort((a, b) => Number(selling(b)) - Number(selling(a))).map((p) => p.id);
+}
+
+/** Pary miesiąc/rok tej samej warstwy i waluty, z kwotami (admin). */
+function annualPairs(plans: readonly CatalogPlanFact[]) {
+  const pairs: { tierKey: string; monthly: number | null; yearly: number | null }[] = [];
+  const active = plans.filter((p) => p.active && p.tierKey !== null);
+  for (const yearly of active.filter((p) => p.interval === "year")) {
+    const monthly = active.find(
+      (p) => p.interval === "month" && p.tierKey === yearly.tierKey && p.currency === yearly.currency,
+    );
+    if (monthly) {
+      pairs.push({
+        tierKey: yearly.tierKey as string,
+        monthly: monthly.priceCents,
+        yearly: yearly.priceCents,
+      });
+    }
+  }
+  return pairs;
+}
+
+export const CATALOG_CHECKS = [
+  {
+    id: "catalog.plan_without_tier",
+    area: "catalog",
+    severity: "critical",
+    evaluate(facts) {
+      const plans = areaFacts(facts, "catalog")?.plans;
+      if (!plans) return UNKNOWN;
+      const broken = plans.filter((p) => !p.tierFound);
+      if (broken.length === 0) return OK;
+      const sold = broken.filter(selling).length;
+      return finding(sold > 0 ? "error" : "warn", {
+        count: broken.length,
+        refs: refsOf(broken),
+        evidence: ev("planWithoutTier", { count: broken.length, selling: sold }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "plan_tier" },
+    owner: { to: "/admin/membership" },
+    snoozable: true,
+  },
+  {
+    id: "catalog.plan_without_catalog_pair",
+    area: "catalog",
+    severity: "critical",
+    evaluate(facts) {
+      const plans = areaFacts(facts, "catalog")?.plans;
+      if (!plans) return UNKNOWN;
+      const broken = plans.filter((p) => !p.catalogPair);
+      if (broken.length === 0) return OK;
+      const sold = broken.filter(selling).length;
+      return finding(sold > 0 ? "error" : "warn", {
+        count: broken.length,
+        refs: refsOf(broken),
+        evidence: ev("planWithoutCatalogPair", { count: broken.length, selling: sold }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "plan_deactivate" },
+    owner: PAYWALL_PLANS,
+    snoozable: true,
+  },
+  {
+    id: "catalog.enquiry_plan_buyable",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const plans = areaFacts(facts, "catalog")?.plans;
+      if (!plans) return UNKNOWN;
+      const buyable = plans.filter((p) => p.forSale && isEnquiryOnlyPlan({ tier_key: p.tierKey }));
+      if (buyable.length === 0) return OK;
+      const live = buyable.filter((p) => p.active).length;
+      return finding(live > 0 ? "error" : "warn", {
+        count: buyable.length,
+        refs: refsOf(buyable),
+        evidence: ev("enquiryPlanBuyable", { count: buyable.length, active: live }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "plan_not_for_sale" },
+    owner: PAYWALL_PLANS,
+    snoozable: true,
+  },
+  {
+    id: "catalog.promise_without_gate",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const gaps = areaFacts(facts, "catalog")?.promiseGaps;
+      if (!gaps) return UNKNOWN;
+      if (gaps.broken.length === 0 && gaps.decorative.length === 0) return OK;
+      const brokenSold = gaps.broken.filter((g) => g.offerable);
+      const all = [...gaps.broken, ...gaps.decorative];
+      return finding(brokenSold.length > 0 ? "error" : "warn", {
+        count: all.length,
+        refs: [...new Set(all.map((g) => g.tierKey))],
+        evidence: [
+          ...(gaps.broken.length > 0
+            ? [ev("promiseBroken", { count: gaps.broken.length, selling: brokenSold.length })]
+            : []),
+          ...(gaps.decorative.length > 0
+            ? [ev("promiseDecorative", { count: gaps.decorative.length })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/offer" },
+    owner: { to: "/admin/pricing", search: { tab: "tiers" } },
+    snoozable: true,
+  },
+  {
+    id: "catalog.provider_price_drift",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const drift = areaFacts(facts, "catalog")?.providerPriceDrift;
+      if (drift?.forSale === undefined || drift.notForSale === undefined) return UNKNOWN;
+      const total = drift.forSale + drift.notForSale;
+      if (total === 0) return OK;
+      return finding(drift.forSale > 0 ? "error" : "warn", {
+        count: total,
+        refs: drift.refs,
+        evidence: ev("providerPriceDrift", { forSale: drift.forSale, notForSale: drift.notForSale }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/billing", search: { tab: "subscriptions" } },
+    owner: PAYWALL_PLANS,
+    snoozable: true,
+  },
+  {
+    id: "catalog.annual_discount_out_of_range",
+    area: "catalog",
+    severity: "info",
+    evaluate(facts) {
+      const plans = areaFacts(facts, "catalog")?.plans;
+      if (!plans) return UNKNOWN;
+      const pairs = annualPairs(plans);
+      if (pairs.length === 0) return OK;
+      // Kwoty widzi tylko administrator - redaktor dostaje `null` (SPEC §2.5).
+      if (pairs.some((p) => p.monthly === null || p.yearly === null)) return UNKNOWN;
+      const priced = pairs as { tierKey: string; monthly: number; yearly: number }[];
+      // Rok droższy niż 12 miesięcy albo tańszy niż jeden miesiąc to błąd
+      // wpisu, nie polityka cenowa; rok równy 12 miesiącom - plan roczny bez
+      // żadnej zachęty. Granice logiczne, bez wymyślonego „dobrego" rabatu.
+      const above = priced.filter((p) => p.yearly > p.monthly * MONTHS_PER_YEAR);
+      const below = priced.filter((p) => p.yearly <= p.monthly);
+      const flat = priced.filter((p) => p.yearly === p.monthly * MONTHS_PER_YEAR);
+      if (above.length + below.length > 0) {
+        const bad = [...above, ...below];
+        return finding("error", {
+          count: bad.length,
+          refs: bad.map((p) => p.tierKey),
+          evidence: [
+            ...(above.length > 0 ? [ev("annualAboveMonthly", { count: above.length })] : []),
+            ...(below.length > 0 ? [ev("annualBelowMonthly", { count: below.length })] : []),
+          ],
+        });
+      }
+      if (flat.length > 0) {
+        return finding("warn", {
+          count: flat.length,
+          refs: flat.map((p) => p.tierKey),
+          evidence: ev("annualNoDiscount", { count: flat.length }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "link", to: "/admin/paywall", search: { tab: "plans" } },
+    owner: PAYWALL_PLANS,
+    snoozable: true,
+  },
+  {
+    id: "catalog.subscription_unknown_price",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const subs = areaFacts(facts, "catalog")?.unknownPriceSubscriptions;
+      if (subs?.unknownPrice === undefined || subs.missingAmount === undefined) return UNKNOWN;
+      if (subs.unknownPrice + subs.missingAmount === 0) return OK;
+      return finding(subs.unknownPrice > 0 ? "error" : "warn", {
+        count: subs.unknownPrice + subs.missingAmount,
+        evidence: [
+          ...(subs.unknownPrice > 0 ? [ev("unknownPrice", { count: subs.unknownPrice })] : []),
+          ...(subs.missingAmount > 0 ? [ev("missingAmount", { count: subs.missingAmount })] : []),
+        ],
+      });
+    },
+    fix: { kind: "code", issueRef: "catalog.subscription_unknown_price" },
+    owner: { to: "/admin/billing", search: { tab: "subscriptions" } },
+    snoozable: true,
+  },
+  {
+    id: "catalog.not_for_sale_still_visible",
+    area: "catalog",
+    severity: "info",
+    evaluate(facts) {
+      const tiers = areaFacts(facts, "catalog")?.tiers;
+      if (!tiers) return UNKNOWN;
+      const shown = tiers.filter((t) => t.active && t.pricingVisible && !t.isDefault && t.plansForSale === 0);
+      // Przycisk zakupu prowadzący donikąd (`cta_mode = auto` bez planu) -
+      // skutek trwa; warstwa „na zapytanie" z wycofanym planem - porządki.
+      const deadButton = shown.filter((t) => t.ctaMode === "auto");
+      const withdrawn = shown.filter((t) => t.ctaMode !== "auto" && t.plansNotForSale > 0);
+      if (deadButton.length > 0) {
+        return finding("error", {
+          count: deadButton.length,
+          refs: deadButton.map((t) => t.key),
+          evidence: ev("tierBuyButtonWithoutPlan", { count: deadButton.length }),
+        });
+      }
+      if (withdrawn.length > 0) {
+        return finding("warn", {
+          count: withdrawn.length,
+          refs: withdrawn.map((t) => t.key),
+          evidence: ev("tierShownPlanWithdrawn", { count: withdrawn.length }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "dialog", dialog: "tier_hide" },
+    owner: { to: "/admin/pricing", search: { tab: "tiers" } },
+    snoozable: true,
+  },
+  {
+    id: "catalog.price_change_without_notice",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const migr = areaFacts(facts, "catalog")?.priceMigrations90d;
+      if (migr?.failed === undefined || migr.pendingOver24h === undefined) return UNKNOWN;
+      if (migr.failed + migr.pendingOver24h === 0) return OK;
+      return finding(migr.failed > 0 ? "error" : "warn", {
+        count: migr.failed + migr.pendingOver24h,
+        evidence: [
+          ...(migr.failed > 0 ? [ev("priceNoticeFailed", { count: migr.failed })] : []),
+          ...(migr.pendingOver24h > 0
+            ? [ev("priceNoticePending", { count: migr.pendingOver24h })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "link", to: "/admin/newsletter/campaigns" },
+    owner: { to: "/admin/billing", search: { tab: "subscriptions" } },
+    snoozable: true,
+  },
+  {
+    id: "catalog.team_seats_over_cap",
+    area: "catalog",
+    severity: "warning",
+    evaluate(facts) {
+      const seats = areaFacts(facts, "catalog")?.teamSeats;
+      if (seats?.over === undefined || seats.atCap === undefined) return UNKNOWN;
+      if (seats.over + seats.atCap === 0) return OK;
+      return finding(seats.over > 0 ? "error" : "warn", {
+        count: seats.over + seats.atCap,
+        refs: seats.refs,
+        evidence: [
+          ...(seats.over > 0
+            ? [ev("teamSeatsOver", { count: seats.over, max: TEAM_TIER_MAX_SEATS })]
+            : []),
+          ...(seats.atCap > 0
+            ? [ev("teamSeatsAtCap", { count: seats.atCap, max: TEAM_TIER_MAX_SEATS })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "link", to: "/admin/organizations" },
+    owner: { to: "/admin/organizations" },
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/checkout.ts b/src/lib/revenue/diagnostics/checks/checkout.ts
new file mode 100644
index 000000000..936175b94
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/checkout.ts
@@ -0,0 +1,65 @@
+// Reguły obszaru „Kasa" (SPEC §5.7; P09, Z-S3-03, DZ §18.4).
+import { REVENUE_LIMITS } from "@/lib/revenue/limits";
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+export const CHECKOUT_CHECKS = [
+  {
+    // Domyślne okno porzucenia (24 h) opóźnia zdarzenie „porzucona kasa" -
+    // ścieżka porzuconej kasy rusza dobę po wyjściu klienta. Bez aktywnej
+    // ścieżki to tylko wolniejsza statystyka; z nią - spóźniony kontakt.
+    id: "checkout.abandon_window_default",
+    area: "checkout",
+    severity: "info",
+    evaluate(facts) {
+      const checkout = areaFacts(facts, "checkout");
+      if (checkout?.settingsRow === undefined || checkout.abandonedJourneyActive === undefined) {
+        return UNKNOWN;
+      }
+      const minutes = checkout.settingsRow
+        ? checkout.abandonAfterMinutes
+        : REVENUE_LIMITS.checkoutAbandonMinutesDefault;
+      if (minutes === undefined || minutes === null) return UNKNOWN;
+      if (minutes !== REVENUE_LIMITS.checkoutAbandonMinutesDefault) return OK;
+      return finding(checkout.abandonedJourneyActive ? "error" : "warn", {
+        evidence: ev(
+          checkout.abandonedJourneyActive ? "abandonDefaultWithJourney" : "abandonDefault",
+          { minutes },
+        ),
+      });
+    },
+    fix: { kind: "dialog", dialog: "checkout_abandon_window" },
+    owner: { to: "/admin/paywall", search: { tab: "checkout" } },
+    snoozable: true,
+  },
+  {
+    // P09: cennik EN pokazuje EUR, a plan obciąża w PLN. S3 dopisał napis
+    // „Charged in PLN" pod ofertą EN (`paywall.offer.chargedIn`) - rozjazd
+    // jest więc jawny (warn). Ten sam rozjazd w PL nie ma napisu (error).
+    id: "checkout.display_currency_mismatch",
+    area: "checkout",
+    severity: "warning",
+    evaluate(facts) {
+      const presentation = areaFacts(facts, "checkout")?.presentation;
+      if (!presentation) return UNKNOWN;
+      const mismatched = presentation.filter((p) =>
+        p.chargeCurrencies.some((c) => c !== p.displayCurrency),
+      );
+      if (mismatched.length === 0) return OK;
+      const pl = mismatched.find((p) => p.lang === "pl");
+      const shown = pl ?? mismatched[0];
+      return finding(pl ? "error" : "warn", {
+        count: mismatched.length,
+        refs: mismatched.map((p) => p.lang),
+        evidence: ev(pl ? "currencyMismatchNoNotice" : "currencyMismatchNotice", {
+          lang: shown.lang.toUpperCase(),
+          display: shown.displayCurrency,
+          charged: shown.chargeCurrencies.filter((c) => c !== shown.displayCurrency).join(", "),
+        }),
+      });
+    },
+    fix: { kind: "code", issueRef: "checkout.display_currency_mismatch" },
+    owner: { to: "/admin/pricing" },
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/clubs.ts b/src/lib/revenue/diagnostics/checks/clubs.ts
