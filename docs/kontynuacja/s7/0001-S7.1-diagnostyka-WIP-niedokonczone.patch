+-- ── 2. Odczyty ───────────────────────────────────────────────────────────────
+SELECT pg_temp.as_user('e7150000-0000-0000-0000-00000000a003');
+SET LOCAL ROLE authenticated;
+SELECT throws_ok($$ SELECT public.admin_revenue_facts() $$, '42501', 'forbidden',
