+    tierKey: text(raw, "tierKey") ?? null,
+    tierFound,
+    tierRank: num(raw, "tierRank") ?? null,
+    active,
+    forSale,
+    interval,
+    currency: (text(raw, "currency") ?? "").toUpperCase(),
+    priceCents: num(raw, "priceCents") ?? null,
+    catalogPair,
+  };
