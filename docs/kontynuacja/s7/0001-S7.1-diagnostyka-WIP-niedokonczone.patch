+  const value = source[key];
+  if (!Array.isArray(value)) return undefined;
+  const out: T[] = [];
+  for (const raw of value) {
+    if (!isBag(raw)) continue;
+    const parsed = item(raw);
+    if (parsed !== null) out.push(parsed);
+  }
+  return out;
