+// Reguły obszaru „Wydarzenia" (SPEC §5.7).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/** Więcej niż połowa odebranych biletów z planu niewykorzystana = benefit nie działa. */
+export const TICKET_UNUSED_MAJORITY = 0.5;
+
+const OWNER = { to: "/admin/events" } as const;
+
+export const EVENTS_CHECKS = [
+  {
+    id: "events.ticket_benefit_unused",
+    area: "events",
+    severity: "info",
+    evaluate(facts) {
+      const claims = areaFacts(facts, "events")?.ticketClaims;
+      if (claims?.claimedPast === undefined || claims.unredeemed === undefined) return UNKNOWN;
+      if (claims.claimedPast === 0 || claims.unredeemed === 0) return OK;
+      const share = claims.unredeemed / claims.claimedPast;
+      return finding(share > TICKET_UNUSED_MAJORITY ? "error" : "warn", {
+        count: claims.unredeemed,
+        evidence: ev("ticketClaimsUnused", { count: claims.unredeemed, total: claims.claimedPast }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/events" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "events.upcoming_without_comms_journey",
+    area: "events",
+    severity: "info",
+    evaluate(facts) {
+      const events = areaFacts(facts, "events");
+      if (
+        events?.upcoming30d === undefined ||
+        events.upcoming7dWithRegistrations === undefined ||
+        events.nurtureActive === undefined
+      ) {
+        return UNKNOWN;
+      }
+      if (events.upcoming30d === 0 || events.nurtureActive) return OK;
+      // Wydarzenie w ciągu tygodnia z zapisanymi, a nikt nie przypomni im o terminie.
+      return finding(events.upcoming7dWithRegistrations > 0 ? "error" : "warn", {
+        count: events.upcoming30d,
+        evidence: ev("eventsWithoutNurture", {
+          count: events.upcoming30d,
+          soon: events.upcoming7dWithRegistrations,
+        }),
+      });
+    },
+    fix: {
+      kind: "link",
+      to: "/admin/revenue/journeys",
+      search: { new: "1", template: "event_registration_nurture" },
+    },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/funnel.ts b/src/lib/revenue/diagnostics/checks/funnel.ts
new file mode 100644
index 000000000..80cd29ca6
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/funnel.ts
@@ -0,0 +1,69 @@
+// Reguły obszaru „Lejek" (SPEC §5.7; regresje P16 i P17, DZ §18.4).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/**
+ * Więcej niż połowa rejestracji bez źródła = raport źródeł przestaje mówić
+ * prawdę o kanałach (większość wiersza to „nieznane"). Granica logiczna
+ * (większość), nie benchmark.
+ */
+export const ATTRIBUTION_UNKNOWN_MAJORITY = 0.5;
+
+const OWNER = { to: "/admin/newsletter/popup" } as const;
+
+export const FUNNEL_CHECKS = [
+  {
+    id: "funnel.signup_attribution_missing",
+    area: "funnel",
+    severity: "warning",
+    evaluate(facts) {
+      const funnel = areaFacts(facts, "funnel");
+      if (funnel?.signups30d === undefined || funnel.unknownSource30d === undefined) return UNKNOWN;
+      if (funnel.signups30d === 0 || funnel.unknownSource30d === 0) return OK;
+      const share = funnel.unknownSource30d / funnel.signups30d;
+      // Wszystkie rejestracje bez źródła = atrybucja martwa (regresja P16).
+      if (funnel.unknownSource30d >= funnel.signups30d) {
+        return finding("error", {
+          count: funnel.unknownSource30d,
+          evidence: ev("attributionDead", { count: funnel.signups30d }),
+        });
+      }
+      if (share > ATTRIBUTION_UNKNOWN_MAJORITY) {
+        return finding("warn", {
+          count: funnel.unknownSource30d,
+          evidence: ev("attributionMostlyUnknown", {
+            unknown: funnel.unknownSource30d,
+            total: funnel.signups30d,
+          }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "funnel.signup_attribution_missing" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // P17: zaproszenie do konta pokazywane zalogowanym. Ślad = zapis
+    // z popupu przez konto założone wcześniej; w ostatnich 7 dniach regresja
+    // trwa, starszy ślad w oknie 30 dni - historia do sprawdzenia.
+    id: "funnel.signup_popup_for_members",
+    area: "funnel",
+    severity: "warning",
+    evaluate(facts) {
+      const funnel = areaFacts(facts, "funnel");
+      if (funnel?.popupMembers7d === undefined || funnel.popupMembers30d === undefined) return UNKNOWN;
+      if (funnel.popupMembers30d === 0) return OK;
+      return finding(funnel.popupMembers7d > 0 ? "error" : "warn", {
+        count: funnel.popupMembers30d,
+        evidence: ev("popupForMembers", {
+          recent: funnel.popupMembers7d,
+          count: funnel.popupMembers30d,
+        }),
+      });
+    },
+    fix: { kind: "code", issueRef: "funnel.signup_popup_for_members" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/journeys.ts b/src/lib/revenue/diagnostics/checks/journeys.ts
new file mode 100644
index 000000000..d11189da8
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/journeys.ts
@@ -0,0 +1,179 @@
+// Reguły obszaru „Ścieżki komunikacji" (SPEC §5.7; S5).
+//
+// Progi operacyjne mają źródło w kodzie, nie w benchmarku: zaległość
+// skrzynki mierzymy progami świeżości harmonogramu (`SCHEDULER_*_MS`, ta sama
+// kropka „działa / opóźnienie / stoi" co w nagłówku huba), odsetek błędów -
+// granicą większości (więcej nieudanych kroków niż udanych = awaria
+// systemowa, nie pojedynczy kontakt).
+import { SCHEDULER_FRESH_MS, SCHEDULER_LAGGING_MS } from "@/lib/jobs/scheduler";
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/**
+ * Rdzeń ścieżek (REK pakietu S7 §3.8 - SPEC listy nie podaje): M3 =
+ * powitanie i porzucona kasa (bez nich lejek samoobsługi nie ma żadnego
+ * kontaktu); rozszerzenie Insidera = opieka nad zapisanymi na wydarzenie,
+ * zaległa płatność B2B i ratowanie zaplanowanego anulowania.
+ */
+export const CORE_JOURNEY_TEMPLATES = ["welcome_onboarding", "abandoned_checkout"] as const;
+export const EXTENDED_CORE_JOURNEY_TEMPLATES = [
+  "event_registration_nurture",
+  "payment_failed_crm",
+  "cancel_scheduled_save",
+] as const;
+
+/** Większość nieudanych kroków (≥ 50 %) = awaria systemowa. */
+export const STEP_FAILURE_MAJORITY = 0.5;
+
+const OWNER = { to: "/admin/revenue/journeys" } as const;
+
+export const JOURNEYS_CHECKS = [
+  {
+    id: "journeys.missing_core",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const active = areaFacts(facts, "journeys")?.activeTemplates;
+      if (!active) return UNKNOWN;
+      const core = CORE_JOURNEY_TEMPLATES.filter((key) => !active.includes(key));
+      const extended = EXTENDED_CORE_JOURNEY_TEMPLATES.filter((key) => !active.includes(key));
+      if (core.length + extended.length === 0) return OK;
+      return finding(core.length > 0 ? "error" : "warn", {
+        count: core.length + extended.length,
+        refs: [...core, ...extended],
+        evidence: [
+          ...(core.length > 0 ? [ev("journeysCoreMissing", { count: core.length })] : []),
+          ...(extended.length > 0
+            ? [ev("journeysExtendedMissing", { count: extended.length })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys", search: { new: "1" }, refParam: "template" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "journeys.engine_disabled_with_active",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const journeys = areaFacts(facts, "journeys");
+      if (
+        journeys?.engineEnabled === undefined ||
+        journeys.activeCount === undefined ||
+        journeys.pendingInbox === undefined
+      ) {
+        return UNKNOWN;
+      }
+      if (journeys.engineEnabled || journeys.activeCount === 0) return OK;
+      // Zdarzenia czekają w skrzynce - kontakty, które powinny dostać
+      // wiadomość, właśnie jej nie dostają.
+      return finding(journeys.pendingInbox > 0 ? "error" : "warn", {
+        count: journeys.activeCount,
+        evidence: ev("engineOffWithActive", {
+          count: journeys.activeCount,
+          pending: journeys.pendingInbox,
+        }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "journeys.step_error_rate",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const runs = areaFacts(facts, "journeys")?.stepRuns24h;
+      if (runs?.finished === undefined || runs.failed === undefined) return UNKNOWN;
+      if (runs.finished === 0 || runs.failed === 0) return OK;
+      const share = runs.failed / runs.finished;
+      return finding(share >= STEP_FAILURE_MAJORITY ? "error" : "warn", {
+        count: runs.failed,
+        evidence: ev("stepFailures", {
+          count: runs.failed,
+          total: runs.finished,
+          percent: Math.round(share * 100),
+        }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "journeys.inbox_backlog",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const journeys = areaFacts(facts, "journeys");
+      const now = facts.computedAt === null ? Number.NaN : Date.parse(facts.computedAt);
+      if (
+        journeys?.pendingInbox === undefined ||
+        journeys.oldestPendingAt === undefined ||
+        !Number.isFinite(now)
+      ) {
+        return UNKNOWN;
+      }
+      if (journeys.pendingInbox === 0 || journeys.oldestPendingAt === null) return OK;
+      const ageMs = now - Date.parse(journeys.oldestPendingAt);
+      if (!Number.isFinite(ageMs) || ageMs <= SCHEDULER_FRESH_MS) return OK;
+      const minutes = Math.round(ageMs / 60_000);
+      return finding(ageMs > SCHEDULER_LAGGING_MS ? "error" : "warn", {
+        count: journeys.pendingInbox,
+        evidence: ev("inboxBacklog", { count: journeys.pendingInbox, minutes }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "journeys.dead_steps",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const journeys = areaFacts(facts, "journeys");
+      if (journeys?.deadSteps === undefined || journeys.deadJourneys === undefined) return UNKNOWN;
+      if (journeys.deadSteps.length === 0) return OK;
+      const unreached = journeys.deadSteps.reduce((sum, j) => sum + j.unreached, 0);
+      // Ścieżka z zapisami, w której NIE wykonał się żaden krok - martwa cała.
+      return finding(journeys.deadJourneys > 0 ? "error" : "warn", {
+        count: unreached,
+        refs: journeys.deadSteps.map((j) => j.journeyId),
+        evidence: ev(journeys.deadJourneys > 0 ? "deadJourneys" : "deadSteps", {
+          count: unreached,
+          journeys: journeys.deadJourneys > 0 ? journeys.deadJourneys : journeys.deadSteps.length,
+        }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // Akcja ścieżki A emituje zdarzenie, na którym startuje ścieżka B, a B -
+    // to, na którym startuje A. Przy ponownym wejściu (`reentry` inne niż
+    // `never`) kontakt krąży bez końca.
+    id: "journeys.trigger_cycle",
+    area: "journeys",
+    severity: "warning",
+    evaluate(facts) {
+      const cycles = areaFacts(facts, "journeys")?.cycles;
+      if (!cycles) return UNKNOWN;
+      if (cycles.bounded + cycles.unbounded === 0) return OK;
+      return finding(cycles.unbounded > 0 ? "error" : "warn", {
+        count: cycles.bounded + cycles.unbounded,
+        refs: cycles.refs,
+        evidence: ev(cycles.unbounded > 0 ? "triggerCycleUnbounded" : "triggerCycleBounded", {
+          count: cycles.bounded + cycles.unbounded,
+        }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/journeys" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/metering.ts b/src/lib/revenue/diagnostics/checks/metering.ts
new file mode 100644
index 000000000..74e659287
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/metering.ts
@@ -0,0 +1,85 @@
+// Reguły obszaru „Limit darmowych artykułów" (SPEC §5.7; def. 14 br. 02, P19).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+const OWNER = { to: "/admin/paywall", search: { tab: "metering" } } as const;
+
+export const METERING_CHECKS = [
+  {
+    // Brak wiersza ustawień = serwer traktuje licznik jak WYŁĄCZONY (def. 14),
+    // choć formularz pokazuje wartości domyślne - czytelnik treści objętej
+    // licznikiem dostaje twardy paywall zamiast darmowych artykułów.
+    id: "metering.settings_row_missing",
+    area: "metering",
+    severity: "critical",
+    evaluate(facts) {
+      const metering = areaFacts(facts, "metering");
+      if (metering?.settingsRow === undefined || metering.meteredRules === undefined) return UNKNOWN;
+      if (metering.settingsRow) return OK;
+      return finding(metering.meteredRules > 0 ? "error" : "warn", {
+        count: metering.meteredRules,
+        evidence: ev("meteringRowMissing", { count: metering.meteredRules }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "metering_defaults" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "metering.anon_zero_limit",
+    area: "metering",
+    severity: "info",
+    evaluate(facts) {
+      const metering = areaFacts(facts, "metering");
+      if (metering?.settingsRow === undefined) return UNKNOWN;
+      // Bez wiersza o licznik pyta reguła wyżej; wyłączony licznik nie ma limitu gości.
+      if (!metering.settingsRow || metering.enabled === false) return OK;
+      if (
+        metering.enabled === undefined ||
+        metering.anonMonthlyLimit === undefined ||
+        metering.anonMonthlyLimit === null ||
+        metering.memberMonthlyLimit === undefined ||
+        metering.memberMonthlyLimit === null
+      ) {
+        return UNKNOWN;
+      }
+      if (metering.anonMonthlyLimit > 0) return OK;
+      // Licznik włączony, a ani gość, ani członek nie dostaje artykułu -
+      // ustawienie sprzeczne; sam gość bez limitu to świadoma ściana rejestracji.
+      return metering.memberMonthlyLimit === 0
+        ? finding("error", { evidence: ev("meteringNobodyFree") })
+        : finding("warn", {
+            evidence: ev("meteringAnonZero", { members: metering.memberMonthlyLimit }),
+          });
+    },
+    fix: { kind: "dialog", dialog: "metering_anon_limit" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // P19: licznik wydawał treść z progiem rangi każdemu. Sonda czyta ciało
+    // `_metered_view_consume` - poprawka 20261020120200 pyta o rangę
+    // czytającego (`user_tier_rank`); jej brak = regresja.
+    id: "metering.rank_bypass",
+    area: "metering",
+    severity: "critical",
+    evaluate(facts) {
+      const metering = areaFacts(facts, "metering");
+      if (
+        metering?.rankGatePresent === undefined ||
+        metering.rankGatePresent === null ||
+        metering.meteredTierGated === undefined
+      ) {
+        return UNKNOWN;
+      }
+      if (metering.rankGatePresent) return OK;
+      return finding(metering.meteredTierGated > 0 ? "error" : "warn", {
+        count: metering.meteredTierGated,
+        evidence: ev("meteringRankBypass", { count: metering.meteredTierGated }),
+      });
+    },
+    fix: { kind: "code", issueRef: "metering.rank_bypass" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/newsletter.ts b/src/lib/revenue/diagnostics/checks/newsletter.ts
new file mode 100644
index 000000000..3f9367dde
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/newsletter.ts
@@ -0,0 +1,64 @@
+// Reguły obszaru „Newsletter i lista" (SPEC §5.7).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/**
+ * Najemca bez wiersza `newsletter_settings` działa na DEFAULT kolumn:
+ * newsletter włączony, double opt-in WYŁĄCZONY, popup wyłączony. Bez tego
+ * lustra brak wiersza wyglądałby jak „nie wiadomo", a to jest stan znany.
+ */
+export const NEWSLETTER_COLUMN_DEFAULTS = {
+  enabled: true,
+  doubleOptIn: false,
+  popupEnabled: false,
+} as const;
+
+const OWNER = { to: "/admin/newsletter" } as const;
+
+export const NEWSLETTER_CHECKS = [
+  {
+    id: "newsletter.doi_disabled",
+    area: "newsletter",
+    severity: "warning",
+    evaluate(facts) {
+      const newsletter = areaFacts(facts, "newsletter");
+      if (newsletter?.settingsRow === undefined) return UNKNOWN;
+      const row = newsletter.settingsRow;
+      const doubleOptIn = row ? newsletter.doubleOptIn : NEWSLETTER_COLUMN_DEFAULTS.doubleOptIn;
+      const popup = row ? newsletter.popupEnabled : NEWSLETTER_COLUMN_DEFAULTS.popupEnabled;
+      if (doubleOptIn === undefined || doubleOptIn === null || popup === undefined || popup === null) {
+        return UNKNOWN;
+      }
+      if (doubleOptIn) return OK;
+      // Popup zbiera adresy właśnie teraz - każdy bez potwierdzenia zgody.
+      return finding(popup ? "error" : "warn", {
+        evidence: ev(popup ? "doiOffPopupOn" : "doiOff"),
+      });
+    },
+    fix: { kind: "dialog", dialog: "newsletter_doi" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // Nadawca platformy (`onboarding@resend.dev`) albo pusty - wysyłki
+    // lądują w spamie albo nie wychodzą. Fakt to WYŁĄCZNIE flaga: adres
+    // nadawcy nie opuszcza bazy.
+    id: "newsletter.default_sender",
+    area: "newsletter",
+    severity: "critical",
+    evaluate(facts) {
+      const newsletter = areaFacts(facts, "newsletter");
+      if (newsletter?.defaultSender === undefined || newsletter.campaignsSent30d === undefined) {
+        return UNKNOWN;
+      }
+      if (!newsletter.defaultSender) return OK;
+      return finding(newsletter.campaignsSent30d > 0 ? "error" : "warn", {
+        count: newsletter.campaignsSent30d,
+        evidence: ev("defaultSender", { count: newsletter.campaignsSent30d }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "newsletter_sender" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/paywall.ts b/src/lib/revenue/diagnostics/checks/paywall.ts
new file mode 100644
index 000000000..0740fbd91
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/paywall.ts
@@ -0,0 +1,110 @@
+// Reguły obszaru „Paywall i reguły dostępu" (SPEC §5.7; P14, P18).
+//
+// Ślepe zaułki liczy SQL tymi samymi warunkami co inwentarz dostępu
+// (`admin_revenue_access_inventory`, 120400), więc liczba w diagnozie
+// i w zakładce Dostęp jest jedna. `error` = do zaułka trafił w ostatnich 30
+// dniach czytelnik (uderzenie w paywall tej treści), `warn` = zaułek bez ruchu.
+import { areaFacts, ev, finding, OK, UNKNOWN, type CountWithRefs } from "../facts";
+import type { RevenueCheck, RevenueCheckFix } from "../registry";
+
+/**
+ * Tydzień bez ani jednego uderzenia w paywall przy treści płatnej = pomiar
+ * milczy. Tydzień obejmuje pełny cykl ruchu (dni robocze + weekend), więc
+ * cisza nie jest zwykłym spokojnym dniem. Próg operacyjny, nie benchmark.
+ */
+export const PAYWALL_SILENT_DAYS = 7;
+
+const DAY_MS = 86_400_000;
+
+const OWNER_OVERRIDES = { to: "/admin/paywall", search: { tab: "overrides" } } as const;
+
+/** Ślepy zaułek: `error`, gdy dotarł do niego czytelnik w 30 dni. */
+function deadEnd(
+  value: CountWithRefs | undefined,
+  key: string,
+): ReturnType<RevenueCheck["evaluate"]> {
+  if (value?.count === undefined || value.withHits30d === undefined) return UNKNOWN;
+  if (value.count === 0) return OK;
+  return finding(value.withHits30d > 0 ? "error" : "warn", {
+    count: value.count,
+    refs: value.refs,
+    evidence: ev(key, { count: value.count, withHits: value.withHits30d }),
+  });
+}
+
+const ACCESS_RULE_FIX: RevenueCheckFix = { kind: "dialog", dialog: "access_rule_plan" };
+
+export const PAYWALL_CHECKS = [
+  {
+    id: "paywall.paid_without_buyable_plan",
+    area: "paywall",
+    severity: "critical",
+    evaluate: (facts) => deadEnd(areaFacts(facts, "paywall")?.paidWithoutOffer, "paidWithoutOffer"),
+    fix: ACCESS_RULE_FIX,
+    owner: OWNER_OVERRIDES,
+    snoozable: true,
+  },
+  {
+    id: "paywall.rule_inactive_plan",
+    area: "paywall",
+    severity: "warning",
+    evaluate: (facts) => deadEnd(areaFacts(facts, "paywall")?.danglingRules, "ruleInactivePlan"),
+    fix: ACCESS_RULE_FIX,
+    owner: OWNER_OVERRIDES,
+    snoozable: true,
+  },
+  {
+    id: "paywall.members_rank_no_cta",
+    area: "paywall",
+    severity: "warning",
+    evaluate: (facts) =>
+      deadEnd(areaFacts(facts, "paywall")?.membersRankNoCta, "membersRankNoCta"),
+    fix: { kind: "link", to: "/admin/pricing", search: { tab: "tiers" } },
+    owner: OWNER_OVERRIDES,
+    snoozable: true,
+  },
+  {
+    id: "paywall.measurement_silent",
+    area: "paywall",
+    severity: "warning",
+    evaluate(facts) {
+      const paywall = areaFacts(facts, "paywall");
+      const now = facts.computedAt === null ? Number.NaN : Date.parse(facts.computedAt);
+      if (
+        !paywall ||
+        paywall.gatedRules === undefined ||
+        paywall.lastHitAt === undefined ||
+        paywall.firstGatedAt === undefined ||
+        !Number.isFinite(now)
+      ) {
+        return UNKNOWN;
+      }
+      if (paywall.gatedRules === 0) return OK;
+      const silentSince = now - PAYWALL_SILENT_DAYS * DAY_MS;
+      if (paywall.lastHitAt === null) {
+        const gatedAt = paywall.firstGatedAt === null ? now : Date.parse(paywall.firstGatedAt);
+        // Treść płatna stoi dłużej niż tydzień, a pomiar nie zapisał NIC.
+        if (gatedAt < silentSince) {
+          return finding("error", {
+            count: paywall.gatedRules,
+            evidence: ev("paywallNeverMeasured", {
+              count: paywall.gatedRules,
+              days: PAYWALL_SILENT_DAYS,
+            }),
+          });
+        }
+        return OK;
+      }
+      if (Date.parse(paywall.lastHitAt) < silentSince) {
+        return finding("warn", {
+          count: paywall.gatedRules,
+          evidence: ev("paywallSilent", { count: paywall.gatedRules, days: PAYWALL_SILENT_DAYS }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "paywall.measurement_silent" },
+    owner: { to: "/admin/paywall" },
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/retention.ts b/src/lib/revenue/diagnostics/checks/retention.ts
new file mode 100644
index 000000000..7121f9955
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/retention.ts
@@ -0,0 +1,124 @@
+// Reguły obszaru „Retencja" (SPEC §5.7; P01, P02, Z-09).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+/** Najdłuższa dopuszczalna ścieżka anulowania (SPEC §2.2: „przepływ anulowania (≤ 2 kroki)"). */
+export const RETENTION_MAX_STEPS = 2;
+
+const OWNER = { to: "/admin/pricing", search: { tab: "retention" } } as const;
+
+export const RETENTION_CHECKS = [
+  {
+    id: "retention.not_configured",
+    area: "retention",
+    severity: "warning",
+    evaluate(facts) {
+      const retention = areaFacts(facts, "retention");
+      if (retention?.settingsRow === undefined) return UNKNOWN;
+      if (retention.settingsRow && retention.enabled === true) return OK;
+      if (retention.cancellations30d === undefined) return UNKNOWN;
+      // Klienci odchodzą TERAZ bez kontroferty - utracona szansa trwa.
+      return finding(retention.cancellations30d > 0 ? "error" : "warn", {
+        count: retention.cancellations30d,
+        evidence: ev(retention.settingsRow ? "retentionDisabled" : "retentionMissing", {
+          count: retention.cancellations30d,
+        }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "retention_enable" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // P01: anulowanie z pominięciem przepływu. Wpis z portalu operatora
+    // (`stripe:<kod>`) to obejście, ale z powodem (warn); anulowanie bez
+    // żadnego wpisu to utracony powód i utracona szansa (error).
+    id: "retention.provider_cancel_bypasses_flow",
+    area: "retention",
+    severity: "critical",
+    evaluate(facts) {
+      const bypass = areaFacts(facts, "retention")?.flowBypass;
+      if (bypass?.withoutFeedback === undefined || bypass.providerOnly === undefined) return UNKNOWN;
+      if (bypass.withoutFeedback + bypass.providerOnly === 0) return OK;
+      return finding(bypass.withoutFeedback > 0 ? "error" : "warn", {
+        count: bypass.withoutFeedback + bypass.providerOnly,
+        refs: bypass.refs,
+        evidence: [
+          ...(bypass.withoutFeedback > 0
+            ? [ev("cancelWithoutFeedback", { count: bypass.withoutFeedback })]
+            : []),
+          ...(bypass.providerOnly > 0
+            ? [ev("cancelProviderOnly", { count: bypass.providerOnly })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "code", issueRef: "retention.provider_cancel_bypasses_flow" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    id: "retention.cancel_flow_too_long",
+    area: "retention",
+    severity: "critical",
+    evaluate(facts) {
+      const retention = areaFacts(facts, "retention");
+      const steps = retention?.cancelPathSteps;
+      if (steps === undefined) return UNKNOWN;
+      if (steps > RETENTION_MAX_STEPS) {
+        return finding("error", {
+          count: steps,
+          evidence: ev("cancelFlowSteps", { steps, max: RETENTION_MAX_STEPS }),
+        });
+      }
+      if (steps < RETENTION_MAX_STEPS) return OK;
+      // Na granicy dwóch kroków: jeśli większość klientów porzuca przepływ
+      // w połowie, ścieżka jest dla nich za długa, choć mieści się w regule.
+      const flows = retention?.flows30d;
+      if (flows?.abandoned === undefined || flows.canceled === undefined || flows.saved === undefined) {
+        return UNKNOWN;
+      }
+      if (flows.abandoned > flows.canceled + flows.saved) {
+        return finding("warn", {
+          count: flows.abandoned,
+          evidence: ev("cancelFlowAbandoned", {
+            abandoned: flows.abandoned,
+            finished: flows.canceled + flows.saved,
+          }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "retention.cancel_flow_too_long" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // P02: oferta przyjęta, a subskrypcja u operatora bez rabatu (kupon
+    // niewykonalny albo jednorazowy) - klient dostał obietnicę bez skutku.
+    // Rabat ustawiony na jeden okres to świadomy wybór, ale „jednorazowy" -
+    // zgłaszamy jako uśpione ryzyko tego samego defektu.
+    id: "retention.offer_once_discount",
+    area: "retention",
+    severity: "warning",
+    evaluate(facts) {
+      const retention = areaFacts(facts, "retention");
+      if (retention?.acceptedWithoutDiscount30d === undefined || retention.settingsRow === undefined) {
+        return UNKNOWN;
+      }
+      if (retention.acceptedWithoutDiscount30d > 0) {
+        return finding("error", {
+          count: retention.acceptedWithoutDiscount30d,
+          evidence: ev("offerAcceptedNoDiscount", { count: retention.acceptedWithoutDiscount30d }),
+        });
+      }
+      if (retention.settingsRow && retention.enabled === true && retention.discountPeriods === 1) {
+        return finding("warn", { evidence: ev("offerSinglePeriod") });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "retention.offer_once_discount" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/sync.ts b/src/lib/revenue/diagnostics/checks/sync.ts
new file mode 100644
index 000000000..955ff7827
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/sync.ts
@@ -0,0 +1,90 @@
+// Reguły obszaru „Synchronizacja" (SPEC §5.7, §3; br. 03 D7 - dryf katalogu
+// zdarzeń). Szyna zdarzeń jest kręgosłupem huba: karta w innej zakładce
+// odświeża się wyłącznie po zdarzeniu, a ścieżki startują tylko z niego.
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+const OWNER = { to: "/admin/revenue/diagnostics", search: { view: "map" } } as const;
+
+export const SYNC_CHECKS = [
+  {
+    // Typ zdarzenia z rytmem co najmniej tygodniowym (≥ 11 w 83 dni przed
+    // ostatnim tygodniem) bez ani jednego zdarzenia w 7 dni = emiter
+    // ucichł; rytm dzienny (≥ 83) bez zdarzeń w tydzień = emiter nie działa.
+    id: "sync.emitter_silent",
+    area: "sync",
+    severity: "warning",
+    evaluate(facts) {
+      const sync = areaFacts(facts, "sync");
+      if (!sync?.silentDaily || !sync.silentWeekly) return UNKNOWN;
+      const all = [...sync.silentDaily, ...sync.silentWeekly];
+      if (all.length === 0) return OK;
+      return finding(sync.silentDaily.length > 0 ? "error" : "warn", {
+        count: all.length,
+        refs: all,
+        evidence: ev("emitterSilent", { count: all.length, daily: sync.silentDaily.length }),
+      });
+    },
+    fix: { kind: "link", to: "/admin/revenue/diagnostics", search: { view: "map" } },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // Dryf katalogu (D7): typ w bazie spoza `DOMAIN_EVENT_TYPES` nie trafia
+    // do żadnej reguły odświeżania (error); typ katalogu bez zdarzenia
+    // w 90 dni to martwy wpis albo funkcja, której najemca nie używa (warn).
+    id: "sync.dead_event_types",
+    area: "sync",
+    severity: "info",
+    evaluate(facts) {
+      const sync = areaFacts(facts, "sync");
+      if (!sync?.deadTypes || !sync.unknownTypes) return UNKNOWN;
+      if (sync.unknownTypes.length > 0) {
+        return finding("error", {
+          count: sync.unknownTypes.length,
+          refs: sync.unknownTypes,
+          evidence: ev("eventTypesUnknown", { count: sync.unknownTypes.length }),
+        });
+      }
+      if (sync.deadTypes.length > 0) {
+        return finding("warn", {
+          count: sync.deadTypes.length,
+          refs: sync.deadTypes,
+          evidence: ev("eventTypesDead", { count: sync.deadTypes.length }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "sync.dead_event_types" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // Krytyczna i NIEWYCISZALNA: błąd emitera = zmiana, o której nie wie
+    // żadna inna karta ani ścieżka. Odczyt dziennika tylko z funkcji definer
+    // (Z-03: `domain_event_emit_errors` czyta wyłącznie admin najemcy).
+    id: "sync.emit_errors",
+    area: "sync",
+    severity: "critical",
+    evaluate(facts) {
+      const sync = areaFacts(facts, "sync");
+      if (sync?.emitErrors24h === undefined || sync.emitErrors7d === undefined) return UNKNOWN;
+      if (sync.emitErrors24h > 0) {
+        return finding("error", {
+          count: sync.emitErrors24h,
+          evidence: ev("emitErrors24h", { count: sync.emitErrors24h }),
+        });
+      }
+      if (sync.emitErrors7d > 0) {
+        return finding("warn", {
+          count: sync.emitErrors7d,
+          evidence: ev("emitErrors7d", { count: sync.emitErrors7d }),
+        });
+      }
+      return OK;
+    },
+    fix: { kind: "code", issueRef: "sync.emit_errors" },
+    owner: OWNER,
+    snoozable: false,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/checks/workflows.ts b/src/lib/revenue/diagnostics/checks/workflows.ts
new file mode 100644
index 000000000..945997e9d
--- /dev/null
+++ b/src/lib/revenue/diagnostics/checks/workflows.ts
@@ -0,0 +1,82 @@
+// Reguły obszaru „Automatyzacje" (SPEC §5.7; regresje D1 i D13 br. 03).
+import { areaFacts, ev, finding, OK, UNKNOWN } from "../facts";
+import type { RevenueCheck } from "../registry";
+
+const OWNER = { to: "/admin/workflows", search: { tab: "definitions" } } as const;
+
+export const WORKFLOWS_CHECKS = [
+  {
+    // D1: przepis `newsletter-confirmed-to-crm` kończył się „sukcesem" bez
+    // wykonania kroku (redakcja ładunku usuwała adres). Przebieg udany
+    // z zerem kroków w 7 dniach = regresja trwa; starszy ślad = historia.
+    id: "workflows.newsletter_confirmed_noop",
+    area: "workflows",
+    severity: "warning",
+    evaluate(facts) {
+      const noop = areaFacts(facts, "workflows")?.newsletterConfirmedNoop;
+      if (noop?.recent === undefined || noop.older === undefined) return UNKNOWN;
+      if (noop.recent + noop.older === 0) return OK;
+      return finding(noop.recent > 0 ? "error" : "warn", {
+        count: noop.recent + noop.older,
+        refs: noop.refs,
+        evidence: ev("newsletterConfirmedNoop", { recent: noop.recent, count: noop.recent + noop.older }),
+      });
+    },
+    fix: { kind: "code", issueRef: "workflows.newsletter_confirmed_noop" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // D13: pauza u operatora zapisuje dostęp jako `canceled`, więc przepis
+    // „anulowanie -> zadanie win-back" odpala się na pauzie. Billing anuluje
+    // takie zadania (`closeRetentionTasks`) - ich liczba w 30 dniach to ślad.
+    id: "workflows.cancel_recipe_fires_on_pause",
+    area: "workflows",
+    severity: "warning",
+    evaluate(facts) {
+      const recipe = areaFacts(facts, "workflows")?.cancelRecipe;
+      if (recipe === undefined) return UNKNOWN;
+      if (recipe === null || recipe.enabled === false || recipe.guarded === true) return OK;
+      if (recipe.enabled === undefined || recipe.cancelledByPause30d === undefined) return UNKNOWN;
+      return finding(recipe.cancelledByPause30d > 0 ? "error" : "warn", {
+        count: recipe.cancelledByPause30d,
+        refs: recipe.id ? [recipe.id] : [],
+        evidence: ev(recipe.cancelledByPause30d > 0 ? "cancelRecipeFiredOnPause" : "cancelRecipeUnguarded", {
+          count: recipe.cancelledByPause30d,
+        }),
+      });
+    },
+    fix: { kind: "dialog", dialog: "workflow_disable" },
+    owner: OWNER,
+    snoozable: true,
+  },
+  {
+    // Przepis i ścieżka na tym samym zdarzeniu piszą do tego samego kontaktu
+    // dwa razy. Szablon ścieżki, który ZASTĘPUJE przepis
+    // (`replacesWorkflowTemplate`), przy obu włączonych dubluje zadania (error).
+    id: "workflows.overlaps_journey",
+    area: "workflows",
+    severity: "info",
+    evaluate(facts) {
+      const overlaps = areaFacts(facts, "workflows")?.overlaps;
+      if (!overlaps) return UNKNOWN;
+      const all = [...overlaps.duplicates, ...overlaps.sharedTrigger];
+      if (all.length === 0) return OK;
+      return finding(overlaps.duplicates.length > 0 ? "error" : "warn", {
+        count: all.length,
+        refs: [...new Set(all.map((o) => o.workflowId))],
+        evidence: [
+          ...(overlaps.duplicates.length > 0
+            ? [ev("workflowReplacedByJourney", { count: overlaps.duplicates.length })]
+            : []),
+          ...(overlaps.sharedTrigger.length > 0
+            ? [ev("workflowSharesTrigger", { count: overlaps.sharedTrigger.length })]
+            : []),
+        ],
+      });
+    },
+    fix: { kind: "dialog", dialog: "workflow_disable" },
+    owner: OWNER,
+    snoozable: true,
+  },
+] as const satisfies readonly RevenueCheck[];
diff --git a/src/lib/revenue/diagnostics/defectMap.ts b/src/lib/revenue/diagnostics/defectMap.ts
new file mode 100644
index 000000000..95f104afd
--- /dev/null
+++ b/src/lib/revenue/diagnostics/defectMap.ts
@@ -0,0 +1,107 @@
+// MAPA DEFEKTÓW → REGUŁY (SPEC §5.7 „defectMap.ts", §7, §9.4).
+//
+// Każdy defekt z tabeli SPEC §7 ma tu wpis: regułę diagnostyki, która
+// pilnuje jego regresji, albo `fixed:<wycinek>` (naprawiony w kodzie wycinka,
+// bez sygnału w danych, który reguła mogłaby czytać), albo `deferred`
+// (odłożony świadomie - SPEC §7 koniec, §9.4). Test (`defectMap.test.ts`)
+// czyta tabelę SPEC z repozytorium, więc nowy wiersz SPEC bez wpisu tutaj
+// zapala CI zamiast zniknąć.
+//
+// BRIEFY ŹRÓDŁOWE (`brief_01..05.md`) i `proposal_dane.md` NIE ISTNIEJĄ
+// w repozytorium (pakiet S7 §1.2) - mapa obejmuje dokładnie to, co widać
+// w tabeli §7 i na liście odłożonych. Numery z briefów spoza tabeli (np.
+// def. 1, 2, 5, 7, 8, 12, 16, 18, 19 br. 02; D2, D4, D8, D10, D15 br. 03;
+// br. 04 D2-D4, D11, D12) są w raporcie jako „brak w źródle repo" - bez
+// zgadywania treści.
+//
+// Klucze = pierwsza kolumna tabeli SPEC dosłownie (bez znaczników kodu).
+import type { HubSliceId } from "@/lib/ci/hubDelivery";
+import type { RevenueCheckId } from "./registry";
+
+export type DefectTarget = RevenueCheckId | `fixed:${HubSliceId}` | "deferred";
+
+export const DEFECT_MAP: Readonly<Record<string, DefectTarget>> = {
+  P01: "retention.provider_cancel_bypasses_flow",
+  P02: "retention.offer_once_discount",
+  P03: "coupons.grant_tier_broken",
+  P04: "coupons.campaign_sent_without_codes",
+  P05: "catalog.enquiry_plan_buyable",
+  P07: "catalog.price_change_without_notice",
+  P08: "fixed:S3",
+  P09: "checkout.display_currency_mismatch",
+  // Mieszanie walut i środowisk naprawia S1/S2/I9; dokument bez środowiska
+  // (źródło mieszania) pilnuje reguła jakości danych.
+  P10: "data_quality.documents_env_unknown",
+  P11: "fixed:S2",
+  P12: "fixed:S2",
+  // Pauza = `canceled` odpala przepis win-back (D13 br. 03).
+  P13: "workflows.cancel_recipe_fires_on_pause",
+  P14: "paywall.members_rank_no_cta",
+  P15: "fixed:S3",
+  P16: "funnel.signup_attribution_missing",
+  P17: "funnel.signup_popup_for_members",
+  P18: "paywall.measurement_silent",
+  P19: "metering.rank_bypass",
+  P20: "catalog.promise_without_gate",
+  // Kasa przy `cta_mode=contact` - S3; wybór miejsc w kasie odłożony osobno.
+  P21: "fixed:S3",
+  P22: "fixed:S3",
+  P23: "fixed:S4",
+  P24: "crm.auto_tasks_without_assignee",
+  P25: "deferred",
+  "S1 / def. 3": "fixed:S1",
+  "def. 4": "fixed:S1",
+  "def. 6": "fixed:S1",
+  "def. 9": "fixed:S1",
+  "def. 10": "fixed:S1",
+  "def. 11": "fixed:S1",
+  "def. 13": "fixed:S1",
+  "def. 14": "metering.settings_row_missing",
+  "def. 15 / D2": "fixed:S4",
+  "def. 17": "fixed:S1",
+  D1: "workflows.newsletter_confirmed_noop",
+  "D3-D6": "fixed:S4",
+  "D7 (br. 03)": "sync.dead_event_types",
+  D9: "fixed:S4",
+  D11: "fixed:S4",
+  D12: "fixed:S5",
+  D14: "fixed:S6",
+  "br. 04 D1": "fixed:S6",
+  "br. 04 D5": "fixed:I0",
+  "br. 04 D6": "fixed:I0",
+  "br. 04 D7": "fixed:S4",
+  "br. 04 D8": "fixed:S2",
+  "br. 04 D9/D10": "fixed:S6",
+  "br. 04 D13": "fixed:S6",
+  email_ctr: "fixed:S6",
+  // Spoza tabeli §7, ale przywołany wprost w regułach SPEC §5.7.
+  "D13 (br. 03)": "workflows.cancel_recipe_fires_on_pause",
+};
+
+/** Odłożone świadomie (SPEC §7 koniec, warunki powrotu §9.4). */
+export const DEFERRED_DEFECTS: Readonly<Record<string, "deferred">> = {
+  P06: "deferred",
+  "P21 (wybór miejsc w kasie)": "deferred",
+  "P09 (currency_options)": "deferred",
+  "P25 (zdarzenie formularza kontaktu)": "deferred",
+  "P07 jako ścieżka (fan-out)": "deferred",
+  "A/B > 2 ramion i automatyczny zwycięzca": "deferred",
+  "przenoszenie zapisów między wersjami": "deferred",
+  "atrybucja przychodu do maili": "deferred",
+  "deale/wartości w CRM i lifecyclestage do HubSpot": "deferred",
+  "UTM dla rejestracji": "deferred",
+  "okna kroczące lejka": "deferred",
+  "nadpisania benchmarków per najemca": "deferred",
