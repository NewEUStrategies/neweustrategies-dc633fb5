+
+export const DUNNING_CHECKS = [
+  {
+    id: "dunning.b2b_past_due_unhandled",
+    area: "dunning",
+    severity: "warning",
+    evaluate(facts) {
+      const dunning = areaFacts(facts, "dunning");
+      if (
+        dunning?.openB2b === undefined ||
+        dunning.withoutTask === undefined ||
+        dunning.journeyActive === undefined
