diff --git a/src/components/admin/revenue/diagnostics/DiagnosticCard.tsx b/src/components/admin/revenue/diagnostics/DiagnosticCard.tsx
new file mode 100644
index 000000000..89c88bc01
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/DiagnosticCard.tsx
@@ -0,0 +1,231 @@
+// Molekuła: jedna diagnoza (SPEC §6.1 `DiagnosticCard`) - w liście Diagnostyki
+// (`full`) i w karcie „Wymaga uwagi" na Kokpicie (`compact`).
+//
+// CO, DLACZEGO, CO ZROBIĆ. Nagłówek mówi, co jest nie tak (tytuł reguły,
+// waga słowem i ikoną, obszar, stan: „Skutek trwa" / „Do poprawy" / „Nie
+// wiadomo" / „Wyciszone"); dowody - dlaczego tak uważamy (liczby z faktów,
+// bez danych osobowych); akcje - co zrobić: „Napraw" (dialog z mutatorem
+// modułu), „Przejdź do naprawy" (odnośnik z parametrami kontraktu) albo
+// „Zgłoś do zespołu" (naprawa w kodzie - kopiuje opis z dowodami), plus
+// „Otwórz moduł" i wyciszenie.
+//
+// WYCISZENIE TYLKO DLA ADMINISTRATORA (SPEC §2.5): redaktor widzi przycisk
+// wyłączony z powodem (`DisabledReason`), a reguła krytyczna `sync`/
+// `data_quality` - powód „niewyciszalna". Ten sam warunek egzekwuje SQL.
+//
+// Kolor nigdy sam: stan i waga mają słowo; ramka karty zmienia wyłącznie
+// kolor tokenu (geometria identyczna w obu motywach).
+import { Link } from "@tanstack/react-router";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+
+import { DisabledReason } from "@/components/admin/pricing/atoms/DisabledReason";
+import { AreaChip } from "@/components/admin/revenue/atoms/AreaChip";
+import { SeverityLabel } from "@/components/admin/revenue/atoms/SeverityLabel";
+import { Button } from "@/components/ui/button";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import { ensureI18n as ensureShellI18n } from "@/lib/i18n-admin-revenue-shell";
+import type { RevenueFinding } from "@/lib/revenue/diagnostics/registry";
+import type { SnoozeKind } from "@/lib/revenue/limits";
+import { cn } from "@/lib/utils";
+import {
+  BADGE_KEY,
+  badgeOf,
+  checkDescription,
+  checkTitle,
+  evidenceSentence,
+  evidenceText,
+  findingDomId,
+  linkSearchOf,
+} from "./findingText";
+
+export interface DiagnosticCardProps {
+  finding: RevenueFinding;
+  variant: "full" | "compact";
+  /** Dialog naprawy (tylko `fix.kind = "dialog"`). */
+  onFix?(): void;
+  onSnooze?(kind: SnoozeKind): void;
+  onUnsnooze?(): void;
+  /** Rola administratora (wyciszanie) - dokładna, nie `isAdmin`. */
+  canSnooze?: boolean;
+  /** Zogniskowana adresem `?finding=`. */
+  focused?: boolean;
+  /** `computedAt` faktów - do opisu zgłoszenia. */
+  factsAt?: string | null;
+  className?: string;
+}
+
+const BADGE_TONE: Readonly<Record<ReturnType<typeof badgeOf>, string>> = {
+  error: "border-destructive/40 text-destructive",
+  warn: "border-border text-brand-ink dark:text-brand",
+  unknown: "border-border text-muted-foreground",
+  ok: "border-border text-muted-foreground",
+  snoozed: "border-border text-muted-foreground",
+};
+
+export function DiagnosticCard({
+  finding,
+  variant,
+  onFix,
+  onSnooze,
+  onUnsnooze,
+  canSnooze = false,
+  focused = false,
+  factsAt = null,
+  className,
+}: DiagnosticCardProps) {
+  ensureShellI18n();
+  ensureI18n();
+  const { t, i18n } = useTranslation();
+  const badge = badgeOf(finding);
+  const compact = variant === "compact";
+  const title = checkTitle(t, finding.checkId);
+  const evidence = compact ? finding.evidence.slice(0, 1) : finding.evidence;
+  const locale = i18n.language.startsWith("en") ? "en-GB" : "pl-PL";
+
+  const report = async () => {
+    const body = t("adminRevenue.diagnostics.card.reportBody", {
+      title,
+      id: finding.checkId,
+      state: t(BADGE_KEY[badge]),
+      evidence: evidenceSentence(t, finding) || "-",
+      at: factsAt ?? "-",
+    });
+    try {
+      await navigator.clipboard.writeText(body);
+      toast.success(t("adminRevenue.diagnostics.card.reported"));
+    } catch {
+      toast.error(t("adminRevenue.diagnostics.card.reportFailed"));
+    }
+  };
+
+  const snoozeReason = !finding.snoozable
+    ? t("adminRevenue.diagnostics.card.notSnoozable")
+    : canSnooze
+      ? null
+      : t("adminRevenue.diagnostics.card.snoozeAdminOnly");
+  const showSnooze = !compact && (finding.state === "warn" || finding.state === "error");
+  const snoozedUntil =
+    finding.snooze?.kind === "days" && finding.snooze.until
+      ? new Intl.DateTimeFormat(locale, { dateStyle: "medium" }).format(new Date(finding.snooze.until))
+      : null;
+
+  return (
+    <article
+      id={findingDomId(finding.checkId)}
+      tabIndex={-1}
+      aria-labelledby={`${findingDomId(finding.checkId)}-title`}
+      data-check-id={finding.checkId}
+      data-state={finding.state}
+      data-focused={focused || undefined}
+      className={cn(
+        "space-y-2 rounded-[6px] border bg-card p-3 outline-none focus-visible:ring-2 focus-visible:ring-ring",
+        focused ? "border-primary" : "border-border",
+        className,
+      )}
+    >
+      <div className="flex flex-wrap items-center gap-2">
+        <SeverityLabel severity={finding.severity} />
+        <AreaChip area={finding.area} />
+        <span
+          data-badge={badge}
+          className={cn("inline-flex items-center rounded-md border px-1.5 py-0.5 text-[11px] font-medium", BADGE_TONE[badge])}
+        >
+          {t(BADGE_KEY[badge])}
+        </span>
+        {!compact && finding.count !== null && finding.count > 0 ? (
+          <span className="text-xs tabular-nums text-muted-foreground">
+            {t("adminRevenue.diagnostics.card.count", { value: finding.count })}
+          </span>
+        ) : null}
+      </div>
+
+      <h3 id={`${findingDomId(finding.checkId)}-title`} className="m-0 text-sm font-semibold">
+        {title}
+      </h3>
+      {compact ? null : (
+        <p className="m-0 text-sm text-muted-foreground">{checkDescription(t, finding.checkId)}</p>
+      )}
+
+      {finding.state === "unknown" ? (
+        <p className="m-0 text-xs text-muted-foreground">{t("adminRevenue.diagnostics.card.unknownHint")}</p>
+      ) : evidence.length > 0 ? (
+        <div className="space-y-1">
+          {compact ? null : (
+            <p className="m-0 text-xs font-medium text-muted-foreground">
+              {t("adminRevenue.diagnostics.card.evidenceLabel")}
+            </p>
+          )}
+          <ul className="m-0 list-disc space-y-0.5 pl-5 text-sm">
+            {evidence.map((item) => (
+              <li key={item.key}>{evidenceText(t, item)}</li>
+            ))}
+          </ul>
+        </div>
+      ) : null}
+
+      {finding.snooze ? (
+        <p className="m-0 text-xs text-muted-foreground" data-testid="finding-snoozed">
+          {snoozedUntil
+            ? t("adminRevenue.diagnostics.card.snoozedUntil", { date: snoozedUntil })
+            : t("adminRevenue.diagnostics.card.snoozedIntentional", { reason: finding.snooze.reason ?? "-" })}
+        </p>
+      ) : null}
+
+      {finding.state === "warn" || finding.state === "error" || !compact ? (
+        <div className="flex flex-wrap items-center gap-2 pt-1">
+          {finding.fix?.kind === "dialog" && (finding.state === "warn" || finding.state === "error") ? (
+            <Button type="button" size="sm" className="h-7" onClick={onFix}>
+              {t("adminRevenue.diagnostics.card.fix")}
+            </Button>
+          ) : null}
+          {finding.fix?.kind === "link" && (finding.state === "warn" || finding.state === "error") ? (
+            <Button asChild size="sm" className="h-7">
+              <Link to={finding.fix.to} search={linkSearchOf(finding.fix, finding.refs)}>
+                {t("adminRevenue.diagnostics.card.openFix")}
+              </Link>
+            </Button>
+          ) : null}
+          {finding.fix?.kind === "code" && (finding.state === "warn" || finding.state === "error") ? (
+            <Button type="button" size="sm" variant="outline" className="h-7" onClick={() => void report()}>
+              {t("adminRevenue.diagnostics.card.report")}
+            </Button>
+          ) : null}
+          <Button asChild size="sm" variant="outline" className="h-7">
+            <Link to={finding.owner.to} search={finding.owner.search}>
+              {t("adminRevenue.diagnostics.card.openModule")}
+            </Link>
+          </Button>
+          {showSnooze && finding.snooze === null ? (
+            <DisabledReason reason={snoozeReason}>
+              <Button
+                type="button"
+                size="sm"
+                variant="ghost"
+                className="h-7"
+                disabled={snoozeReason !== null}
+                onClick={() => onSnooze?.("days")}
+              >
+                {t("adminRevenue.diagnostics.card.snooze")}
+              </Button>
+            </DisabledReason>
+          ) : null}
+          {!compact && finding.snooze !== null ? (
+            <DisabledReason reason={canSnooze ? null : t("adminRevenue.diagnostics.card.snoozeAdminOnly")}>
+              <Button
+                type="button"
+                size="sm"
+                variant="ghost"
+                className="h-7"
+                disabled={!canSnooze}
+                onClick={onUnsnooze}
+              >
+                {t("adminRevenue.diagnostics.card.unsnooze")}
+              </Button>
+            </DisabledReason>
+          ) : null}
+        </div>
+      ) : null}
+    </article>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/DiagnosticsBoard.tsx b/src/components/admin/revenue/diagnostics/DiagnosticsBoard.tsx
new file mode 100644
index 000000000..a232d3a40
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/DiagnosticsBoard.tsx
@@ -0,0 +1,427 @@
+// Organizm: tablica Diagnostyki (SPEC §2.2 `diagnostics`, §6.1) - lista
+// `DiagnosticCard` pogrupowana po obszarze z kondycją 0-100, filtry obszaru
+// (`?area=`), wagi i stanu, przełącznik „lista / mapa systemu" (`?view=`),
+// fokus diagnozy z adresu (`?finding=`) i dialog naprawy z adresu (`?fix=`).
+//
+// ADRES PRZEZ PROPSY. Tablica nie woła hooków routera: zakładka podaje
+// parametry i `onSearchChange`, więc ten sam organizm testuje się bez trasy
+// huba, a o kształcie adresu decyduje jeden walidator układu
+// (`parseRevenueHubSearch`). Waga i stan nie mają parametru w kontrakcie
+// URL (§2.6) - są stanem lokalnym, domyślnie „otwarte".
+//
+// `?fix=` SPRAWDZA, CZY REGUŁA NADAL JEST AKTYWNA. Link z maila albo
+// z historii przeglądarki może prowadzić do naprawy problemu, który już
+// zniknął - zamiast otwierać pusty dialog, mówimy wprost: „Ten problem już
+// nie występuje" (`role="status"`).
+//
+// ZERO WŁASNYCH ZAPYTAŃ: fakty i wyciszenia z fabryk `revenueFactsQueryOptions`
+// i `revenueSnoozesQueryOptions` (bramka `revenueKeysReuse`).
+import { useEffect, useId, useMemo, useState, type ReactNode } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+
+import { AreaChip } from "@/components/admin/revenue/atoms/AreaChip";
+import { MfaRequiredNotice } from "@/components/admin/revenue/molecules/MfaRequiredNotice";
+import { Button } from "@/components/ui/button";
+import { FormSelect } from "@/components/atoms/FormSelect";
+import {
+  DEFAULT_DIAGNOSTIC_FILTERS,
+  DIAGNOSTIC_STATE_FILTERS,
+  groupFindingsByArea,
+  isRevenueArea,
+  stateCounts,
+  type DiagnosticStateFilter,
+} from "@/lib/admin/revenue/diagnosticGroups";
+import {
+  REVENUE_AREAS,
+  REVENUE_SEVERITIES,
+  type RevenueArea,
+  type RevenueSeverity,
+} from "@/lib/admin/revenue/hubTabs";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import { ensureI18n as ensureShellI18n } from "@/lib/i18n-admin-revenue-shell";
+import {
+  evaluateFindings,
+  revenueFactsQueryOptions,
+  revenueSnoozesQueryOptions,
+  useUnsnoozeRevenueCheck,
+} from "@/lib/revenue/diagnostics/queries";
+import {
+  isRevenueCheckId,
+  isRevenueFixDialogId,
+  type RevenueFinding,
+} from "@/lib/revenue/diagnostics/registry";
+import type { RevenueView } from "@/lib/revenue/search";
+import { cn } from "@/lib/utils";
+import { DiagnosticCard } from "./DiagnosticCard";
+import { QuickFixDialog } from "./QuickFixDialog";
+import { SnoozeDialog } from "./SnoozeDialog";
+import { SystemMapGrid } from "./SystemMapGrid";
+import { findingDomId } from "./findingText";
+
+export interface DiagnosticsSearch {
+  area?: string;
+  view?: RevenueView;
+  finding?: string;
+  fix?: string;
+}
+
+export interface DiagnosticsBoardProps {
+  tenantId: string | null;
+  roles: readonly string[];
+  search: DiagnosticsSearch;
+  /** Łatka adresu; `undefined` usuwa parametr. */
+  onSearchChange(patch: { [K in keyof DiagnosticsSearch]?: DiagnosticsSearch[K] | undefined }): void;
+}
+
+const AREA_KEY = (area: RevenueArea) => `adminRevenue.area.${area}`;
+const SEVERITY_KEY: Readonly<Record<RevenueSeverity, string>> = {
+  critical: "adminRevenue.severity.critical",
+  warning: "adminRevenue.severity.warning",
+  info: "adminRevenue.severity.info",
+};
+const STATE_KEY: Readonly<Record<DiagnosticStateFilter, string>> = {
+  open: "adminRevenue.diagnostics.state.open",
+  snoozed: "adminRevenue.diagnostics.state.snoozed",
+  ok: "adminRevenue.diagnostics.state.ok",
+  unknown: "adminRevenue.diagnostics.state.unknown",
+  all: "adminRevenue.diagnostics.state.all",
+};
+const ALL = "all";
+
+/** Diagnoza wskazana w `?fix=` - id reguły albo dialogu naprawy (SPEC §2.6). */
+export function findingForFix(
+  findings: readonly RevenueFinding[],
+  fix: string | undefined,
+): RevenueFinding | null {
+  if (!fix) return null;
+  if (isRevenueCheckId(fix)) return findings.find((f) => f.checkId === fix) ?? null;
+  if (isRevenueFixDialogId(fix)) {
+    const matches = findings.filter((f) => f.fix?.kind === "dialog" && f.fix.dialog === fix);
+    return (
+      matches.find((f) => f.state === "warn" || f.state === "error") ?? matches[0] ?? null
+    );
+  }
+  return null;
+}
+
+export function DiagnosticsBoard({ tenantId, roles, search, onSearchChange }: DiagnosticsBoardProps) {
+  ensureShellI18n();
+  ensureI18n();
+  const { t, i18n } = useTranslation();
+  const roleOk = roles.includes("admin") || roles.includes("editor");
+  const isAdmin = roles.includes("admin");
+  const facts = useQuery(revenueFactsQueryOptions(tenantId, { roleOk }));
+  const snoozes = useQuery(revenueSnoozesQueryOptions(tenantId, { roleOk }));
+  const unsnooze = useUnsnoozeRevenueCheck(tenantId);
+  const [severity, setSeverity] = useState<RevenueSeverity | null>(null);
+  const [stateFilter, setStateFilter] = useState<DiagnosticStateFilter>(DEFAULT_DIAGNOSTIC_FILTERS.state);
+  const [snoozing, setSnoozing] = useState<RevenueFinding | null>(null);
+  const headingId = useId();
+  const areaId = useId();
+
+  const ready = facts.data?.state === "ready" ? facts.data : null;
+  const findings = useMemo(() => {
+    if (!ready) return [];
+    const active = snoozes.data?.state === "ready" ? snoozes.data.snoozes : [];
+    return evaluateFindings(ready.facts, active, Date.now());
+  }, [ready, snoozes.data]);
+
+  const area = isRevenueArea(search.area) ? search.area : null;
+  const view: RevenueView = search.view ?? "list";
+  const focusId = isRevenueCheckId(search.finding) ? search.finding : null;
+  const focusFinding = focusId ? findings.find((f) => f.checkId === focusId) ?? null : null;
+  // Fokus z adresu pokazuje diagnozę także wtedy, gdy filtr stanu by ją ukrył.
+  const effectiveState: DiagnosticStateFilter = focusFinding ? "all" : stateFilter;
+  const filters = { area, severity, state: effectiveState };
+  const groups = groupFindingsByArea(findings, filters);
+  const counts = stateCounts(findings);
+  const fixFinding = findingForFix(findings, search.fix);
+  const fixOpen = fixFinding !== null && (fixFinding.state === "warn" || fixFinding.state === "error");
+
+  useEffect(() => {
+    if (!focusId || view !== "list" || !ready) return;
+    const element = document.getElementById(findingDomId(focusId));
+    if (!element) return;
+    element.scrollIntoView?.({ block: "center" });
+    element.focus({ preventScroll: true });
+  }, [focusId, view, ready]);
+
+  if (!roleOk) return null;
+  if (!tenantId) {
+    return <Notice>{t("adminRevenue.diagnostics.noTenant")}</Notice>;
+  }
+  if (facts.data?.state === "mfa_required") return <MfaRequiredNotice />;
+  if (facts.data?.state === "forbidden") return <Notice>{t("adminRevenue.diagnostics.forbidden")}</Notice>;
+  if (facts.data?.state === "unavailable") return <Notice>{t("adminRevenue.diagnostics.unavailable")}</Notice>;
+  if (facts.isError) {
+    return (
+      <Notice>
+        <span>{t("adminRevenue.diagnostics.error")}</span>{" "}
+        <Button type="button" size="sm" variant="outline" className="h-7" onClick={() => void facts.refetch()}>
+          {t("adminRevenue.diagnostics.refresh")}
+        </Button>
+      </Notice>
+    );
+  }
+  if (!ready) {
+    return (
+      <p role="status" className="m-0 text-sm text-muted-foreground">
+        {t("adminRevenue.diagnostics.loading")}
+      </p>
+    );
+  }
+
+  const locale = i18n.language.startsWith("en") ? "en-GB" : "pl-PL";
+  const factsAt = ready.facts.computedAt
+    ? new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" }).format(
+        new Date(ready.facts.computedAt),
+      )
+    : null;
+  const clearFilters = () => {
+    setSeverity(null);
+    setStateFilter("all");
+    onSearchChange({ area: undefined, finding: undefined });
+  };
+
+  return (
+    <div className="space-y-4" data-testid="diagnostics-board">
+      <section aria-labelledby={headingId} className="space-y-3 rounded-[6px] border border-border bg-card p-4">
+        <div className="flex flex-wrap items-start justify-between gap-2">
+          <div className="min-w-0 space-y-0.5">
+            <h2 id={headingId} className="m-0 text-base font-semibold">
+              {t("adminRevenue.diagnostics.title")}
+            </h2>
+            <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.diagnostics.subtitle")}</p>
+          </div>
+          <div className="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
+            {factsAt ? <span>{t("adminRevenue.diagnostics.factsAt", { time: factsAt })}</span> : null}
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              className="h-7"
+              disabled={facts.isFetching}
+              onClick={() => void facts.refetch()}
+            >
+              {t("adminRevenue.diagnostics.refresh")}
+            </Button>
+          </div>
+        </div>
+
+        <p className="m-0 text-sm" aria-live="polite" data-testid="diagnostics-summary">
+          {t("adminRevenue.diagnostics.summary", { count: counts.open })}
+          {counts.unknown > 0 ? (
+            <span className="text-muted-foreground">
+              {" · "}
+              {t("adminRevenue.diagnostics.summaryUnknown", { count: counts.unknown })}
+            </span>
+          ) : null}
+        </p>
+
+        <div className="flex flex-wrap items-center gap-2" role="group" aria-label={t("adminRevenue.diagnostics.viewLabel")}>
+          {(["list", "map"] as const).map((candidate) => (
+            <Button
+              key={candidate}
+              type="button"
+              size="sm"
+              variant={view === candidate ? "default" : "outline"}
+              className="h-7"
+              aria-pressed={view === candidate}
+              onClick={() => onSearchChange({ view: candidate === "list" ? undefined : candidate })}
+            >
+              {t(`adminRevenue.diagnostics.view.${candidate}`)}
+            </Button>
+          ))}
+        </div>
+
+        {view === "list" ? (
+          <div className="flex flex-wrap items-end gap-3" role="group" aria-label={t("adminRevenue.diagnostics.filtersLabel")}>
+            <div className="w-full space-y-1 sm:w-56">
+              <label htmlFor={areaId} className="block text-xs font-medium text-muted-foreground">
+                {t("adminRevenue.diagnostics.areaFilter")}
+              </label>
+              <FormSelect
+                id={areaId}
+                value={area ?? ALL}
+                onValueChange={(next) =>
+                  onSearchChange({ area: next === ALL ? undefined : next, finding: undefined })
+                }
+                options={[
+                  { value: ALL, label: t("adminRevenue.diagnostics.allAreas") },
+                  ...REVENUE_AREAS.map((a) => ({ value: a, label: t(AREA_KEY(a)) })),
+                ]}
+              />
+            </div>
+            <ToggleGroup<RevenueSeverity | null>
+              label={t("adminRevenue.diagnostics.severityFilter")}
+              items={[
+                { value: null, label: t("adminRevenue.diagnostics.allSeverities") },
+                ...REVENUE_SEVERITIES.map((s) => ({ value: s, label: t(SEVERITY_KEY[s]) })),
+              ]}
+              selected={severity}
+              onSelect={setSeverity}
+            />
+            <ToggleGroup<DiagnosticStateFilter>
+              label={t("adminRevenue.diagnostics.stateFilter")}
+              items={DIAGNOSTIC_STATE_FILTERS.map((s) => ({
+                value: s,
+                label: `${t(STATE_KEY[s])} (${counts[s]})`,
+              }))}
+              selected={stateFilter}
+              onSelect={setStateFilter}
+            />
+          </div>
+        ) : null}
+      </section>
+
+      {search.fix && fixFinding && !fixOpen ? (
+        <Notice testId="diagnostics-fix-gone">
+          {fixFinding.state === "unknown"
+            ? t("adminRevenue.diagnostics.fixUnknown")
+            : t("adminRevenue.diagnostics.fixGone")}
+        </Notice>
+      ) : null}
+      {focusId && !focusFinding ? <Notice>{t("adminRevenue.diagnostics.focusMissing")}</Notice> : null}
+
+      {view === "map" ? (
+        <SystemMapGrid />
+      ) : groups.length === 0 ? (
+        <Notice testId="diagnostics-empty">
+          <span>
+            {stateFilter === "open" && area === null && severity === null
+              ? t("adminRevenue.diagnostics.empty.open")
+              : t("adminRevenue.diagnostics.empty.filtered")}
+          </span>{" "}
+          {stateFilter !== "open" || area !== null || severity !== null ? (
+            <Button type="button" size="sm" variant="outline" className="h-7" onClick={clearFilters}>
+              {t("adminRevenue.diagnostics.empty.clear")}
+            </Button>
+          ) : null}
+        </Notice>
+      ) : (
+        groups.map((group) => (
+          <FindingGroupSection key={group.area} area={group.area} score={group.health.score}>
+            {group.findings.map((finding) => (
+              <li key={finding.checkId}>
+                <DiagnosticCard
+                  finding={finding}
+                  variant="full"
+                  canSnooze={isAdmin}
+                  focused={finding.checkId === focusId}
+                  factsAt={ready.facts.computedAt}
+                  onFix={() => onSearchChange({ fix: finding.checkId })}
+                  onSnooze={() => setSnoozing(finding)}
+                  onUnsnooze={() =>
+                    unsnooze.mutate(
+                      { checkId: finding.checkId },
+                      { onSuccess: () => toast.success(t("adminRevenue.snooze.removed")) },
+                    )
+                  }
+                />
+              </li>
+            ))}
+          </FindingGroupSection>
+        ))
+      )}
+
+      {fixFinding && fixOpen ? (
+        <QuickFixDialog
+          finding={fixFinding}
+          facts={ready.facts}
+          tenantId={tenantId}
+          roles={roles}
+          open
+          onOpenChange={(open) => {
+            if (!open) onSearchChange({ fix: undefined });
+          }}
+        />
+      ) : null}
+      {snoozing ? (
+        <SnoozeDialog
+          finding={snoozing}
+          tenantId={tenantId}
+          open
+          onOpenChange={(open) => {
+            if (!open) setSnoozing(null);
+          }}
+        />
+      ) : null}
+    </div>
+  );
+}
+
+function Notice({ children, testId }: { children: ReactNode; testId?: string }) {
+  return (
+    <div
+      role="status"
+      data-testid={testId}
+      className="rounded-[6px] border border-border bg-muted/30 p-3 text-sm text-muted-foreground"
+    >
+      {children}
+    </div>
+  );
+}
+
+function ToggleGroup<T extends string | null>({
+  label,
+  items,
+  selected,
+  onSelect,
+}: {
+  label: string;
+  items: readonly { value: T; label: string }[];
+  selected: T;
+  onSelect(value: T): void;
+}) {
+  return (
+    <div className="space-y-1">
+      <span className="block text-xs font-medium text-muted-foreground" aria-hidden="true">
+        {label}
+      </span>
+      <div role="group" aria-label={label} className="flex flex-wrap gap-1">
+        {items.map((item) => (
+          <Button
+            key={item.value ?? ALL}
+            type="button"
+            size="sm"
+            variant={item.value === selected ? "default" : "outline"}
+            className="h-7"
+            aria-pressed={item.value === selected}
+            onClick={() => onSelect(item.value)}
+          >
+            {item.label}
+          </Button>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+function FindingGroupSection({
+  area,
+  score,
+  children,
+}: {
+  area: RevenueArea;
+  score: number | null;
+  children: ReactNode;
+}) {
+  const { t } = useTranslation();
+  const headingId = useId();
+  const areaLabel = t(AREA_KEY(area));
+  return (
+    <section aria-labelledby={headingId} data-area={area} className="space-y-2">
+      <h2 id={headingId} className={cn("m-0 flex flex-wrap items-center gap-2 text-sm font-semibold")}>
+        <AreaChip area={area} />
+        <span>
+          {score === null
+            ? t("adminRevenue.diagnostics.groupHeadingNoData", { area: areaLabel })
+            : t("adminRevenue.diagnostics.groupHeading", { area: areaLabel, score })}
+        </span>
+      </h2>
+      <ul className="m-0 list-none space-y-2 p-0">{children}</ul>
+    </section>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/QuickFixDialog.tsx b/src/components/admin/revenue/diagnostics/QuickFixDialog.tsx
new file mode 100644
index 000000000..3c4a5d702
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/QuickFixDialog.tsx
@@ -0,0 +1,376 @@
+// Organizm: szkielet SZYBKIEJ NAPRAWY diagnozy (SPEC §6.4) - jeden dialog
+// dla piętnastu napraw; treść z rejestru `lib/admin/revenue/quickFixes.ts`.
+//
+// PRZEPŁYW: wybór rozwiązania → podgląd „Przed → Po" (+ `SourceHeader`: ta
+// sama zmiana pojawi się w module) → zapis WSPÓŁDZIELONYM mutatorem modułu →
+// `refetchQueries(revenueKeys.facts(t))` → ponowna ocena TEJ reguły na
+// świeżych faktach → komunikat w regionie `aria-live`: „✓ problem zniknął"
+// albo „! zapisano, ale problem nadal występuje: <dowody>". Zmiana
+// odwracalna dostaje „Cofnij" na 60 sekund. Konflikt (`40001` - wiersz
+// zapisany w innej karcie) zamienia podgląd w porównanie „Twoja zmiana / stan
+// teraz" z przyciskiem „Wczytaj aktualne". Rola bez prawa zapisu w module →
+// „Zastosuj" wyłączone z powodem (`DisabledReason`).
+//
+// HAK APLIKATORA W PODKOMPONENCIE. `spec.apply.useApplier()` woła hooki
+// mutatorów modułu; renderujemy go dopiero w treści OTWARTEGO dialogu
+// (`FixPanel`), a klucz po identyfikatorze dialogu gwarantuje stałą kolejność
+// hooków. Zamknięty dialog nie trzyma subskrypcji modułów.
+import { Suspense, useEffect, useId, useMemo, useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { CheckCircle2, AlertTriangle, Info } from "lucide-react";
+import { useTranslation } from "react-i18next";
+
+import { DisabledReason } from "@/components/admin/pricing/atoms/DisabledReason";
+import { SourceHeader } from "@/components/admin/revenue/molecules/SourceHeader";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import {
+  canApplyQuickFix,
+  quickFixFor,
+  type FieldDiff,
+  type QuickFixApplied,
+  type QuickFixOption,
+  type QuickFixSpec,
+  type QuickFixValue,
+} from "@/lib/admin/revenue/quickFixes";
+import { isStaleWriteError } from "@/lib/billing/planQueries";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import type { RevenueFactsRead } from "@/lib/revenue/diagnostics/diagnostics.functions";
+import type { RevenueFacts } from "@/lib/revenue/diagnostics/facts";
+import {
+  revenueCheck,
+  runCheck,
+  type RevenueFinding,
+  type RevenueFixDialogId,
+} from "@/lib/revenue/diagnostics/registry";
+import { revenueKeys } from "@/lib/revenue/keys";
+import { checkTitle, evidenceSentence } from "./findingText";
+
+/** Okno „Cofnij" po zapisie odwracalnym (SPEC §6.4). */
+export const UNDO_WINDOW_MS = 60_000;
+
+type Phase =
+  | { kind: "idle" }
+  | { kind: "applying" }
+  | { kind: "checking" }
+  | { kind: "done"; outcome: "resolved" | "open" | "unknown"; evidence: string }
+  | { kind: "undone" }
+  | { kind: "conflict" }
+  | { kind: "failed" };
+
+export interface QuickFixDialogProps {
+  finding: RevenueFinding;
+  facts: RevenueFacts;
+  tenantId: string | null;
+  roles: readonly string[];
+  open: boolean;
+  onOpenChange(open: boolean): void;
+}
+
+export function QuickFixDialog(props: QuickFixDialogProps) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const { finding, open, onOpenChange } = props;
+  const dialogId = finding.fix?.kind === "dialog" ? finding.fix.dialog : null;
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-w-2xl" data-testid="quick-fix-dialog">
+        {dialogId ? (
+          <FixPanel key={dialogId} {...props} dialogId={dialogId} />
+        ) : (
+          <DialogHeader>
+            <DialogTitle>{checkTitle(t, finding.checkId)}</DialogTitle>
+            <DialogDescription>{t("adminRevenue.diagnostics.fixNoDialog")}</DialogDescription>
+          </DialogHeader>
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+function valueText(t: (key: string, params?: Record<string, unknown>) => string, value: QuickFixValue) {
+  return "text" in value ? value.text : t(value.key, value.params);
+}
+
+function FixPanel({
+  finding,
+  facts,
+  tenantId,
+  roles,
+  onOpenChange,
+  dialogId,
+}: QuickFixDialogProps & { dialogId: RevenueFixDialogId }) {
+  const { t } = useTranslation();
+  const qc = useQueryClient();
+  const spec: QuickFixSpec<unknown> = useMemo(() => quickFixFor(dialogId), [dialogId]);
+  const applier = spec.apply.useApplier();
+  const [currentFacts, setCurrentFacts] = useState(facts);
+  const options = useMemo(() => spec.options(currentFacts, finding), [spec, currentFacts, finding]);
+  const [optionId, setOptionId] = useState<string | null>(options[0]?.id ?? null);
+  const option: QuickFixOption<unknown> | undefined = options.find((o) => o.id === optionId);
+  const [value, setValue] = useState<unknown>(option?.payload);
+  const [phase, setPhase] = useState<Phase>({ kind: "idle" });
+  const [undo, setUndo] = useState<{ revert: () => Promise<void>; deadline: number } | null>(null);
+  const [now, setNow] = useState(() => Date.now());
+  const optionsName = useId();
+
+  // Odliczanie „Cofnij" - po minucie przycisk znika (zmiana zostaje).
+  useEffect(() => {
+    if (!undo) return;
+    const timer = window.setInterval(() => {
+      const tick = Date.now();
+      setNow(tick);
+      if (tick >= undo.deadline) setUndo(null);
+    }, 1000);
+    return () => window.clearInterval(timer);
+  }, [undo]);
+
+  const canApply = canApplyQuickFix(spec.requiredRole, roles);
+  const busy = phase.kind === "applying" || phase.kind === "checking";
+  const complete = option !== undefined && (spec.valid ? spec.valid(value) : true);
+  const roleReason = canApply
+    ? null
+    : t(spec.requiredRole === "admin" ? "adminRevenue.fix.roleAdmin" : "adminRevenue.fix.roleEditor");
+  const diffs: FieldDiff[] = option ? spec.diff(option, currentFacts, value) : [];
+  const Body = spec.body;
+
+  /** Świeże fakty z serwera i ponowna ocena reguły, którą naprawiamy. */
+  const recheck = async (): Promise<Phase> => {
+    if (!tenantId) return { kind: "done", outcome: "unknown", evidence: "" };
+    await qc.refetchQueries({ queryKey: revenueKeys.facts(tenantId), exact: true });
+    const read = qc.getQueryData<RevenueFactsRead>(revenueKeys.facts(tenantId));
+    const check = revenueCheck(finding.checkId);
+    if (read?.state !== "ready" || !check) return { kind: "done", outcome: "unknown", evidence: "" };
+    setCurrentFacts(read.facts);
+    const result = runCheck(check, read.facts);
+    if (result.state === "ok") return { kind: "done", outcome: "resolved", evidence: "" };
+    if (result.state === "unknown") return { kind: "done", outcome: "unknown", evidence: "" };
+    return {
+      kind: "done",
+      outcome: "open",
+      evidence: evidenceSentence(t, { evidence: result.evidence ?? [] }),
+    };
+  };
+
+  const apply = async () => {
+    if (!option || !complete || !canApply || busy) return;
+    setPhase({ kind: "applying" });
+    let applied: QuickFixApplied;
+    try {
+      applied = await applier.apply(value);
+    } catch (error) {
+      setPhase(isStaleWriteError(error) ? { kind: "conflict" } : { kind: "failed" });
+      return;
+    }
+    if (spec.reversible && applied.revert) {
+      setUndo({ revert: applied.revert, deadline: Date.now() + UNDO_WINDOW_MS });
+      setNow(Date.now());
+    }
+    setPhase({ kind: "checking" });
+    setPhase(await recheck());
+  };
+
+  const revert = async () => {
+    if (!undo) return;
+    const { revert: run } = undo;
+    setUndo(null);
+    setPhase({ kind: "applying" });
+    try {
+      await run();
+      await recheck();
+      setPhase({ kind: "undone" });
+    } catch {
+      setPhase({ kind: "failed" });
+    }
+  };
+
+  const reload = async () => {
+    setPhase({ kind: "checking" });
+    await recheck();
+    setPhase({ kind: "idle" });
+  };
+
+  const message = (() => {
+    switch (phase.kind) {
+      case "applying":
+        return t("adminRevenue.fix.applying");
+      case "checking":
+        return t("adminRevenue.fix.checking");
+      case "done":
+        if (phase.outcome === "resolved") return t("adminRevenue.fix.resolved");
+        if (phase.outcome === "unknown") return t("adminRevenue.fix.stillUnknown");
+        return t("adminRevenue.fix.stillOpen", { evidence: phase.evidence });
+      case "undone":
+        return t("adminRevenue.fix.undone");
+      case "failed":
+        return t("adminRevenue.fix.failed");
+      default:
+        return "";
+    }
+  })();
+  const done = phase.kind === "done" || phase.kind === "undone";
+
+  return (
+    <>
+      <DialogHeader>
+        <DialogTitle>
+          {t("adminRevenue.fix.dialogTitle", { title: checkTitle(t, finding.checkId) })}
+        </DialogTitle>
+        <DialogDescription>{t(`adminRevenue.fix.${spec.id}.description`)}</DialogDescription>
+      </DialogHeader>
+
+      <div className="max-h-[65vh] space-y-4 overflow-y-auto pr-1">
+        {options.length === 0 ? (
+          <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.fix.noOptions")}</p>
+        ) : (
+          <fieldset className="space-y-2" disabled={busy || done}>
+            <legend className="mb-1 text-sm font-medium">{t("adminRevenue.fix.optionsLabel")}</legend>
+            {options.map((candidate) => (
+              <label
+                key={candidate.id}
+                className="flex min-h-6 cursor-pointer items-start gap-2 rounded-[6px] border border-border p-2 text-sm has-[:checked]:border-primary"
+              >
+                <input
+                  type="radio"
+                  name={optionsName}
+                  className="mt-0.5 h-4 w-4"
+                  checked={candidate.id === optionId}
+                  onChange={() => {
+                    setOptionId(candidate.id);
+                    setValue(candidate.payload);
+                  }}
+                />
+                <span>{t(candidate.labelKey, candidate.labelParams)}</span>
+              </label>
+            ))}
+          </fieldset>
+        )}
+
+        {Body && option ? (
+          <Suspense fallback={null}>
+            <Body
+              facts={currentFacts}
+              finding={finding}
+              option={option}
+              value={value}
+              onChange={setValue}
+              disabled={busy || done || !canApply}
+            />
+          </Suspense>
+        ) : null}
+
+        {phase.kind === "conflict" ? (
+          <section
+            role="alert"
+            className="space-y-2 rounded-[6px] border border-destructive/40 bg-destructive/5 p-3 text-sm"
+          >
+            <h3 className="m-0 flex items-center gap-2 text-sm font-semibold">
+              <AlertTriangle className="h-4 w-4 shrink-0" aria-hidden="true" />
+              {t("adminRevenue.fix.conflictTitle")}
+            </h3>
+            <p className="m-0">{t("adminRevenue.fix.conflictBody")}</p>
+            <Button type="button" size="sm" variant="outline" className="h-7" onClick={() => void reload()}>
+              {t("adminRevenue.fix.conflictReload")}
+            </Button>
+          </section>
+        ) : null}
+
+        {diffs.length > 0 ? (
+          <div className="space-y-2">
+            <h3 className="m-0 text-sm font-semibold">{t("adminRevenue.fix.previewTitle")}</h3>
+            <div role="region" aria-label={t("adminRevenue.fix.previewCaption")} tabIndex={0} className="overflow-x-auto">
+              <table className="w-full border-collapse text-sm">
+                <caption className="sr-only">{t("adminRevenue.fix.previewCaption")}</caption>
+                <thead>
+                  <tr className="border-b border-border text-left text-xs text-muted-foreground">
+                    <th scope="col" className="py-1 pr-3 font-medium">
+                      {t("adminRevenue.fix.field.heading")}
+                    </th>
+                    <th scope="col" className="py-1 pr-3 font-medium">
+                      {t("adminRevenue.fix.field.before")}
+                    </th>
+                    <th scope="col" className="py-1 font-medium">
+                      {t("adminRevenue.fix.field.after")}
+                    </th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {diffs.map((row) => (
+                    <tr key={row.field} className="border-b border-border last:border-0">
+                      <th scope="row" className="py-1 pr-3 text-left font-normal">
+                        {t(row.labelKey)}
+                      </th>
+                      <td className="py-1 pr-3 text-muted-foreground line-through decoration-muted-foreground/60">
+                        {valueText(t, row.before)}
+                      </td>
+                      <td className="py-1 font-medium">{valueText(t, row.after)}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+            <SourceHeader entity={spec.apply.entity} columns={spec.apply.columns} />
+            <p className="m-0 text-xs text-muted-foreground">{t("adminRevenue.fix.sourceNote")}</p>
+          </div>
+        ) : null}
+
+        <div
+          role="status"
+          aria-live="polite"
+          data-testid="quick-fix-status"
+          data-phase={phase.kind}
+          data-outcome={phase.kind === "done" ? phase.outcome : undefined}
+          className="min-h-5 text-sm"
+        >
+          {message ? (
+            <p className="m-0 flex items-start gap-2">
+              {phase.kind === "done" && phase.outcome === "resolved" ? (
+                <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-brand-ink dark:text-brand" aria-hidden="true" />
+              ) : phase.kind === "done" && phase.outcome === "open" ? (
+                <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0 text-destructive" aria-hidden="true" />
+              ) : (
+                <Info className="mt-0.5 h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" />
+              )}
+              <span>{message}</span>
+            </p>
+          ) : null}
+        </div>
+      </div>
+
+      <DialogFooter className="flex-wrap gap-2">
+        {undo ? (
+          <Button type="button" variant="outline" className="h-8" onClick={() => void revert()}>
+            {t("adminRevenue.fix.undo", {
+              seconds: Math.max(0, Math.ceil((undo.deadline - now) / 1000)),
+            })}
+          </Button>
+        ) : null}
+        <Button type="button" variant="ghost" className="h-8" onClick={() => onOpenChange(false)}>
+          {t(done ? "adminRevenue.fix.close" : "adminRevenue.fix.cancel")}
+        </Button>
+        {done ? null : (
+          <DisabledReason
+            reason={roleReason ?? (complete || options.length === 0 ? null : t("adminRevenue.fix.incomplete"))}
+          >
+            <Button
+              type="button"
+              className="h-8"
+              disabled={!canApply || !complete || busy || phase.kind === "conflict"}
+              onClick={() => void apply()}
+            >
+              {busy ? t("adminRevenue.fix.applying") : t("adminRevenue.fix.apply")}
+            </Button>
+          </DisabledReason>
+        )}
+      </DialogFooter>
+    </>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/SnoozeDialog.tsx b/src/components/admin/revenue/diagnostics/SnoozeDialog.tsx
new file mode 100644
index 000000000..3e81380ce
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/SnoozeDialog.tsx
@@ -0,0 +1,188 @@
+// Molekuła: wyciszenie diagnozy (SPEC §4.5, §2.5 - tylko administrator).
+//
+// Dwa rodzaje = dwa CHECK-i tabeli: „na określony czas" (termin do 180 dni)
+// albo „świadomie - tak ma być" (bez terminu, z powodem i odciskiem faktów:
+// zmiana liczby albo listy obiektów przywraca diagnozę). Powód za długi jest
+// ODRZUCANY komunikatem i blokuje zapis - nigdy przycinany (AGENTS: limit
+// widoczny = limit zapisany, `REVENUE_LIMITS.snoozeReason*`).
+//
+// Termin liczymy od LOKALNEGO teraz w przeglądarce i odejmujemy minutę:
+// zegar klienta wyprzedzający bazę o sekundy nie może zamienić „180 dni"
+// w odmowę `until_too_far`.
+import { useId, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { toast } from "sonner";
+
+import { FormSelect } from "@/components/atoms/FormSelect";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { Label } from "@/components/ui/label";
+import { Textarea } from "@/components/ui/textarea";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import { useSnoozeRevenueCheck } from "@/lib/revenue/diagnostics/queries";
+import type { RevenueFinding } from "@/lib/revenue/diagnostics/registry";
+import { REVENUE_LIMITS, type SnoozeKind } from "@/lib/revenue/limits";
+import { checkTitle } from "./findingText";
+
+/** Gotowe terminy (dni) - wybór admina, nie benchmark; maksimum = CHECK tabeli. */
+export const SNOOZE_DAY_CHOICES = [7, 30, 90, REVENUE_LIMITS.snoozeMaxDays] as const;
+
+const DAY_MS = 86_400_000;
+const CLOCK_MARGIN_MS = 60_000;
+
+export interface SnoozeDialogProps {
+  finding: RevenueFinding;
+  tenantId: string | null;
+  open: boolean;
+  initialKind?: SnoozeKind;
+  onOpenChange(open: boolean): void;
+}
+
+export function SnoozeDialog({ finding, tenantId, open, initialKind = "days", onOpenChange }: SnoozeDialogProps) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const snooze = useSnoozeRevenueCheck(tenantId);
+  const [kind, setKind] = useState<SnoozeKind>(initialKind);
+  const [days, setDays] = useState<number>(SNOOZE_DAY_CHOICES[1]);
+  const [reason, setReason] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const kindName = useId();
+  const daysId = useId();
+  const reasonId = useId();
+  const hintId = useId();
+  const errorId = useId();
+
+  const trimmed = reason.trim().length;
+  const tooLong = trimmed > REVENUE_LIMITS.snoozeReasonMax;
+  const tooShort = trimmed > 0 && trimmed < REVENUE_LIMITS.snoozeReasonMin;
+  const reasonRequired = kind === "intentional";
+  const reasonOk = reasonRequired
+    ? trimmed >= REVENUE_LIMITS.snoozeReasonMin && !tooLong
+    : trimmed === 0 || (!tooShort && !tooLong);
+  const reasonError = tooLong
+    ? t("adminRevenue.snooze.reasonTooLong", { max: REVENUE_LIMITS.snoozeReasonMax })
+    : tooShort
+      ? t("adminRevenue.snooze.reasonTooShort", { min: REVENUE_LIMITS.snoozeReasonMin })
+      : null;
+
+  const submit = async () => {
+    if (!reasonOk || snooze.isPending) return;
+    setError(null);
+    try {
+      const result = await snooze.mutateAsync({
+        checkId: finding.checkId,
+        scopeKey: "*",
+        kind,
+        until: kind === "days" ? new Date(Date.now() + days * DAY_MS - CLOCK_MARGIN_MS).toISOString() : null,
+        reason: trimmed === 0 ? null : reason,
+        scopeHash: kind === "intentional" ? finding.factHash : null,
+      });
+      if (result.state === "ok") {
+        toast.success(t("adminRevenue.snooze.saved"));
+        onOpenChange(false);
+        return;
+      }
+      if (result.state === "invalid") setError(t(`adminRevenue.snooze.invalid.${result.code}`));
+      else if (result.state === "unavailable") setError(t("adminRevenue.snooze.unavailable"));
+      else setError(t("adminRevenue.snooze.forbidden"));
+    } catch {
+      setError(t("adminRevenue.fix.failed"));
+    }
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-w-lg" data-testid="snooze-dialog">
+        <DialogHeader>
+          <DialogTitle>{t("adminRevenue.snooze.title")}</DialogTitle>
+          <DialogDescription>{checkTitle(t, finding.checkId)}</DialogDescription>
+        </DialogHeader>
+        <div className="space-y-4">
+          <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.snooze.description")}</p>
+          <fieldset className="space-y-2">
+            <legend className="sr-only">{t("adminRevenue.snooze.title")}</legend>
+            {(["days", "intentional"] as const).map((candidate) => (
+              <label key={candidate} className="flex min-h-6 items-center gap-2 text-sm">
+                <input
+                  type="radio"
+                  name={kindName}
+                  className="h-4 w-4"
+                  checked={kind === candidate}
+                  onChange={() => setKind(candidate)}
+                />
+                {t(`adminRevenue.snooze.kind.${candidate}`)}
+              </label>
+            ))}
+          </fieldset>
+          {kind === "days" ? (
+            <div className="space-y-1">
+              <Label htmlFor={daysId}>{t("adminRevenue.snooze.daysLabel")}</Label>
+              <FormSelect
+                id={daysId}
+                value={String(days)}
+                onValueChange={(next) => setDays(Number(next))}
+                options={SNOOZE_DAY_CHOICES.map((n) => ({
+                  value: String(n),
+                  label: t("adminRevenue.snooze.days", { count: n }),
+                }))}
+              />
+            </div>
+          ) : (
+            <p className="m-0 text-xs text-muted-foreground">{t("adminRevenue.snooze.intentionalHint")}</p>
+          )}
+          <div className="space-y-1">
+            <Label htmlFor={reasonId}>{t("adminRevenue.snooze.reason")}</Label>
+            <Textarea
+              id={reasonId}
+              value={reason}
+              onChange={(e) => setReason(e.target.value)}
+              rows={3}
+              required={reasonRequired}
+              aria-invalid={reasonError !== null || undefined}
+              aria-describedby={reasonError ? `${hintId} ${errorId}` : hintId}
+            />
+            <div className="flex flex-wrap justify-between gap-2 text-xs text-muted-foreground">
+              <span id={hintId}>
+                {t("adminRevenue.snooze.reasonHint", {
+                  min: REVENUE_LIMITS.snoozeReasonMin,
+                  max: REVENUE_LIMITS.snoozeReasonMax,
+                })}
+              </span>
+              <span aria-hidden="true" className={tooLong ? "text-destructive" : undefined}>
+                {t("adminRevenue.snooze.reasonCount", {
+                  value: trimmed,
+                  max: REVENUE_LIMITS.snoozeReasonMax,
+                })}
+              </span>
+            </div>
+            {reasonError ? (
+              <p id={errorId} className="m-0 text-xs text-destructive">
+                {reasonError}
+              </p>
+            ) : null}
+          </div>
+          {error ? (
+            <p role="alert" className="m-0 text-sm text-destructive">
+              {error}
+            </p>
+          ) : null}
+        </div>
+        <DialogFooter className="gap-2">
+          <Button type="button" variant="ghost" className="h-8" onClick={() => onOpenChange(false)}>
+            {t("adminRevenue.snooze.cancel")}
+          </Button>
+          <Button type="button" className="h-8" disabled={!reasonOk || snooze.isPending} onClick={() => void submit()}>
+            {t("adminRevenue.snooze.confirm")}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/SystemMapGrid.tsx b/src/components/admin/revenue/diagnostics/SystemMapGrid.tsx
new file mode 100644
index 000000000..d76c30c6f
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/SystemMapGrid.tsx
@@ -0,0 +1,171 @@
+// Organizm: „Mapa systemu" Diagnostyki (SPEC §2.2 `?view=map`, §3.2).
+//
+// Tabela z `HUB_SYNC_MANIFEST` - tego samego manifestu, z którego naprawy
+// biorą nagłówek źródła, a test manifestu sprawdza trasy, tabele, zdarzenia
+// i klucze. Wiersz = byt huba: kto go pisze (mutator, funkcja serwera,
+// webhook, RPC, wyzwalacz), jakie zdarzenia wysyła i które zakładki huba
+// odświeża. Admin, który widzi diagnozę „emiter ucichł", sprawdza tu, CO
+// powinno było to zdarzenie wysłać i KTO na nie czeka.
+//
+// DOSTĘPNOŚĆ: prawdziwa tabela (`caption`, `scope`), a szeroka treść
+// w przewijalnym regionie z nazwą i `tabIndex=0` (WCAG 2.1.1 - przewijanie
+// z klawiatury), zamiast poziomego paska całej strony.
+import { useId } from "react";
+import { useTranslation } from "react-i18next";
+
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import { ensureI18n as ensureShellI18n } from "@/lib/i18n-admin-revenue-shell";
+import { ensureI18n as ensureRevenueI18n } from "@/lib/i18n-admin-revenue";
+import type { RevenueTabId } from "@/lib/revenue/search";
+import {
+  HUB_SYNC_MANIFEST,
+  type HubEntity,
+  type HubEntityId,
+  type HubWriterKind,
+} from "@/lib/revenue/syncManifest";
+
+const WRITER_KIND_KEY: Readonly<Record<HubWriterKind, string>> = {
+  mutator: "adminRevenue.diagnostics.map.writerKind.mutator",
+  server_fn: "adminRevenue.diagnostics.map.writerKind.server_fn",
+  webhook: "adminRevenue.diagnostics.map.writerKind.webhook",
+  rpc: "adminRevenue.diagnostics.map.writerKind.rpc",
+  trigger: "adminRevenue.diagnostics.map.writerKind.trigger",
+};
+
+/** Etykiety zakładek - klucze rdzenia I0. */
+const TAB_LABEL_KEY: Readonly<Record<RevenueTabId, string>> = {
+  overview: "adminRevenue.tab.overview",
+  mrr: "adminRevenue.tab.mrr",
+  funnel: "adminRevenue.tab.funnel",
+  retention: "adminRevenue.tab.retention",
+  community: "adminRevenue.tab.community",
+  diagnostics: "adminRevenue.tab.diagnostics",
+  offer: "adminRevenue.tab.offer",
+  access: "adminRevenue.tab.access",
+  journeys: "adminRevenue.tab.journeys",
+  metrics: "adminRevenue.tab.metrics",
+  inputs: "adminRevenue.tab.inputs",
+};
+
+/** Etykieta bytu - klucze nagłówka źródła S6 (`adminRevenue.source.entity.*`). */
+function entityKey(id: HubEntityId): string {
+  return `adminRevenue.source.entity.${id}`;
+}
+
+/** `ścieżka#eksport` → sam eksport; funkcja SQL → nazwa; plik → nazwa pliku. */
+export function writerLabel(ref: string): string {
+  const hash = ref.indexOf("#");
+  if (hash >= 0) return ref.slice(hash + 1);
+  const slash = ref.lastIndexOf("/");
+  return slash >= 0 ? ref.slice(slash + 1) : ref;
+}
+
+function ownerText(entity: HubEntity): string[] {
+  return entity.owners.map((owner) => {
+    const path = owner.params
+      ? owner.to.replace(/\$([A-Za-z_]\w*)/g, (_m, name: string) => owner.params?.[name] ?? `$${name}`)
+      : owner.to;
+    return owner.search?.tab ? `${path}?tab=${owner.search.tab}` : path;
+  });
+}
+
+export interface SystemMapGridProps {
+  entities?: readonly HubEntity[];
+}
+
+export function SystemMapGrid({ entities = HUB_SYNC_MANIFEST }: SystemMapGridProps) {
+  ensureRevenueI18n();
+  ensureShellI18n();
+  ensureI18n();
+  const { t } = useTranslation();
+  const headingId = useId();
+  const none = t("adminRevenue.diagnostics.map.none");
+
+  return (
+    <section aria-labelledby={headingId} className="space-y-3 rounded-[6px] border border-border bg-card p-4">
+      <div className="space-y-0.5">
+        <h2 id={headingId} className="m-0 text-base font-semibold">
+          {t("adminRevenue.diagnostics.map.title")}
+        </h2>
+        <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.diagnostics.map.description")}</p>
+      </div>
+      <div
+        role="region"
+        aria-label={t("adminRevenue.diagnostics.map.scrollRegion")}
+        tabIndex={0}
+        className="overflow-x-auto rounded-[6px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+      >
+        <table className="w-full min-w-[48rem] border-collapse text-sm" data-testid="system-map">
+          <caption className="sr-only">{t("adminRevenue.diagnostics.map.caption")}</caption>
+          <thead>
+            <tr className="border-b border-border text-left text-xs text-muted-foreground">
+              <th scope="col" className="py-2 pr-3 font-medium">
+                {t("adminRevenue.diagnostics.map.entity")}
+              </th>
+              <th scope="col" className="py-2 pr-3 font-medium">
+                {t("adminRevenue.diagnostics.map.writers")}
+              </th>
+              <th scope="col" className="py-2 pr-3 font-medium">
+                {t("adminRevenue.diagnostics.map.events")}
+              </th>
+              <th scope="col" className="py-2 pr-3 font-medium">
+                {t("adminRevenue.diagnostics.map.tabs")}
+              </th>
+              <th scope="col" className="py-2 font-medium">
+                {t("adminRevenue.diagnostics.map.owner")}
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {entities.map((entity) => (
+              <tr key={entity.id} data-entity={entity.id} className="border-b border-border align-top last:border-0">
+                <th scope="row" className="py-2 pr-3 text-left font-medium">
+                  {t(entityKey(entity.id))}
+                </th>
+                <td className="py-2 pr-3">
+                  <ul className="m-0 list-none space-y-0.5 p-0">
+                    {entity.writers.map((writer) => (
+                      <li key={`${writer.kind}:${writer.ref}`}>
+                        <code className="text-xs">{writerLabel(writer.ref)}</code>{" "}
+                        <span className="text-xs text-muted-foreground">({t(WRITER_KIND_KEY[writer.kind])})</span>
+                      </li>
+                    ))}
+                  </ul>
+                </td>
+                <td className="py-2 pr-3">
+                  {entity.events.length === 0 ? (
+                    none
+                  ) : (
+                    <ul className="m-0 list-none space-y-0.5 p-0">
+                      {entity.events.map((event) => (
+                        <li key={event}>
+                          <code className="text-xs">{event}</code>
+                        </li>
+                      ))}
+                    </ul>
+                  )}
+                </td>
+                <td className="py-2 pr-3">
+                  {entity.hubTabs.length === 0 ? none : entity.hubTabs.map((tab) => t(TAB_LABEL_KEY[tab])).join(", ")}
+                </td>
+                <td className="py-2">
+                  {entity.owners.length === 0 ? (
+                    <span className="text-muted-foreground">{t("adminRevenue.diagnostics.map.systemOnly")}</span>
+                  ) : (
+                    <ul className="m-0 list-none space-y-0.5 p-0">
+                      {ownerText(entity).map((path) => (
+                        <li key={path}>
+                          <code className="text-xs">{path}</code>
+                        </li>
+                      ))}
+                    </ul>
+                  )}
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/findingText.ts b/src/components/admin/revenue/diagnostics/findingText.ts
new file mode 100644
index 000000000..c47701383
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/findingText.ts
@@ -0,0 +1,62 @@
+// Napisy diagnozy - jedno miejsce budowania kluczy słownika diagnostyki.
+//
+// Klucze reguł i dowodów składamy z identyfikatorów, bo rejestr ma 55 reguł
+// i kilkadziesiąt rodzajów dowodów - jawna mapa byłaby drugą kopią
+// `REVENUE_CHECK_IDS`. Bramka `i18nKeyDrift` sprawdza takie gałęzie
+// dynamiczne (`adminRevenue.checks.*`, `adminRevenue.evidence.*`): obie
+// istnieją i mają w PL i EN ten sam zbiór podkluczy, a test słownika
+// (`i18n.test.ts`) pilnuje, że KAŻDY identyfikator ma swój napis.
+import type { TFunction } from "i18next";
+
+import type { RevenueEvidence } from "@/lib/revenue/diagnostics/facts";
+import type { RevenueCheckId, RevenueFinding } from "@/lib/revenue/diagnostics/registry";
+
+export function checkTitle(t: TFunction, id: RevenueCheckId): string {
+  return t(`adminRevenue.checks.${id}.title`);
+}
+
+export function checkDescription(t: TFunction, id: RevenueCheckId): string {
+  return t(`adminRevenue.checks.${id}.description`);
+}
+
+export function evidenceText(t: TFunction, evidence: RevenueEvidence): string {
+  return t(`adminRevenue.evidence.${evidence.key}`, evidence.params);
+}
+
+/** Dowody diagnozy jednym zdaniem (komunikat po naprawie, opis zgłoszenia). */
+export function evidenceSentence(t: TFunction, finding: Pick<RevenueFinding, "evidence">): string {
+  return finding.evidence.map((e) => evidenceText(t, e)).join("; ");
+}
+
+/** Stan karty: wyciszenie ma pierwszeństwo przed stanem reguły. */
+export type FindingBadge = "error" | "warn" | "unknown" | "ok" | "snoozed";
+
+export function badgeOf(finding: Pick<RevenueFinding, "state" | "snooze">): FindingBadge {
+  if (finding.snooze !== null && (finding.state === "warn" || finding.state === "error")) {
+    return "snoozed";
+  }
+  return finding.state;
+}
+
+export const BADGE_KEY: Readonly<Record<FindingBadge, string>> = {
+  error: "adminRevenue.diagnostics.stateBadge.error",
+  warn: "adminRevenue.diagnostics.stateBadge.warn",
+  unknown: "adminRevenue.diagnostics.stateBadge.unknown",
+  ok: "adminRevenue.diagnostics.stateBadge.ok",
+  snoozed: "adminRevenue.diagnostics.stateBadge.snoozed",
+};
+
+/** Adres naprawy-odnośnika z parametrem z pierwszego `refs` (szablon ścieżki). */
+export function linkSearchOf(
+  fix: { search?: Readonly<Record<string, string>>; refParam?: string },
+  refs: readonly string[],
+): Record<string, string> | undefined {
+  const search: Record<string, string> = { ...(fix.search ?? {}) };
+  if (fix.refParam && refs[0]) search[fix.refParam] = refs[0];
+  return Object.keys(search).length > 0 ? search : undefined;
+}
+
+/** Element listy zogniskowany adresem `?finding=` - stabilny identyfikator DOM. */
+export function findingDomId(id: RevenueCheckId): string {
+  return `revenue-finding-${id.replace(".", "-")}`;
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/MeteringImpactBody.tsx b/src/components/admin/revenue/diagnostics/fixes/MeteringImpactBody.tsx
new file mode 100644
index 000000000..c43ba2993
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/MeteringImpactBody.tsx
@@ -0,0 +1,44 @@
+// Treść naprawy `metering_defaults`: podgląd skutku domyślnego limitu
+// członków w bieżącym miesiącu - ten sam RPC i klucz co karta licznika
+// w paywallu (`meteringImpactPreviewQueryOptions`), więc admin widzi tę samą
+// liczbę „zablokowanych" przed zapisem tutaj i w module.
+import { useQuery } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+
+import { METERING_DEFAULTS } from "@/lib/access/meteringDefaults";
+import { meteringImpactPreviewQueryOptions } from "@/lib/access/meteringQueries";
+import type { EmptyPayload, QuickFixBodyProps } from "@/lib/admin/revenue/quickFixes";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+
+export default function MeteringImpactBody(_props: QuickFixBodyProps<EmptyPayload>) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const impact = useQuery(meteringImpactPreviewQueryOptions(METERING_DEFAULTS.member_monthly_limit, true));
+
+  return (
+    <section className="space-y-1 rounded-[6px] border border-border bg-muted/30 p-3 text-sm">
+      <h4 className="m-0 text-sm font-medium">{t("adminRevenue.fix.body.impactTitle")}</h4>
+      {impact.isPending ? (
+        <p className="m-0 text-muted-foreground">{t("adminRevenue.fix.body.impactLoading")}</p>
+      ) : !impact.data ? (
+        <p className="m-0 text-muted-foreground">{t("adminRevenue.fix.body.impactUnavailable")}</p>
+      ) : (
+        <ul className="m-0 list-none space-y-0.5 p-0">
+          <li>
+            {t("adminRevenue.fix.body.impactMembers", {
+              blocked: impact.data.members_blocked,
+              warning: impact.data.members_warning,
+              total: impact.data.total_members,
+            })}
+          </li>
+          <li>
+            {t("adminRevenue.fix.body.impactAnon", {
+              blocked: impact.data.anon_blocked,
+              total: impact.data.total_anon,
+            })}
+          </li>
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/NumberBody.tsx b/src/components/admin/revenue/diagnostics/fixes/NumberBody.tsx
new file mode 100644
index 000000000..91fc695f4
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/NumberBody.tsx
@@ -0,0 +1,71 @@
+// Treść napraw liczbowych: limit darmowych artykułów dla gości
+// (`metering_anon_limit`, rozwiązanie „własna liczba") i okno porzucenia kasy
+// (`checkout_abandon_window`, 30-1440 minut). Pole pokazuje DOKŁADNIE to, co
+// wpisano (tekst trzymamy lokalnie); wpis nieliczbowy albo spoza zakresu jest
+// ODRZUCANY komunikatem, nigdy przycinany ani czyszczony (AGENTS), a
+// „Zastosuj" pilnuje `valid` specyfikacji (ładunek `null` = niekompletne).
+import { useId, useState } from "react";
+import { useTranslation } from "react-i18next";
+
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { METERING_LIMIT_MAX } from "@/lib/access/meteringQueries";
+import type { NumberPayload, QuickFixBodyProps } from "@/lib/admin/revenue/quickFixes";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import { REVENUE_LIMITS, isCheckoutAbandonMinutes } from "@/lib/revenue/limits";
+
+export default function NumberBody({
+  finding,
+  option,
+  value,
+  onChange,
+  disabled,
+}: QuickFixBodyProps<NumberPayload>) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const id = useId();
+  const hintId = useId();
+  const errorId = useId();
+  const [text, setText] = useState(value.value === null ? "" : String(value.value));
+  if (option.id !== "custom") return null;
+
+  const minutes = finding.checkId === "checkout.abandon_window_default";
+  const min = minutes ? REVENUE_LIMITS.checkoutAbandonMinutesMin : 1;
+  const max = minutes ? REVENUE_LIMITS.checkoutAbandonMinutesMax : METERING_LIMIT_MAX;
+  const inRange = (n: number | null) =>
+    n !== null && (minutes ? isCheckoutAbandonMinutes(n) : Number.isInteger(n) && n >= min && n <= max);
+  const parsed = /^\d{1,6}$/.test(text.trim()) ? Number(text.trim()) : null;
+  const invalid = text.trim() !== "" && !inRange(parsed);
+
+  return (
+    <div className="space-y-1">
+      <Label htmlFor={id}>
+        {t(minutes ? "adminRevenue.fix.body.minutes" : "adminRevenue.fix.body.number")}
+      </Label>
+      <Input
+        id={id}
+        type="text"
+        inputMode="numeric"
+        className="max-w-[10rem]"
+        value={text}
+        onChange={(e) => {
+          const raw = e.target.value;
+          setText(raw);
+          const next = /^\d{1,6}$/.test(raw.trim()) ? Number(raw.trim()) : null;
+          onChange({ value: next !== null && inRange(next) ? next : null });
+        }}
+        aria-invalid={invalid || undefined}
+        aria-describedby={invalid ? `${hintId} ${errorId}` : hintId}
+        disabled={disabled}
+      />
+      <p id={hintId} className="m-0 text-xs text-muted-foreground">
+        {t(minutes ? "adminRevenue.fix.body.minutesHint" : "adminRevenue.fix.body.numberHint", { min, max })}
+      </p>
+      {invalid ? (
+        <p id={errorId} className="m-0 text-xs text-destructive">
+          {t("adminRevenue.fix.body.numberInvalid")}
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/PlanSelectBody.tsx b/src/components/admin/revenue/diagnostics/fixes/PlanSelectBody.tsx
new file mode 100644
index 000000000..1dc83aa48
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/PlanSelectBody.tsx
@@ -0,0 +1,44 @@
+// Treść naprawy `access_rule_plan` w trybie „przypisz": plan, który da się
+// dziś kupić (aktywny i w sprzedaży). Tryb „usuń wycofane" nie potrzebuje
+// wyboru - treść wtedy nic nie rysuje.
+import { useId } from "react";
+import { useTranslation } from "react-i18next";
+
+import { FormSelect } from "@/components/atoms/FormSelect";
+import { Label } from "@/components/ui/label";
+import type { AccessRulePayload, QuickFixBodyProps } from "@/lib/admin/revenue/quickFixes";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+
+export default function PlanSelectBody({
+  facts,
+  value,
+  onChange,
+  disabled,
+}: QuickFixBodyProps<AccessRulePayload>) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const id = useId();
+  if (value.mode !== "assign") return null;
+  const plans = (facts.areas.catalog?.plans ?? []).filter((p) => p.active && p.forSale);
+  if (plans.length === 0) {
+    return <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.fix.body.noPlans")}</p>;
+  }
+  const options = plans.map((plan) => ({
+    value: plan.id,
+    label: [plan.tierKey ?? "-", plan.interval, plan.currency].join(" · "),
+  }));
+
+  return (
+    <div className="space-y-1">
+      <Label htmlFor={id}>{t("adminRevenue.fix.body.plan")}</Label>
+      <FormSelect
+        id={id}
+        value={value.planId ?? ""}
+        onValueChange={(next) => onChange({ ...value, planId: next === "" ? null : next })}
+        options={options}
+        placeholder={t("adminRevenue.fix.body.planPlaceholder")}
+        disabled={disabled}
+      />
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/SenderBody.tsx b/src/components/admin/revenue/diagnostics/fixes/SenderBody.tsx
new file mode 100644
index 000000000..6ba2d1ce2
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/SenderBody.tsx
@@ -0,0 +1,63 @@
+// Treść naprawy `newsletter_sender`: własny adres nadawcy i (opcjonalnie)
+// nazwa. Adres nie trafia do faktów diagnostyki - jedzie wprost mutatorem
+// modułu newslettera. Kształt sprawdza `SENDER_EMAIL_PATTERN` (ten sam
+// predykat co `valid` specyfikacji), błąd mówi, CO poprawić.
+import { useId } from "react";
+import { useTranslation } from "react-i18next";
+
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import {
+  QUICK_FIXES,
+  type QuickFixBodyProps,
+  type SenderPayload,
+} from "@/lib/admin/revenue/quickFixes";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+
+export default function SenderBody({ value, onChange, disabled }: QuickFixBodyProps<SenderPayload>) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const emailId = useId();
+  const nameId = useId();
+  const hintId = useId();
+  const errorId = useId();
+  const touched = value.email.trim() !== "";
+  const valid = QUICK_FIXES.newsletter_sender.valid?.(value) ?? true;
+  const invalid = touched && !valid;
+
+  return (
+    <div className="space-y-3">
+      <div className="space-y-1">
+        <Label htmlFor={emailId}>{t("adminRevenue.fix.body.senderEmail")}</Label>
+        <Input
+          id={emailId}
+          type="email"
+          inputMode="email"
+          autoComplete="off"
+          value={value.email}
+          onChange={(e) => onChange({ ...value, email: e.target.value })}
+          aria-invalid={invalid || undefined}
+          aria-describedby={invalid ? `${hintId} ${errorId}` : hintId}
+          disabled={disabled}
+        />
+        <p id={hintId} className="m-0 text-xs text-muted-foreground">
+          {t("adminRevenue.fix.body.senderEmailHint")}
+        </p>
+        {invalid ? (
+          <p id={errorId} className="m-0 text-xs text-destructive">
+            {t("adminRevenue.fix.body.senderEmailInvalid")}
+          </p>
+        ) : null}
+      </div>
+      <div className="space-y-1">
+        <Label htmlFor={nameId}>{t("adminRevenue.fix.body.senderName")}</Label>
+        <Input
+          id={nameId}
+          value={value.name}
+          onChange={(e) => onChange({ ...value, name: e.target.value })}
+          disabled={disabled}
+        />
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/StaffPickerBody.tsx b/src/components/admin/revenue/diagnostics/fixes/StaffPickerBody.tsx
new file mode 100644
index 000000000..71e229065
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/StaffPickerBody.tsx
@@ -0,0 +1,62 @@
+// Treść napraw CRM: osoba z zespołu (admin, redaktor) - ta sama lista co
+// wybór właściciela w CRM (`crmStaffUsersQueryOptions`, granica personelu
+// sprawdzana też przez serwer). Dla zadań bez osoby wybór pojawia się
+// wyłącznie przy rozwiązaniu „pozostałe wskazanej osobie".
+import { useId } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+
+import { FormSelect } from "@/components/atoms/FormSelect";
+import { Label } from "@/components/ui/label";
+import type {
+  AssignOwnerPayload,
+  AssignTasksPayload,
+  QuickFixBodyProps,
+} from "@/lib/admin/revenue/quickFixes";
+import { crmStaffUsersQueryOptions } from "@/lib/crm/leadMutations";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+
+type StaffPayload = AssignOwnerPayload | AssignTasksPayload;
+
+function isOwnerPayload(value: StaffPayload): value is AssignOwnerPayload {
+  return "ownerId" in value;
+}
+
+export default function StaffPickerBody({
+  value,
+  onChange,
+  disabled,
+}: QuickFixBodyProps<StaffPayload>) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const id = useId();
+  const owner = isOwnerPayload(value);
+  const staff = useQuery({ ...crmStaffUsersQueryOptions(), enabled: owner || value.useFallback });
+  if (!owner && !value.useFallback) return null;
+
+  const selected = owner ? value.ownerId : value.fallbackAssigneeId;
+  const choose = (next: string) => {
+    const person = next === "" ? null : next;
+    onChange(owner ? { ...value, ownerId: person } : { ...value, fallbackAssigneeId: person });
+  };
+
+  return (
+    <div className="space-y-1">
+      <Label htmlFor={id}>{t("adminRevenue.fix.body.staff")}</Label>
+      {staff.isPending ? (
+        <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.fix.body.staffLoading")}</p>
+      ) : (staff.data ?? []).length === 0 ? (
+        <p className="m-0 text-sm text-muted-foreground">{t("adminRevenue.fix.body.staffEmpty")}</p>
+      ) : (
+        <FormSelect
+          id={id}
+          value={selected ?? ""}
+          onValueChange={choose}
+          options={(staff.data ?? []).map((user) => ({ value: user.id, label: user.label }))}
+          placeholder={t("adminRevenue.fix.body.staffPlaceholder")}
+          disabled={disabled}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/diagnostics/fixes/TierSelectBody.tsx b/src/components/admin/revenue/diagnostics/fixes/TierSelectBody.tsx
new file mode 100644
index 000000000..88bc9bddd
--- /dev/null
+++ b/src/components/admin/revenue/diagnostics/fixes/TierSelectBody.tsx
@@ -0,0 +1,47 @@
+// Treść naprawy `plan_tier`: wybór warstwy, do której ma trafić plan bez
+// warstwy. Nazwy warstw z tego samego wpisu cache co Członkostwo i Cennik
+// (`adminMembershipTiersQueryOptions`) - fakty diagnostyki niosą wyłącznie
+// klucze. Leniwy chunk (`QuickFixSpec.body`), ładowany po otwarciu dialogu.
+import { useId } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+
+import { FormSelect } from "@/components/atoms/FormSelect";
+import { adminMembershipTiersQueryOptions } from "@/components/admin/membership/membershipQueries";
+import { Label } from "@/components/ui/label";
+import type { PlanTierPayload, QuickFixBodyProps } from "@/lib/admin/revenue/quickFixes";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+
+export default function TierSelectBody({
+  facts,
+  value,
+  onChange,
+  disabled,
+}: QuickFixBodyProps<PlanTierPayload>) {
+  ensureI18n();
+  const { t, i18n } = useTranslation();
+  const id = useId();
+  const rows = useQuery(adminMembershipTiersQueryOptions());
+  const english = i18n.language.startsWith("en");
+  const options = (facts.areas.catalog?.tiers ?? [])
+    .filter((tier) => tier.active)
+    .map((tier) => {
+      const row = rows.data?.find((r) => r.key === tier.key);
+      const name = row ? (english ? row.name_en : row.name_pl) : "";
+      return { value: tier.key, label: name ? `${name} (${tier.key})` : tier.key };
+    });
+
+  return (
+    <div className="space-y-1">
+      <Label htmlFor={id}>{t("adminRevenue.fix.body.tier")}</Label>
+      <FormSelect
+        id={id}
+        value={value.tierKey ?? ""}
+        onValueChange={(next) => onChange({ ...value, tierKey: next === "" ? null : next })}
+        options={options}
+        placeholder={t("adminRevenue.fix.body.tierPlaceholder")}
+        disabled={disabled}
+      />
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/molecules/RevenueSignalChip.tsx b/src/components/admin/revenue/molecules/RevenueSignalChip.tsx
new file mode 100644
index 000000000..6ce78d188
--- /dev/null
+++ b/src/components/admin/revenue/molecules/RevenueSignalChip.tsx
@@ -0,0 +1,183 @@
+// Molekuła: sygnał Diagnostyki na ekranie modułu (SPEC §2.7, §6.1
+// `RevenueSignalChip`) - „2 otwarte diagnozy · Zobacz w Diagnostyce" nad
+// cennikiem, paywallem, kuponami, CRM… Mapę „ekran → obszary" trzyma
+// `SIGNAL_SURFACES` (`lib/revenue/diagnostics/surfaces.ts`); montaż w modułach
+// robi integracja (I9).
+//
+// ZERO DODATKOWYCH ZAPYTAŃ. Chip czyta TEN SAM klucz i `queryFn` co
+// Diagnostyka (`revenueFactsQueryOptions`) z `select` zawężającym fakty do
+// jego obszarów: przy ciepłym cache (admin przyszedł z huba albo inny chip
+// już je pobrał) nie wysyła żadnego żądania, a współdzielenie struktury
+// sprawia, że renderuje się ponownie tylko wtedy, gdy zmienił się któryś
+// z JEGO obszarów (test z licznikiem wywołań `queryFn`).
+//
+// NIGDY CICHA ZIELEŃ. Obszar, którego reguł nie da się ocenić, daje
+// „Diagnostyka: brak danych", nie „bez problemów". Odmowa roli albo MFA nic
+// nie rysuje - ekran modułu nie jest miejscem na powiadomienie o hubie.
+//
+// `useHydrated()` przed sesją: ekrany modułów renderuje serwer, który nie
+// zna sesji jak klient - do hydratacji chip nie istnieje, więc znacznik
+// serwera i pierwszego renderu klienta jest ten sam.
+import { useMemo } from "react";
+import { Link, useHydrated } from "@tanstack/react-router";
+import { useQuery } from "@tanstack/react-query";
+import { AlertTriangle, CircleHelp, Info, ShieldCheck } from "lucide-react";
+import { useTranslation } from "react-i18next";
+
+import { useAuth } from "@/hooks/useAuth";
+import type { RevenueArea } from "@/lib/admin/revenue/hubTabs";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import {
+  evaluateAreaFindings,
+  revenueFactsQueryOptions,
+  revenueSnoozesQueryOptions,
+  selectFactsForAreas,
+} from "@/lib/revenue/diagnostics/queries";
+import { findingsForAreas, signalSummary, type SignalSummary } from "@/lib/revenue/diagnostics/surfaces";
+import { cn } from "@/lib/utils";
+
+export interface RevenueSignalChipProps {
+  /** Obszary diagnostyki tego ekranu - zwykle `SIGNAL_SURFACES.<ekran>`. */
+  areas: readonly RevenueArea[];
+  /** `bar` - pasek nad treścią modułu; `chip` - zwarta pigułka w nagłówku. */
+  variant?: "bar" | "chip";
+  className?: string;
+}
+
+export function RevenueSignalChip(props: RevenueSignalChipProps) {
+  const hydrated = useHydrated();
+  if (!hydrated) return null;
+  return <SignalChipBody {...props} />;
+}
+
+type Tone = "critical" | "warning" | "info" | "ok" | "unknown";
+
+const TONE_CLASS: Readonly<Record<Tone, string>> = {
+  critical: "border-destructive/40 text-destructive",
+  warning: "border-border text-brand-ink dark:text-brand",
+  info: "border-border text-foreground",
+  ok: "border-border text-muted-foreground",
+  unknown: "border-border text-muted-foreground",
+};
+
+function toneOf(summary: SignalSummary): Tone {
+  if (summary.worst) return summary.worst;
+  return summary.unknown > 0 ? "unknown" : "ok";
+}
+
+function ToneIcon({ tone }: { tone: Tone }) {
+  const className = "h-3.5 w-3.5 shrink-0";
+  if (tone === "critical" || tone === "warning") return <AlertTriangle className={className} aria-hidden="true" />;
+  if (tone === "info") return <Info className={className} aria-hidden="true" />;
+  if (tone === "unknown") return <CircleHelp className={className} aria-hidden="true" />;
+  return <ShieldCheck className={className} aria-hidden="true" />;
+}
+
+function SignalChipBody({ areas, variant = "chip", className }: RevenueSignalChipProps) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const { roles, tenantId } = useAuth();
+  const roleOk = roles.includes("admin") || roles.includes("editor");
+  const tenant = tenantId ?? null;
+  const areaKey = areas.join(",");
+  // `select` stabilny między renderami - nowa funkcja co render liczyłaby
+  // wybór od nowa przy każdym renderze rodzica.
+  const select = useMemo(
+    () => selectFactsForAreas(areaKey.split(",") as RevenueArea[]),
+    [areaKey],
+  );
+  const facts = useQuery({ ...revenueFactsQueryOptions(tenant, { roleOk }), select });
+  const snoozes = useQuery(revenueSnoozesQueryOptions(tenant, { roleOk }));
+
+  const findings = useMemo(() => {
+    if (facts.data?.state !== "ready") return null;
+    const active = snoozes.data?.state === "ready" ? snoozes.data.snoozes : [];
+    return evaluateAreaFindings(facts.data.facts, active, areaKey.split(",") as RevenueArea[]);
+  }, [facts.data, snoozes.data, areaKey]);
+
+  if (!roleOk || !tenant) return null;
+  const denied =
+    facts.data?.state === "forbidden" || facts.data?.state === "mfa_required";
+  if (denied || (facts.isPending && !facts.isError)) return null;
+
+  const summary: SignalSummary =
+    findings === null
+      ? { open: 0, critical: 0, warning: 0, info: 0, worst: null, unknown: 1 }
+      : signalSummary(findings, areas);
+  const tone = toneOf(summary);
+  const top = findings ? findingsForAreas(findings, areas)[0] : undefined;
+  // Odnośnik prowadzi do obszaru najpoważniejszej otwartej diagnozy (adres
+  // przyjmuje jeden obszar), a bez otwartych - do pierwszego obszaru ekranu.
+  const targetArea = top?.area ?? areas[0];
+  const headline =
+    summary.open > 0
+      ? t("adminRevenue.signal.open", { count: summary.open })
+      : tone === "unknown"
+        ? t("adminRevenue.signal.unknown")
+        : t("adminRevenue.signal.ok");
+  const details =
+    summary.open > 0
+      ? t("adminRevenue.signal.details", {
+          critical: summary.critical,
+          warning: summary.warning,
+          info: summary.info,
+        })
+      : null;
+
+  const link = (
+    <Link
+      to="/admin/revenue/$tab"
+      params={{ tab: "diagnostics" }}
+      search={targetArea ? { area: targetArea } : {}}
+      className="font-medium underline underline-offset-2 hover:no-underline"
+    >
+      {t("adminRevenue.signal.action")}
+    </Link>
+  );
+
+  if (variant === "bar") {
+    return (
+      <div
+        role="status"
+        aria-label={t("adminRevenue.signal.label")}
+        data-testid="revenue-signal"
+        data-variant="bar"
+        data-tone={tone}
+        className={cn(
+          "flex flex-wrap items-center gap-x-3 gap-y-1 rounded-[6px] border bg-card px-3 py-2 text-sm",
+          TONE_CLASS[tone],
+          className,
+        )}
+      >
+        <span className="inline-flex items-center gap-1.5">
+          <ToneIcon tone={tone} />
+          <span>{headline}</span>
+        </span>
+        {details ? <span className="text-xs text-muted-foreground">{details}</span> : null}
+        <span className="ml-auto text-xs">{link}</span>
+      </div>
+    );
+  }
+
+  return (
+    <span
+      role="status"
+      aria-label={t("adminRevenue.signal.label")}
+      data-testid="revenue-signal"
+      data-variant="chip"
+      data-tone={tone}
+      className={cn(
+        "inline-flex flex-wrap items-center gap-1.5 rounded-md border px-2 py-0.5 text-xs",
+        TONE_CLASS[tone],
+        className,
+      )}
+    >
+      <ToneIcon tone={tone} />
+      <span>{headline}</span>
+      {/* Liczby per waga w pigułce tylko dla czytnika - wizualnie mieszczą się w pasku. */}
+      {details ? <span className="sr-only">{details}</span> : null}
+      <span aria-hidden="true">·</span>
+      {link}
+    </span>
+  );
+}
diff --git a/src/components/admin/revenue/overview/AttentionCard.tsx b/src/components/admin/revenue/overview/AttentionCard.tsx
new file mode 100644
index 000000000..195885d82
--- /dev/null
+++ b/src/components/admin/revenue/overview/AttentionCard.tsx
@@ -0,0 +1,120 @@
+// Organizm: „Wymaga uwagi" na Kokpicie huba (SPEC §2.2 `overview`, §6.1) -
+// trzy najpoważniejsze OTWARTE diagnozy (waga, skutek trwający przed
+// ukrytym, wpływ, liczba) jako zwarte `DiagnosticCard` i odnośnik do pełnej
+// Diagnostyki. Montuje ją Kokpit (S7-B).
+//
+// TA SAMA OCENA CO DIAGNOSTYKA: fakty i wyciszenia z fabryk
+// `revenueFactsQueryOptions` / `revenueSnoozesQueryOptions` i wybór
+// `topAttention` - karta nie liczy „najważniejszych" po swojemu, więc to, co
+// widać na Kokpicie, jest pierwszą pozycją listy w Diagnostyce.
+//
+// „Napraw" z karty prowadzi do Diagnostyki z `?fix=` (dialog naprawy
+// mieszka tam, razem z ponowną oceną i „Cofnij"), zamiast otwierać drugi
+// egzemplarz dialogu na Kokpicie.
+//
+// Brak faktów (`unavailable`, błąd) mówi „nie da się teraz ocenić", nigdy
+// „nic pilnego" - pusta lista przy braku danych byłaby cichą zielenią.
+import { Link, useNavigate } from "@tanstack/react-router";
+import { useQuery } from "@tanstack/react-query";
+import { useMemo } from "react";
+import { useTranslation } from "react-i18next";
+
+import { DiagnosticCard } from "@/components/admin/revenue/diagnostics/DiagnosticCard";
+import { RevenueSection } from "@/components/admin/revenue/molecules/RevenueSection";
+import { Button } from "@/components/ui/button";
+import { topAttention } from "@/lib/admin/revenue/diagnosticGroups";
+import { ensureI18n } from "@/lib/i18n-admin-revenue-diagnostics";
+import {
+  evaluateFindings,
+  revenueFactsQueryOptions,
+  revenueSnoozesQueryOptions,
+} from "@/lib/revenue/diagnostics/queries";
+
+/** Ile diagnoz pokazuje Kokpit (SPEC §2.2: „top 3"). */
+export const ATTENTION_LIMIT = 3;
+
+export interface AttentionCardProps {
+  tenantId: string | null;
+  roles: readonly string[];
+}
+
+export function AttentionCard({ tenantId, roles }: AttentionCardProps) {
+  ensureI18n();
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const roleOk = roles.includes("admin") || roles.includes("editor");
+  const facts = useQuery(revenueFactsQueryOptions(tenantId, { roleOk }));
+  const snoozes = useQuery(revenueSnoozesQueryOptions(tenantId, { roleOk }));
+
+  const top = useMemo(() => {
+    if (facts.data?.state !== "ready") return null;
+    const active = snoozes.data?.state === "ready" ? snoozes.data.snoozes : [];
+    return topAttention(evaluateFindings(facts.data.facts, active), ATTENTION_LIMIT);
+  }, [facts.data, snoozes.data]);
+
+  if (!roleOk || !tenantId) return null;
+  // Odmowa roli albo MFA: Kokpit pokazuje powiadomienie układu, nie kartę.
+  if (facts.data?.state === "forbidden" || facts.data?.state === "mfa_required") return null;
+
+  const allLink = (
+    <Button asChild size="sm" variant="outline" className="h-7">
+      <Link to="/admin/revenue/$tab" params={{ tab: "diagnostics" }}>
+        {t("adminRevenue.attention.all")}
+      </Link>
+    </Button>
+  );
+
+  let body;
+  if (top === null) {
+    body =
+      facts.isPending && !facts.isError ? (
+        <p role="status" className="m-0 text-sm text-muted-foreground">
+          {t("adminRevenue.attention.loading")}
+        </p>
+      ) : (
+        <p role="status" className="m-0 text-sm text-muted-foreground" data-testid="attention-unknown">
+          {t("adminRevenue.attention.unknown")}
+        </p>
+      );
+  } else if (top.length === 0) {
+    body = (
+      <p role="status" className="m-0 text-sm text-muted-foreground" data-testid="attention-empty">
+        {t("adminRevenue.attention.empty")}
+      </p>
+    );
+  } else {
+    body = (
+      <ul className="m-0 grid list-none gap-2 p-0 md:grid-cols-3">
+        {top.map((finding) => (
+          <li key={finding.checkId} className="min-w-0">
+            <DiagnosticCard
+              finding={finding}
+              variant="compact"
+              className="h-full"
+              factsAt={facts.data?.state === "ready" ? facts.data.facts.computedAt : null}
+              onFix={() =>
+                void navigate({
+                  to: "/admin/revenue/$tab",
+                  params: { tab: "diagnostics" },
+                  search: { fix: finding.checkId },
+                })
+              }
+            />
+          </li>
+        ))}
+      </ul>
+    );
+  }
+
+  return (
+    <div data-testid="revenue-attention">
+      <RevenueSection
+        titleKey="adminRevenue.attention.title"
+        descriptionKey="adminRevenue.attention.description"
+        actions={allLink}
+      >
+        {body}
+      </RevenueSection>
+    </div>
+  );
+}
diff --git a/src/components/admin/revenue/tabs/RevenueDiagnosticsTab.tsx b/src/components/admin/revenue/tabs/RevenueDiagnosticsTab.tsx
