--- /dev/null
+++ b/supabase/migrations/20261020120000_account_registered_event.sql
@@ -0,0 +1,111 @@
+-- ============================================================================
+-- HUB „PRZYCHÓD I LEJEK" (S3, 1/5): ZDARZENIE REJESTRACJI KONTA -
+-- `account.registered.v1` Z ŹRÓDŁEM ZAPISU.
+--
+-- DEFEKT
+--   1. Lejek czytelnika nie ma faktu „powstało konto". Rejestracja zostawia
+--      wiersz `profiles` (trigger `handle_new_user`), ale nie emituje żadnego
+--      zdarzenia domenowego - hub, CRM i ścieżki (S5: „powitanie nowego
+--      konta") nie mają czego słuchać, a lista członków w innych kartach
+--      panelu odświeża się dopiero po przeładowaniu.
+--   2. Atrybucja rejestracji jest martwa (P16): `signup_source` z metadanych
+--      konta (`buildSignupMetadata`: auth_page, login_popup, popup, club_gate,
+--      register_widget) ląduje wyłącznie w `auth.users.raw_user_meta_data`,
+--      którego nie czyta żaden raport - „skąd przychodzą konta" nie ma
+--      odpowiedzi.
+--
+-- ZMIANA
+--   `tg_profiles_account_registered_emit` - AFTER INSERT ON `profiles`
+--   (rejestr S3 w `src/lib/ci/hubDelivery.ts`, rodzaj `trigger`):
+--     * agregat `account`, `aggregate_id` = id konta; BEZ aktora
+--       (`p_suppress_actor`): rejestrację wykonuje GoTrue bez sesji
+--       użytkownika, a polityka `domain_events` daje aktorowi odczyt
+--       „własnych" zdarzeń - konto jest w `aggregate_id` i `payload.user_id`;
+--     * payload BEZ PII: `user_id`, `signup_source` (BIAŁA LISTA - wartość
+--       spoza listy albo brak to `unknown`, bo payload czyta cały staff
+--       najemcy, a metadane konta pisze klient: dowolny napis z formularza
+--       nie może wejść na szynę), `marketing_opt_in` (tylko `true`/`false`;
+--       nieczytelna wartość = `false`, jak zgoda niewyrażona),
+--       `has_attribution` (czy metadane niosą klucz atrybucji kampanii - UTM
+--       albo `attribution`; same wartości UTM zostają w koncie);
+--     * lista źródeł = `SIGNUP_SOURCES` w `src/lib/revenue/funnel/funnelStages.ts`
+--       (test parytetu czyta tę migrację).
+--   Awaria szyny nie przerywa rejestracji: ciało w `EXCEPTION WHEN OTHERS`
+--   zapisuje ślad przez `_log_emit_error(…, SQLSTATE, SQLERRM)` (kontrakt
+--   Z-02) i zwraca NULL. Wyzwalacz nie ma EXECUTE dla żadnej roli API.
+--
+-- KOLEJNOŚĆ WDROŻENIA: po 20261020090500 (`_log_emit_error`). Typ zdarzenia
+-- i reguła inwalidacji są w katalogu I0 (`DOMAIN_EVENT_TYPES`). Kod klienta
+-- nie wymaga zmian - zdarzenie tylko dokłada inwalidację i fakt lejka.
+-- `profiles` jest gorącą tabelą: CREATE TRIGGER pod `lock_timeout`.
+-- IDEMPOTENTNA: CREATE OR REPLACE FUNCTION (nowa sygnatura, bez CIALO-Z),
+-- DROP TRIGGER IF EXISTS + CREATE TRIGGER, bezstanowe REVOKE.
+-- DOWÓD: supabase/tests/account_registered_event_test.sql (realny wiersz
+-- `domain_events`, biała lista źródeł, brak PII w payloadzie, awaria szyny
+-- nie przerywa INSERT), src/lib/revenue/funnel/__tests__/funnelStages.test.ts
+-- (parytet listy źródeł z tą migracją).
+-- ============================================================================
+
+CREATE OR REPLACE FUNCTION public.tg_profiles_account_registered_emit()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_meta jsonb;
+  v_source text;
+  v_opt_in boolean;
+  v_attribution boolean;
+BEGIN
+  -- Metadane rejestracji żyją w koncie auth, nie w profilu. Ten sam wiersz
+  -- przeczytał przed chwilą `handle_new_user`, więc jest już widoczny w tej
+  -- transakcji.
+  SELECT u.raw_user_meta_data INTO v_meta FROM auth.users u WHERE u.id = NEW.id;
+  v_meta := COALESCE(v_meta, '{}'::jsonb);
+
+  v_source := v_meta ->> 'signup_source';
+  IF v_source IS NULL OR v_source NOT IN (
+    'auth_page', 'login_popup', 'popup', 'club_gate', 'register_widget',
+    'paywall', 'pricing', 'checkout', 'club_apply', 'join_us_form'
+  ) THEN
+    v_source := 'unknown';
+  END IF;
+
+  -- Zgoda marketingowa tylko jako jawne `true` - napis albo brak klucza to
+  -- zgoda NIEwyrażona (RODO: domniemanie zgody nie istnieje).
+  v_opt_in := lower(COALESCE(v_meta ->> 'marketing_opt_in', '')) = 'true';
+  v_attribution := v_meta ?| ARRAY['utm_source', 'utm_medium', 'utm_campaign', 'attribution'];
+
+  PERFORM public.emit_domain_event(
+    NEW.tenant_id, 'account', NEW.id::text, 'account.registered.v1',
+    jsonb_build_object(
+      'user_id', NEW.id,
+      'signup_source', v_source,
+      'marketing_opt_in', v_opt_in,
+      'has_attribution', v_attribution
+    ),
+    p_suppress_actor => true
+  );
+  RETURN NULL;
+EXCEPTION WHEN OTHERS THEN
+  PERFORM public._log_emit_error(
+    NEW.tenant_id, 'tg_profiles_account_registered_emit', 'account.registered.v1', SQLSTATE, SQLERRM
+  );
+  RETURN NULL;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.tg_profiles_account_registered_emit() FROM PUBLIC, anon, authenticated, service_role;
+
+COMMENT ON FUNCTION public.tg_profiles_account_registered_emit() IS
+  'Hub S3: account.registered.v1 {user_id, signup_source (biała lista, inaczej unknown), marketing_opt_in, has_attribution} - bez PII; awaria szyny -> domain_event_emit_errors, rejestracja przechodzi.';
+
+SET lock_timeout = '5s';
+
+DROP TRIGGER IF EXISTS trg_profiles_account_registered_emit ON public.profiles;
+CREATE TRIGGER trg_profiles_account_registered_emit
+  AFTER INSERT ON public.profiles
+  FOR EACH ROW EXECUTE FUNCTION public.tg_profiles_account_registered_emit();
+
+RESET lock_timeout;
diff --git a/supabase/migrations/20261020120100_paywall_hits_rpc.sql b/supabase/migrations/20261020120100_paywall_hits_rpc.sql
new file mode 100644
index 000000000..1a832cb10
--- /dev/null
+++ b/supabase/migrations/20261020120100_paywall_hits_rpc.sql
@@ -0,0 +1,282 @@
+-- ============================================================================
+-- HUB „PRZYCHÓD I LEJEK" (S3, 2/5): POMIAR UDERZEŃ W PAYWALL -
+-- `record_paywall_hit` (konto) I `record_paywall_hit_visitor` (gość, serwer).
+--
+-- DEFEKT
+--   1. Brak pomiaru paywalla (P18): ani `Paywall`, ani `MeterBanner`, ani
+--      bramka klubu nie zostawiają śladu, że czytelnik zatrzymał się na
+--      ścianie. Lejek „wyświetlenie -> rejestracja -> płatność" nie ma środka,
+--      a wskaźniki PHR (zasięg paywalla) i PSCR (konwersja paywalla) z
+--      rejestru S6 nie mają mianownika.
+--   2. Pomiar klienta (`track()`) działa wyłącznie przy zgodzie analitycznej -
+--      liczony nim lejek byłby próbką zależną od banera zgód, a nie faktem.
+--      Uderzenie w paywall to fakt wykonania usługi (umowa: dostęp do treści
+--      wg planu), więc zapis serwerowy nie zależy od zgody i nie niesie
+--      identyfikatora przeglądarki ani adresu.
+--
+-- ZMIANA (rejestr S3 w `src/lib/ci/hubDelivery.ts`)
+--   A. `record_paywall_hit(p_entity_type, p_entity_id, p_reason,
+--      p_required_tier_key, p_variant)` - rodzaj `reader`: EXECUTE dla
+--      `authenticated` BEZ bramki roli (czytelnik nie jest staffem). Konto
+--      wyłącznie z `auth.uid()`, najemca wyłącznie z `public_tenant_id()`
+--      (płaszczyzna treści - ten sam najemca, który wydał regułę dostępu;
+--      funkcja NIE łączy go z `has_role`, więc `check:sql-tenant-scope` ma
+--      czysty przypadek). Jeden wiersz `paywall_hits` na (doba UTC, konto,
+--      treść, wariant) z licznikiem (`ON CONFLICT … DO UPDATE hits + 1`).
+--      Pierwszy wiersz konta w dobie emituje `paywall.hit.v1` - blokada
+--      transakcyjna per (najemca, konto, doba) serializuje sprawdzenie
+--      „pierwszy dziś", więc dwie karty naraz nie dają dwóch zdarzeń.
+--   B. `record_paywall_hit_visitor(p_visitor_hash, p_tenant, …)` - rodzaj
+--      `service`: wyłącznie `service_role` (funkcja serwerowa
+--      `recordPaywallHitVisitor`, najemca z zaufanego hosta, skrót gościa
+--      z podpisanego cookie - nigdy z ładunku klienta). Bez zdarzenia na
+--      szynie (zdarzenie jest per konto; gość nie ma kogo prowadzić ścieżką).
+--   C. Walidacja wejścia JAWNA, z odrzuceniem (22023), nie z przycięciem:
+--      typ treści, powód i wariant z dziedziny CHECK-ów tabeli, klucz warstwy
+--      <= 64 znaki i istniejący u najemcy. Treść musi należeć do najemcy
+--      i być zabramkowana (`content_access` z trybem innym niż `public`,
+--      klub albo wydarzenie najemcy) - inaczej wywołanie jest pomijane bez
+--      wiersza: RPC jest otwarte dla każdego zalogowanego, więc bez tego
+--      dałoby się zaśmiecać lejek dowolnymi identyfikatorami.
+--   Błąd emitera nie psuje zapisu uderzenia (`_log_emit_error`, Z-02).
+--
+-- KOLEJNOŚĆ WDROŻENIA: po 20261020090100 (`paywall_hits`, unikalne indeksy
+-- częściowe = arbitry ON CONFLICT) i 20261020090500 (`_log_emit_error`).
+-- Klient woła RPC literałem przez `RpcCallable`; przed wdrożeniem dostaje
+-- PGRST202, który paywall połyka (pomiar nigdy nie psuje ściany).
+-- IDEMPOTENTNA: CREATE OR REPLACE FUNCTION (nowe sygnatury), bezstanowe
+-- REVOKE/GRANT. Zero DDL tabel.
+-- DOWÓD: supabase/tests/paywall_hits_test.sql (uid z sesji, najemca z
+-- `public_tenant_id()`, deduplikacja doby, jedno zdarzenie na dobę, `anon`
+-- bez EXECUTE, wariant gościa tylko dla `service_role`, odrzucenie złego
+-- wejścia), src/lib/access/__tests__/paywallHits.functions.test.ts.
+-- ============================================================================
+
+-- ----------------------------------------------------------------------------
+-- Wspólna walidacja i zapis - ciało jest w obu funkcjach osobno (funkcja
+-- pomocnicza byłaby trzecią funkcją bez właściciela w rejestrze), dlatego
+-- reguły wejścia stoją w jednym miejscu: tu, w opisie, i w obu ciałach 1:1.
+-- ----------------------------------------------------------------------------
+
+-- ----------------------------------------------------------------------------
+-- A) Konto.
+-- ----------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.record_paywall_hit(
+  p_entity_type text,
+  p_entity_id uuid,
+  p_reason text,
+  p_required_tier_key text DEFAULT NULL,
+  p_variant text DEFAULT 'default'
+)
+RETURNS void
+LANGUAGE plpgsql
+VOLATILE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_uid uuid := auth.uid();
+  v_tenant uuid;
+  v_day date := (now() AT TIME ZONE 'UTC')::date;
+  v_variant text := COALESCE(NULLIF(btrim(p_variant), ''), 'default');
+  v_tier text := NULLIF(btrim(p_required_tier_key), '');
+  v_gated boolean := false;
+  v_first boolean;
+BEGIN
+  IF v_uid IS NULL THEN
+    RAISE EXCEPTION 'paywall_hit_requires_account' USING ERRCODE = '42501';
+  END IF;
+  IF p_entity_type IS NULL OR p_entity_type NOT IN ('post', 'page', 'media', 'club', 'event') THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_entity_type' USING ERRCODE = '22023';
+  END IF;
+  IF p_entity_id IS NULL THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_entity_id' USING ERRCODE = '22023';
+  END IF;
+  IF p_reason IS NULL OR p_reason NOT IN ('members', 'paid', 'tier_rank', 'password', 'quota', 'registration') THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_reason' USING ERRCODE = '22023';
+  END IF;
+  IF v_variant !~ '^[a-z0-9_-]{1,32}$' THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_variant' USING ERRCODE = '22023';
+  END IF;
+  IF v_tier IS NOT NULL AND char_length(v_tier) > 64 THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_tier_key' USING ERRCODE = '22023';
+  END IF;
+
+  v_tenant := public.public_tenant_id();
+  IF v_tenant IS NULL THEN
+    RETURN;
+  END IF;
+
+  -- Warstwa spoza katalogu najemcy nie jest błędem czytelnika (reguła mogła
+  -- wskazać warstwę usuniętą chwilę temu) - zapis bez klucza, nie odmowa.
+  IF v_tier IS NOT NULL AND NOT EXISTS (
+    SELECT 1 FROM public.membership_tiers mt WHERE mt.tenant_id = v_tenant AND mt.key = v_tier
+  ) THEN
+    v_tier := NULL;
+  END IF;
+
+  IF p_entity_type IN ('post', 'page', 'media') THEN
+    SELECT EXISTS (
+      SELECT 1 FROM public.content_access ca
+       WHERE ca.entity_type = p_entity_type::public.access_entity_type
+         AND ca.entity_id = p_entity_id
+         AND ca.tenant_id = v_tenant
+         AND ca.mode <> 'public'
+    ) INTO v_gated;
+  ELSIF p_entity_type = 'club' THEN
+    SELECT EXISTS (
+      SELECT 1 FROM public.clubs c WHERE c.id = p_entity_id AND c.tenant_id = v_tenant
+    ) INTO v_gated;
+  ELSE
+    SELECT EXISTS (
+      SELECT 1 FROM public.events e WHERE e.id = p_entity_id AND e.tenant_id = v_tenant
+    ) INTO v_gated;
+  END IF;
+  IF NOT v_gated THEN
+    RETURN;
+  END IF;
+
+  -- „Pierwszy wiersz konta w dobie" sprawdzany pod blokadą: bez niej dwa
+  -- równoległe uderzenia w RÓŻNE treści widziałyby pustą dobę i oba
+  -- emitowały zdarzenie. Blokada transakcyjna zwalnia się sama.
+  PERFORM pg_advisory_xact_lock(
+    hashtextextended('paywall_hit:' || v_tenant::text || ':' || v_uid::text || ':' || v_day::text, 0)
+  );
+  v_first := NOT EXISTS (
+    SELECT 1 FROM public.paywall_hits ph
+     WHERE ph.tenant_id = v_tenant AND ph.day = v_day AND ph.user_id = v_uid
+  );
+
+  INSERT INTO public.paywall_hits
+    (tenant_id, day, user_id, entity_type, entity_id, reason, required_tier_key, variant)
+  VALUES
+    (v_tenant, v_day, v_uid, p_entity_type, p_entity_id, p_reason, v_tier, v_variant)
+  ON CONFLICT (tenant_id, day, user_id, entity_type, entity_id, variant) WHERE user_id IS NOT NULL
+  DO UPDATE SET
+    hits = public.paywall_hits.hits + 1,
+    last_at = now(),
+    -- Powód i warstwa z OSTATNIEGO uderzenia: czytelnik, który kupił niższy
+    -- plan, wraca na tę samą treść już z powodem `tier_rank`.
+    reason = EXCLUDED.reason,
+    required_tier_key = EXCLUDED.required_tier_key;
+
+  IF v_first THEN
+    BEGIN
+      PERFORM public.emit_domain_event(
+        v_tenant, 'paywall', v_uid::text, 'paywall.hit.v1',
+        jsonb_strip_nulls(jsonb_build_object(
+          'user_id', v_uid,
+          'entity_type', p_entity_type,
+          'entity_id', p_entity_id,
+          'reason', p_reason,
+          'required_tier_key', v_tier,
+          'variant', v_variant
+        )),
+        v_uid
+      );
+    EXCEPTION WHEN OTHERS THEN
+      PERFORM public._log_emit_error(v_tenant, 'record_paywall_hit', 'paywall.hit.v1', SQLSTATE, SQLERRM);
+    END;
+  END IF;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.record_paywall_hit(text, uuid, text, text, text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.record_paywall_hit(text, uuid, text, text, text) TO authenticated, service_role;
+
+COMMENT ON FUNCTION public.record_paywall_hit(text, uuid, text, text, text) IS
+  'Hub S3: uderzenie zalogowanego czytelnika w paywall - konto z auth.uid(), najemca z public_tenant_id(); wiersz na (doba UTC, konto, treść, wariant) z licznikiem; pierwszy wiersz doby -> paywall.hit.v1. Niezależne od zgody analitycznej (fakt usługi, bez identyfikatora przeglądarki).';
+
+-- ----------------------------------------------------------------------------
+-- B) Gość - wyłącznie serwer.
+-- ----------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.record_paywall_hit_visitor(
+  p_visitor_hash text,
+  p_tenant uuid,
+  p_entity_type text,
+  p_entity_id uuid,
+  p_reason text,
+  p_required_tier_key text DEFAULT NULL,
+  p_variant text DEFAULT 'default'
+)
+RETURNS void
+LANGUAGE plpgsql
+VOLATILE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_day date := (now() AT TIME ZONE 'UTC')::date;
+  v_variant text := COALESCE(NULLIF(btrim(p_variant), ''), 'default');
+  v_tier text := NULLIF(btrim(p_required_tier_key), '');
+  v_gated boolean := false;
+BEGIN
+  -- Skrót gościa: wyłącznie hex skrótu HMAC (16-128 znaków, CHECK tabeli).
+  -- Za długi albo nie-hex to błąd serwera, nie dane do przycięcia.
+  IF p_visitor_hash IS NULL OR p_visitor_hash !~ '^[0-9a-f]{16,128}$' THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_visitor' USING ERRCODE = '22023';
+  END IF;
+  IF p_entity_type IS NULL OR p_entity_type NOT IN ('post', 'page', 'media', 'club', 'event') THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_entity_type' USING ERRCODE = '22023';
+  END IF;
+  IF p_entity_id IS NULL THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_entity_id' USING ERRCODE = '22023';
+  END IF;
+  IF p_reason IS NULL OR p_reason NOT IN ('members', 'paid', 'tier_rank', 'password', 'quota', 'registration') THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_reason' USING ERRCODE = '22023';
+  END IF;
+  IF v_variant !~ '^[a-z0-9_-]{1,32}$' THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_variant' USING ERRCODE = '22023';
+  END IF;
+  IF v_tier IS NOT NULL AND char_length(v_tier) > 64 THEN
+    RAISE EXCEPTION 'paywall_hit_invalid_tier_key' USING ERRCODE = '22023';
+  END IF;
+  IF p_tenant IS NULL THEN
+    RETURN;
+  END IF;
+
+  IF v_tier IS NOT NULL AND NOT EXISTS (
+    SELECT 1 FROM public.membership_tiers mt WHERE mt.tenant_id = p_tenant AND mt.key = v_tier
+  ) THEN
+    v_tier := NULL;
+  END IF;
+
+  IF p_entity_type IN ('post', 'page', 'media') THEN
+    SELECT EXISTS (
+      SELECT 1 FROM public.content_access ca
+       WHERE ca.entity_type = p_entity_type::public.access_entity_type
+         AND ca.entity_id = p_entity_id
+         AND ca.tenant_id = p_tenant
+         AND ca.mode <> 'public'
+    ) INTO v_gated;
+  ELSIF p_entity_type = 'club' THEN
+    SELECT EXISTS (
+      SELECT 1 FROM public.clubs c WHERE c.id = p_entity_id AND c.tenant_id = p_tenant
+    ) INTO v_gated;
+  ELSE
+    SELECT EXISTS (
+      SELECT 1 FROM public.events e WHERE e.id = p_entity_id AND e.tenant_id = p_tenant
+    ) INTO v_gated;
+  END IF;
+  IF NOT v_gated THEN
+    RETURN;
+  END IF;
+
+  INSERT INTO public.paywall_hits
+    (tenant_id, day, visitor_hash, entity_type, entity_id, reason, required_tier_key, variant)
+  VALUES
+    (p_tenant, v_day, p_visitor_hash, p_entity_type, p_entity_id, p_reason, v_tier, v_variant)
+  ON CONFLICT (tenant_id, day, visitor_hash, entity_type, entity_id, variant) WHERE visitor_hash IS NOT NULL
+  DO UPDATE SET
+    hits = public.paywall_hits.hits + 1,
+    last_at = now(),
+    reason = EXCLUDED.reason,
+    required_tier_key = EXCLUDED.required_tier_key;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.record_paywall_hit_visitor(text, uuid, text, uuid, text, text, text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.record_paywall_hit_visitor(text, uuid, text, uuid, text, text, text) TO service_role;
+
+COMMENT ON FUNCTION public.record_paywall_hit_visitor(text, uuid, text, uuid, text, text, text) IS
+  'Hub S3: uderzenie gościa w paywall - wyłącznie service_role (najemca z zaufanego hosta, skrót gościa HMAC z podpisanego cookie); wiersz na (doba UTC, gość, treść, wariant) z licznikiem, bez zdarzenia na szynie.';
diff --git a/supabase/migrations/20261020120200_metering_quota_rank_gate.sql b/supabase/migrations/20261020120200_metering_quota_rank_gate.sql
new file mode 100644
index 000000000..f4f21718a
--- /dev/null
+++ b/supabase/migrations/20261020120200_metering_quota_rank_gate.sql
@@ -0,0 +1,450 @@
+-- ============================================================================
+-- HUB „PRZYCHÓD I LEJEK" (S3, 3/5): LICZNIK ARTYKUŁÓW - PRÓG RANGI (P19),
+-- ZDARZENIE WYCZERPANIA LIMITU I TOŻSAMOŚĆ W TELEMETRII ODMÓW.
+--
+-- DEFEKT
+--   1. P19 - licznik omija próg rangi. `_metered_view_consume`
+--      (20261013090400) wydaje body każdej treści `members`/`paid`
+--      z polityką licznika, także tej z `content_access.min_tier_rank > 0`.
+--      Treść „tylko dla Pro" była więc do przeczytania za darmo w ramach
+--      miesięcznego limitu przez każde konto (i gościa przy `anon_monthly_limit
+--      > 0`) - drabinka warstw (`has_content_access`) przegrywała z licznikiem.
+--   2. Wyczerpanie limitu nie zostawia faktu na szynie: lejek nie widzi
+--      momentu najwyższej intencji zakupu („przeczytałem wszystkie darmowe"),
+--      a ścieżka S5 nie ma na co zareagować. Z tabeli `metering_event_log` nie
+--      da się tego wyprowadzić tanio - konto loguje odmowy klientem
+--      (opcjonalnie), więc szukanie „pierwszej odmowy w miesiącu" byłoby
+--      skanem dziennika przy KAŻDYM odczycie artykułu.
+--   3. `log_metering_event` (20260721070203) przyjmuje od zalogowanego klienta
+--      dowolny `_visitor_id`: konto mogło dopisać do dziennika odmowy
+--      „cudzego" gościa i zawyżać ścianę rejestracji w raportach. Wiersz
+--      konta zawsze bierze `user_id` z `auth.uid()`, ale klucz gościa szedł
+--      z ładunku bez sprawdzenia.
+--
+-- ZMIANA (rejestr S3 w `src/lib/ci/hubDelivery.ts`)
+--   A. `_metered_view_consume` - ciało 1:1 z 20261013090400 (blokady per
+--      podmiot i adres, sufit adresu gości, `remaining` = min(limit, sufit),
+--      odmowy gości w dzienniku) plus:
+--        * P19: po gałęzi uprawnionych (`has_content_access` - ci dostają body
+--          bez licznika jak dotąd) treść z `min_tier_rank > 0` jest wyłączona
+--          z licznika, gdy ranga czytającego (`user_tier_rank(uid, najemca)`;
+--          gość = ranga warstwy domyślnej, czyli tej, którą dostałby po
+--          rejestracji) jest NIŻSZA od progu - werdykt „licznik nie dotyczy"
+--          (bez body, bez slotu), a paywall pokazuje ścieżkę do warstwy.
+--          Treści bez progu (`min_tier_rank = 0`) działają bit w bit jak
+--          dotąd - istniejące `metering_*` przechodzą bez edycji;
+--        * `metering.quota_exhausted.v1` przy odmowie KONTA z wyczerpanym
+--          limitem - najwyżej raz na konto i miesiąc: znacznik
+--          `revenue_event_marks` (kind `quota`, ref `<konto>:<RRRR-MM>`,
+--          `INSERT … ON CONFLICT (PK) DO NOTHING RETURNING`) - jedno
+--          wyszukanie po kluczu głównym, ZERO skanu `metering_event_log`
+--          (pgTAP: 1000 wywołań). Awaria emitera -> `_log_emit_error`,
+--          odmowa i tak wraca do czytelnika.
+--      `SET search_path = public, pg_temp` (było `public`) - zasada §4.1 dla
+--      każdej funkcji SECURITY DEFINER huba.
+--   B. `log_metering_event` - ciało z 20260721070203 plus: zalogowany klient
+--      NIE podaje `_visitor_id` (42501 `metering_identity_mismatch`);
+--      `user_id` jak dotąd wyłącznie z `auth.uid()`; typ treści z dziedziny
+--      `access_entity_type`, powód <= 120 znaków (22023, bez przycinania).
+--      Granty jak w 20261013090400 (konto i serwer; anon bez EXECUTE).
+--
+-- KOLEJNOŚĆ WDROŻENIA: po 20261020090000 (`revenue_event_marks`)
+-- i 20261020090500 (`_log_emit_error`). Sygnatury bez zmian - CREATE OR
+-- REPLACE zachowuje wołających (`consume_metered_view`,
+-- `consume_metered_view_visitor`, `src/lib/access/metering.ts`), a REVOKE
+-- powtarzamy, bo bramka dostawy wymaga ich w tym samym pliku. Kod klienta
+-- nie wymaga zmian: werdykt P19 ma kształt werdyktu „licznik nie dotyczy"
+-- (`granted = false`, `monthly_limit = 0`), który klient już obsługuje
+-- standardowym paywallem.
+-- IDEMPOTENTNA: CREATE OR REPLACE FUNCTION, bezstanowe REVOKE/GRANT.
+-- DOWÓD: supabase/tests/metering_quota_rank_gate_test.sql (P19 dla konta
+-- i gościa, treść bez progu bez zmian, quota raz na miesiąc, 1000 wywołań bez
+-- skanu sekwencyjnego `metering_event_log`, `log_metering_event` odrzuca
+-- cudzą tożsamość); istniejące metering_paywall_test, metering_visitor_identity_test,
+-- metering_concurrency_test - bez edycji.
+-- ============================================================================
+
+-- ----------------------------------------------------------------------------
+-- A) Rdzeń konsumpcji.
+-- ----------------------------------------------------------------------------
+-- CIALO-Z: 20261013090400
+CREATE OR REPLACE FUNCTION public._metered_view_consume(
+  _tenant uuid,
+  _uid uuid,
+  _visitor_id uuid,
+  _ip_subject text,
+  _entity_type public.access_entity_type,
+  _entity_id uuid
+)
+RETURNS TABLE (
+  granted boolean,
+  consumed boolean,
+  used integer,
+  monthly_limit integer,
+  remaining integer,
+  requires_registration boolean,
+  show_counter boolean,
+  content_pl text,
+  content_en text,
+  builder_data jsonb,
+  blocks_data jsonb
+)
+LANGUAGE plpgsql
+VOLATILE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_settings public.metering_settings%ROWTYPE;
+  v_mode public.access_mode;
+  v_policy text;
+  v_rule_tenant uuid;
+  v_min_rank integer := 0;
+  v_limit integer := 0;
+  v_ip_limit integer := 0;
+  v_used integer := 0;
+  v_ip_used integer := 0;
+  v_remaining integer := 0;
+  v_already boolean := false;
+  v_insert_count integer := 0;
+  v_requires_registration boolean := false;
+  v_show_counter boolean := false;
+  v_content_pl text;
+  v_content_en text;
+  v_builder jsonb;
+  v_blocks jsonb;
+  v_body_found boolean := false;
+  v_period date := (date_trunc('month', now()))::date;
+  v_subject text;
+  v_quota_ref text;
+  v_quota_marked integer;
+BEGIN
+  -- Rdzen liczy dla konta WYLACZNIE biezacego wolajacego: skrot dla
+  -- uprawnionych (has_content_access) czyta auth.uid(), wiec inne _uid
+  -- rozjechaloby werdykt dostepu i licznik.
+  IF _uid IS NOT NULL AND _uid IS DISTINCT FROM auth.uid() THEN
+    RAISE EXCEPTION 'metering_identity_mismatch';
+  END IF;
+  IF _uid IS NULL AND _ip_subject IS NOT NULL AND _ip_subject !~ '^ip:[0-9a-f]{32}$' THEN
+    RAISE EXCEPTION 'metering_ip_subject_invalid';
+  END IF;
+
+  -- Media nie maja body do wydania ta droga; bez najemcy nie ma czego liczyc.
+  IF _entity_type = 'media' OR _tenant IS NULL THEN
+    RETURN QUERY SELECT false, false, 0, 0, 0, false, false,
+      NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+    RETURN;
+  END IF;
+
+  SELECT ca.mode, ca.metering_policy, ca.tenant_id, COALESCE(ca.min_tier_rank, 0)
+    INTO v_mode, v_policy, v_rule_tenant, v_min_rank
+    FROM public.content_access ca
+   WHERE ca.entity_type = _entity_type AND ca.entity_id = _entity_id;
+
+  -- Brak reguly / tresc publiczna / tryb haslowy / inny najemca - metering nie
+  -- ma tu nic do roboty (public idzie zwykla sciezka, haslo ma wlasny
+  -- odblokowywacz).
+  IF NOT FOUND OR v_mode = 'public' OR v_mode = 'password' OR v_rule_tenant IS DISTINCT FROM _tenant THEN
+    RETURN QUERY SELECT false, false, 0, 0, 0, false, false,
+      NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+    RETURN;
+  END IF;
+
+  SELECT * INTO v_settings FROM public.metering_settings ms WHERE ms.tenant_id = _tenant;
+  IF NOT FOUND OR NOT v_settings.enabled OR v_policy = 'exempt' THEN
+    RETURN QUERY SELECT false, false, 0, 0, 0, false, false,
+      NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+    RETURN;
+  END IF;
+  v_show_counter := v_settings.show_counter;
+
+  -- Uprawniony wolajacy (subskrypcja/zakup/organizacja) dostaje body bez
+  -- zuzywania licznika. Gosc nie ma auth.uid(), wiec tej galezi nie dotyczy.
+  IF _uid IS NOT NULL AND public.has_content_access(_entity_type, _entity_id) THEN
+    SELECT b.content_pl, b.content_en, b.builder_data, b.blocks_data
+      INTO v_content_pl, v_content_en, v_builder, v_blocks
+      FROM public.get_entity_content(_entity_type, _entity_id) b;
+    v_body_found := FOUND;
+    RETURN QUERY SELECT v_body_found, false, 0, 0, 0, false, v_show_counter,
+      v_content_pl, v_content_en, v_builder, v_blocks;
+    RETURN;
+  END IF;
+
+  -- P19: prog rangi wygrywa z licznikiem. Tresc „od warstwy X" nie jest
+  -- probka do przeczytania za darmo - czytajacy z ranga ponizej progu dostaje
+  -- werdykt „licznik nie dotyczy" (bez body, bez slotu), a paywall prowadzi
+  -- do warstwy. Gosc (_uid NULL) ma range warstwy domyslnej najemcy - te,
+  -- ktora dostalby po rejestracji (`user_tier_rank` dla NULL).
+  IF v_min_rank > 0 AND COALESCE(public.user_tier_rank(_uid, _tenant), 0) < v_min_rank THEN
+    RETURN QUERY SELECT false, false, 0, 0, 0, false, v_show_counter,
+      NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+    RETURN;
+  END IF;
+
+  -- Polityka 'inherit' respektuje globalne przelaczniki trybow; 'metered'
+  -- wymusza udzial niezaleznie od nich.
+  IF v_policy = 'inherit' THEN
+    IF v_mode = 'paid' AND NOT v_settings.meter_paid THEN
+      RETURN QUERY SELECT false, false, 0, 0, 0, false, v_show_counter,
+        NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+      RETURN;
+    END IF;
+    IF v_mode = 'members' AND NOT v_settings.meter_members THEN
+      RETURN QUERY SELECT false, false, 0, 0, 0, false, v_show_counter,
+        NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+      RETURN;
+    END IF;
+  END IF;
+
+  -- Tozsamosc i limit: konto (auth.uid) albo gosc z podpisanego cookie.
+  IF _uid IS NOT NULL THEN
+    v_limit := v_settings.member_monthly_limit;
+    v_subject := 'u:' || _uid::text;
+  ELSE
+    v_limit := v_settings.anon_monthly_limit;
+    v_requires_registration := v_settings.anon_monthly_limit <= 0;
+    -- Gosc bez tozsamosci od serwera albo bez skrotu adresu nie jest liczony
+    -- "w ciemno" - sciana rejestracji, jak dotad przy braku klucza goscia.
+    IF _visitor_id IS NULL OR _ip_subject IS NULL OR v_requires_registration THEN
+      INSERT INTO public.metering_event_log
+        (tenant_id, user_id, visitor_id, entity_type, entity_id, outcome, reason,
+         used_before, monthly_limit)
+      VALUES
+        (_tenant, NULL, _visitor_id, _entity_type::text, _entity_id, 'requires_registration',
+         CASE WHEN v_requires_registration THEN 'anon_limit_zero' ELSE 'no_visitor_identity' END,
+         0, v_limit);
+      RETURN QUERY SELECT false, false, 0, v_limit, GREATEST(v_limit, 0), true, v_show_counter,
+        NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+      RETURN;
+    END IF;
+    v_subject := 'v:' || _visitor_id::text;
+    -- Adresowy sufit: 5 x limit goscia (zapas na NAT), patrz naglowek
+    -- 20261013090400.
+    v_ip_limit := v_limit * 5;
+  END IF;
+
+  -- Serializacja zliczenia i wstawienia per podmiot (i per adres dla gosci).
+  -- Blokada transakcyjna - zwalnia sie sama z COMMIT/ROLLBACK. Stala kolejnosc
+  -- (podmiot, potem adres) wyklucza zakleszczenie dwoch wolan.
+  PERFORM pg_advisory_xact_lock(hashtextextended(_tenant::text || ':' || v_subject, 0));
+  IF _uid IS NULL THEN
+    PERFORM pg_advisory_xact_lock(hashtextextended(_tenant::text || ':' || _ip_subject, 0));
+  END IF;
+
+  -- Zuzycie w biezacym miesiacu + czy TEN byt juz odblokowano (ponowne
+  -- czytanie nie kosztuje) - liczone DOPIERO pod blokada.
+  IF _uid IS NOT NULL THEN
+    SELECT count(*)::integer,
+           bool_or(mv.entity_type = _entity_type AND mv.entity_id = _entity_id)
+      INTO v_used, v_already
+      FROM public.metered_views mv
+     WHERE mv.tenant_id = _tenant AND mv.user_id = _uid
+       AND mv.period_month = v_period;
+  ELSE
+    SELECT count(*)::integer,
+           bool_or(mv.entity_type = _entity_type AND mv.entity_id = _entity_id)
+      INTO v_used, v_already
+      FROM public.metered_views mv
+     WHERE mv.tenant_id = _tenant AND mv.user_id IS NULL AND mv.visitor_id = _visitor_id
+       AND mv.period_month = v_period;
+  END IF;
+  v_already := COALESCE(v_already, false);
+
+  IF NOT v_already THEN
+    IF v_used >= v_limit THEN
+      IF _uid IS NULL THEN
+        INSERT INTO public.metering_event_log
+          (tenant_id, user_id, visitor_id, entity_type, entity_id, outcome, reason,
+           used_before, monthly_limit)
+        VALUES
+          (_tenant, NULL, _visitor_id, _entity_type::text, _entity_id, 'denied',
+           'monthly_limit_reached', v_used, v_limit);
+      ELSE
+        -- Wyczerpanie limitu konta: fakt lejka najwyzej raz na konto i miesiac.
+        -- Znacznik po kluczu glownym (jedno wyszukanie indeksem), NIE szukanie
+        -- poprzednich odmow w metering_event_log - ta galaz biegnie przy kazdym
+        -- odczycie artykulu po wyczerpaniu limitu.
+        v_quota_ref := _uid::text || ':' || to_char(v_period, 'YYYY-MM');
+        BEGIN
+          v_quota_marked := NULL;
+          INSERT INTO public.revenue_event_marks (tenant_id, kind, ref)
+          VALUES (_tenant, 'quota', v_quota_ref)
+          ON CONFLICT (tenant_id, kind, ref) DO NOTHING
+          RETURNING 1 INTO v_quota_marked;
+          IF v_quota_marked IS NOT NULL THEN
+            PERFORM public.emit_domain_event(
+              _tenant, 'metering', _uid::text, 'metering.quota_exhausted.v1',
+              jsonb_build_object(
+                'user_id', _uid,
+                'period_month', to_char(v_period, 'YYYY-MM'),
+                'limit', v_limit
+              ),
+              _uid
+            );
+          END IF;
+        EXCEPTION WHEN OTHERS THEN
+          PERFORM public._log_emit_error(
+            _tenant, '_metered_view_consume', 'metering.quota_exhausted.v1', SQLSTATE, SQLERRM
+          );
+        END;
+      END IF;
+      -- Limit wyczerpany: stan licznika bez body (wariant "wykorzystano X z N").
+      RETURN QUERY SELECT false, false, v_used, v_limit, 0, false, v_show_counter,
+        NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+      RETURN;
+    END IF;
+    IF _uid IS NULL THEN
+      -- Rozne byty odblokowane z tego adresu w okresie (inny gosc z tego samego
+      -- biura czytajacy TEN artykul nie podnosi licznika adresu).
+      SELECT count(DISTINCT (mv.entity_type, mv.entity_id))::integer
+        INTO v_ip_used
+        FROM public.metered_views mv
+       WHERE mv.tenant_id = _tenant AND mv.user_id IS NULL
+         AND mv.ip_subject = _ip_subject
+         AND mv.period_month = v_period;
+      IF v_ip_used >= v_ip_limit AND NOT EXISTS (
+        SELECT 1 FROM public.metered_views mv
+         WHERE mv.tenant_id = _tenant AND mv.user_id IS NULL
+           AND mv.ip_subject = _ip_subject
+           AND mv.period_month = v_period
+           AND mv.entity_type = _entity_type AND mv.entity_id = _entity_id
+      ) THEN
+        INSERT INTO public.metering_event_log
+          (tenant_id, user_id, visitor_id, entity_type, entity_id, outcome, reason,
+           used_before, monthly_limit, metadata)
+        VALUES
+          (_tenant, NULL, _visitor_id, _entity_type::text, _entity_id, 'denied',
+           'ip_limit_reached', v_used, v_limit,
+           jsonb_build_object('ip_used', v_ip_used, 'ip_limit', v_ip_limit));
+        -- Osobny powod odmowy: wlasny limit goscia nie jest wyczerpany
+        -- (used < monthly_limit), wiec wariant "exhausted" nie pasuje,
+        -- a goly paywall nie mowi, co zrobic. requires_registration = true
+        -- kieruje na konto - ono ma wlasny licznik, poza sufitem adresu.
+        RETURN QUERY SELECT false, false, v_used, v_limit, 0, true, v_show_counter,
+          NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+        RETURN;
+      END IF;
+    END IF;
+    -- Pod blokada konflikt jest niemozliwy; ON CONFLICT DO NOTHING zostaje
+    -- jako bezpiecznik (np. wywolanie spoza rdzenia).
+    INSERT INTO public.metered_views
+      (tenant_id, user_id, visitor_id, entity_type, entity_id, ip_subject)
+    VALUES
+      (_tenant, _uid,
+       CASE WHEN _uid IS NULL THEN _visitor_id ELSE NULL END,
+       _entity_type, _entity_id,
+       CASE WHEN _uid IS NULL THEN _ip_subject ELSE NULL END)
+    ON CONFLICT DO NOTHING;
+    GET DIAGNOSTICS v_insert_count = ROW_COUNT;
+    IF v_insert_count > 0 THEN
+      v_used := v_used + 1;
+    END IF;
+  END IF;
+
+  -- "Zostalo N": konto - wlasny limit; gosc - mniejsza z dwoch liczb (wlasny
+  -- limit i sufit adresu), liczona POD ta sama blokada adresu i takze przy
+  -- ponownym czytaniu (v_already).
+  v_remaining := GREATEST(v_limit - v_used, 0);
+  IF _uid IS NULL THEN
+    SELECT count(DISTINCT (mv.entity_type, mv.entity_id))::integer
+      INTO v_ip_used
+      FROM public.metered_views mv
+     WHERE mv.tenant_id = _tenant AND mv.user_id IS NULL
+       AND mv.ip_subject = _ip_subject
+       AND mv.period_month = v_period;
+    v_remaining := GREATEST(LEAST(v_remaining, v_ip_limit - v_ip_used), 0);
+  END IF;
+
+  -- Wydanie body - identyczne ograniczenia jak get_entity_content.
+  IF _entity_type = 'post' THEN
+    SELECT p.content_pl, p.content_en, p.builder_data, p.blocks_data
+      INTO v_content_pl, v_content_en, v_builder, v_blocks
+      FROM public.posts p
+     WHERE p.id = _entity_id AND p.tenant_id = _tenant
+       AND p.status = 'published' AND p.deleted_at IS NULL;
+    v_body_found := FOUND;
+  ELSE
+    SELECT pg.content_pl, pg.content_en, pg.builder_data, NULL::jsonb
+      INTO v_content_pl, v_content_en, v_builder, v_blocks
+      FROM public.pages pg
+     WHERE pg.id = _entity_id AND pg.tenant_id = _tenant
+       AND pg.status = 'published' AND pg.deleted_at IS NULL;
+    v_body_found := FOUND;
+  END IF;
+
+  IF NOT v_body_found THEN
+    RETURN QUERY SELECT false, false, v_used, v_limit, v_remaining, false,
+      v_show_counter, NULL::text, NULL::text, NULL::jsonb, NULL::jsonb;
+    RETURN;
+  END IF;
+
+  RETURN QUERY SELECT
+    true,
+    (NOT v_already AND v_insert_count > 0),
+    v_used,
+    v_limit,
+    v_remaining,
+    false,
+    v_show_counter,
+    v_content_pl, v_content_en, v_builder, v_blocks;
+END $$;
+
+REVOKE ALL ON FUNCTION public._metered_view_consume(uuid, uuid, uuid, text, public.access_entity_type, uuid)
+  FROM PUBLIC, anon, authenticated, service_role;
+
+COMMENT ON FUNCTION public._metered_view_consume(uuid, uuid, uuid, text, public.access_entity_type, uuid) IS
+  'Wewnetrzny rdzen meteringu (bez EXECUTE dla klientow): limit miesieczny konta albo goscia, '
+  'adresowy sufit gosci (5 x anon_monthly_limit), serializacja pg_advisory_xact_lock per '
+  '<najemca>:<podmiot> (i <najemca>:<skrot adresu>) PRZED zliczeniem. P19 (hub S3): tresc '
+  'z min_tier_rank powyzej rangi czytajacego nie jest odblokowywana licznikiem. Odmowa konta '
+  'z wyczerpanym limitem -> metering.quota_exhausted.v1 raz na konto i miesiac (znacznik '
+  'revenue_event_marks kind=quota). Woluja go consume_metered_view (konto) '
+  'i consume_metered_view_visitor (service_role).';
+
+-- ----------------------------------------------------------------------------
+-- B) Telemetria odmów: tożsamość wyłącznie z sesji.
+-- ----------------------------------------------------------------------------
+-- CIALO-Z: 20260721070203
+CREATE OR REPLACE FUNCTION public.log_metering_event(
+  _entity_type text, _entity_id uuid, _outcome text,
+  _reason text DEFAULT NULL, _visitor_id uuid DEFAULT NULL,
+  _used_before integer DEFAULT NULL, _monthly_limit integer DEFAULT NULL
+) RETURNS void
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_uid uuid := auth.uid();
+BEGIN
+  IF _outcome NOT IN ('denied','granted','exempt','requires_registration') THEN
+    RAISE EXCEPTION 'invalid outcome %', _outcome;
+  END IF;
+  -- Zalogowany klient loguje WYLACZNIE siebie: klucz goscia z ladunku konta
+  -- to cudza tozsamosc (zawyzanie sciany rejestracji w raportach). Gosc ma
+  -- odmowy logowane przez rdzen po stronie serwera.
+  IF v_uid IS NOT NULL AND _visitor_id IS NOT NULL THEN
+    RAISE EXCEPTION 'metering_identity_mismatch' USING ERRCODE = '42501';
+  END IF;
+  IF _entity_type IS NOT NULL AND _entity_type NOT IN ('post', 'page', 'media') THEN
+    RAISE EXCEPTION 'metering_invalid_entity_type' USING ERRCODE = '22023';
+  END IF;
+  -- Za dlugi powod jest odrzucany, nie przycinany - dziennik ma mowic prawde.
+  IF _reason IS NOT NULL AND char_length(_reason) > 120 THEN
+    RAISE EXCEPTION 'metering_reason_too_long' USING ERRCODE = '22023';
+  END IF;
+  INSERT INTO public.metering_event_log
+    (tenant_id, user_id, visitor_id, entity_type, entity_id, outcome, reason, used_before, monthly_limit)
+  VALUES
+    (public.public_tenant_id(), v_uid, _visitor_id, _entity_type, _entity_id,
+     _outcome, _reason, _used_before, _monthly_limit);
+END $$;
+
+REVOKE ALL ON FUNCTION public.log_metering_event(text, uuid, text, text, uuid, integer, integer)
+  FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.log_metering_event(text, uuid, text, text, uuid, integer, integer)
+  TO authenticated, service_role;
+
+COMMENT ON FUNCTION public.log_metering_event(text, uuid, text, text, uuid, integer, integer) IS
+  'Telemetria odmow licznika: user_id wylacznie z auth.uid(); zalogowany klient nie podaje '
+  '_visitor_id (42501); powod <= 120 znakow (22023, bez przycinania). Konto i serwer; anon bez EXECUTE.';
diff --git a/supabase/migrations/20261020120300_checkout_events.sql b/supabase/migrations/20261020120300_checkout_events.sql
new file mode 100644
index 000000000..2d6024956
--- /dev/null
+++ b/supabase/migrations/20261020120300_checkout_events.sql
@@ -0,0 +1,147 @@
+-- ============================================================================
+-- HUB „PRZYCHÓD I LEJEK" (S3, 4/5): ZDARZENIA KASY -
+-- `checkout.started|completed|failed|abandoned.v1`.
+--
+-- DEFEKT
+--   1. Kasa nie zostawia faktów na szynie: zamówienie (`payment_orders`)
+--      zmienia status w webhooku, a lejek huba, karta zamówień w profilu
+--      i ścieżki (S5: „porzucony koszyk") widzą zmianę dopiero po
+--      przeładowaniu. Mapa inwalidacji I0 ma reguły dla tych typów -
+--      brakowało emitera.
+--   2. Porzucona kasa (P22) nie istnieje jako zdarzenie: wygasła sesja
+--      kończy się `canceled` tak samo jak anulowanie ręczne, więc ścieżka
+--      przypomnienia nie odróżniłaby „zrezygnował" od „zapomniał".
+--
+-- ZMIANA
+--   `tg_payment_orders_checkout_emit` (rejestr S3, rodzaj `trigger`) -
+--   AFTER INSERT OR UPDATE OF status ON `payment_orders`:
+--     * wyłącznie `environment = 'live'` i `provider <> 'mock'` - zamówienia
+--       testowe i atrapa kasy nie pompują lejka ani nie budzą ścieżek;
+--     * INSERT -> `checkout.started.v1` (zamówienie założone w kasie;
+--       zamówienie wstawione od razu jako `paid` dostaje też `completed`);
+--     * UPDATE statusu (`IS DISTINCT FROM`): -> `paid` = `completed`,
+--       -> `failed` = `failed`, -> `canceled` z `metadata.cancel_reason =
+--       'session_expired'` = `abandoned` (zapisuje go webhook
+--       `checkout.session.expired`, `expireCheckoutOrder`). Anulowanie bez
+--       tego powodu (zastąpiona sesja, ręczne) NIE jest porzuceniem;
+--     * payload bez PII: `order_id`, `user_id`, `kind`, `plan_id`,
+--       `tier_key` (z planu), `event_id` (z metadanych biletu), `amount_minor`,
+--       `currency`, `has_coupon`; `reason` przy `failed`/`abandoned`.
+--       Klucze z wartością NULL są pomijane (`jsonb_strip_nulls`);
+--     * agregat `checkout`, `aggregate_id` = id zamówienia, aktor = kupujący
+--       (zmianę statusu robi webhook spod `service_role`, który aktora nie ma).
+--   Każdy typ ma JEDNO wywołanie `emit_domain_event` z literałem typu (skaner
+--   katalogu, K-03). Awaria szyny nie przerywa zapisu zamówienia
+--   (`_log_emit_error`, Z-02) - webhook płatności nigdy nie pada przez lejek.
+--
+-- KOLEJNOŚĆ WDROŻENIA: po 20261020090500 (`_log_emit_error`). Kod TS
+-- zapisujący `cancel_reason` (`oneTimeFulfilment.server.ts`) może wejść przed
+-- albo po tej migracji: bez niego wygaśnięcie emituje tylko brak zdarzenia.
+-- `payment_orders` jest gorącą tabelą (webhooki) - CREATE TRIGGER pod
+-- `lock_timeout`; błąd 55P03 = ponów cały plik.
+-- IDEMPOTENTNA: CREATE OR REPLACE FUNCTION (nowa sygnatura), DROP TRIGGER IF
+-- EXISTS + CREATE TRIGGER, bezstanowe REVOKE.
+-- DOWÓD: supabase/tests/checkout_events_test.sql (4 typy, sandbox i mock bez
+-- zdarzeń, `abandoned` tylko z `session_expired`, awaria emitera nie przerywa
+-- zapisu zamówienia), src/lib/billing/__tests__/oneTimeFulfilmentExpire.test.ts.
+-- ============================================================================
+
+CREATE OR REPLACE FUNCTION public.tg_payment_orders_checkout_emit()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  v_tier text;
+  v_base jsonb;
+  v_started boolean := false;
+  v_completed boolean := false;
+  v_failed boolean := false;
+  v_abandoned boolean := false;
+  -- Typ w toku - do śladu awarii (jeden blok EXCEPTION na cztery emisje).
+  v_type text := 'checkout';
+BEGIN
+  -- Pieniądze tylko z produkcji: sandbox i atrapa kasy nie są lejkiem.
+  IF NEW.environment IS DISTINCT FROM 'live' OR NEW.provider = 'mock' THEN
+    RETURN NULL;
+  END IF;
+
+  IF TG_OP = 'INSERT' THEN
+    v_started := true;
+    v_completed := NEW.status = 'paid';
+  ELSIF NEW.status IS DISTINCT FROM OLD.status THEN
+    v_completed := NEW.status = 'paid';
+    v_failed := NEW.status = 'failed';
+    v_abandoned := NEW.status = 'canceled'
+      AND COALESCE(NEW.metadata ->> 'cancel_reason', '') = 'session_expired';
+  END IF;
+  IF NOT (v_started OR v_completed OR v_failed OR v_abandoned) THEN
+    RETURN NULL;
+  END IF;
+
+  SELECT ap.tier_key INTO v_tier FROM public.access_plans ap WHERE ap.id = NEW.plan_id;
+  v_base := jsonb_strip_nulls(jsonb_build_object(
+    'order_id', NEW.id,
+    'user_id', NEW.user_id,
+    'kind', NEW.kind,
+    'plan_id', NEW.plan_id,
+    'tier_key', v_tier,
+    'event_id', NEW.metadata ->> 'event_id',
+    'amount_minor', NEW.amount_cents,
+    'currency', NEW.currency,
+    'has_coupon', (NEW.metadata ? 'coupon_id')
+  ));
+
+  IF v_started THEN
+    v_type := 'checkout.started.v1';
+    PERFORM public.emit_domain_event(
+      NEW.tenant_id, 'checkout', NEW.id::text, 'checkout.started.v1', v_base, NEW.user_id
+    );
+  END IF;
+  IF v_completed THEN
+    v_type := 'checkout.completed.v1';
+    PERFORM public.emit_domain_event(
+      NEW.tenant_id, 'checkout', NEW.id::text, 'checkout.completed.v1', v_base, NEW.user_id
+    );
+  END IF;
+  IF v_failed THEN
+    v_type := 'checkout.failed.v1';
+    PERFORM public.emit_domain_event(
+      NEW.tenant_id, 'checkout', NEW.id::text, 'checkout.failed.v1',
+      v_base || jsonb_build_object(
+        'reason', COALESCE(NEW.metadata ->> 'failure_reason', 'payment_failed')
+      ),
+      NEW.user_id
+    );
+  END IF;
+  IF v_abandoned THEN
+    v_type := 'checkout.abandoned.v1';
+    PERFORM public.emit_domain_event(
+      NEW.tenant_id, 'checkout', NEW.id::text, 'checkout.abandoned.v1',
+      v_base || jsonb_build_object('reason', 'session_expired'),
+      NEW.user_id
+    );
+  END IF;
+  RETURN NULL;
+EXCEPTION WHEN OTHERS THEN
+  PERFORM public._log_emit_error(
+    NEW.tenant_id, 'tg_payment_orders_checkout_emit', v_type, SQLSTATE, SQLERRM
+  );
+  RETURN NULL;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.tg_payment_orders_checkout_emit() FROM PUBLIC, anon, authenticated, service_role;
+
+COMMENT ON FUNCTION public.tg_payment_orders_checkout_emit() IS
+  'Hub S3: checkout.started|completed|failed|abandoned.v1 - tylko live i nie mock; abandoned = canceled z metadata.cancel_reason=session_expired; payload bez PII; awaria szyny nie przerywa zapisu zamówienia.';
+
+SET lock_timeout = '5s';
+
+DROP TRIGGER IF EXISTS payment_orders_checkout_emit ON public.payment_orders;
+CREATE TRIGGER payment_orders_checkout_emit
+  AFTER INSERT OR UPDATE OF status ON public.payment_orders
+  FOR EACH ROW EXECUTE FUNCTION public.tg_payment_orders_checkout_emit();
+
+RESET lock_timeout;
diff --git a/supabase/migrations/20261020120400_revenue_funnel_access.sql b/supabase/migrations/20261020120400_revenue_funnel_access.sql
