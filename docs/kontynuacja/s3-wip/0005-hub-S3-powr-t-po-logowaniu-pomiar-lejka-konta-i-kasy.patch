+  authState: { session: null, loading: false } as { session: unknown; loading: boolean },
+  navigate: vi.fn(),
+  theme: "light" as "light" | "dark",
+  toggleTheme: vi.fn(),
+  settings: {} as any,
+  reg: {} as any,
