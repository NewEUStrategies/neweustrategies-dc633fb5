diff --git a/src/components/molecules/__tests__/MeterBanner.funnel.test.tsx b/src/components/molecules/__tests__/MeterBanner.funnel.test.tsx
new file mode 100644
index 000000000..3a6e89055
--- /dev/null
+++ b/src/components/molecules/__tests__/MeterBanner.funnel.test.tsx
@@ -0,0 +1,81 @@
+// MeterBanner w lejku czytelnika (S3): rejestracja z licznika wraca na ten
+// artykuł (P15: `next` + `intent=meter`), a kliknięcia CTA mierzą się
+// wyłącznie przy zgodzie analitycznej (P18).
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen } from "@testing-library/react";
+import type { AnchorHTMLAttributes, ReactNode } from "react";
+import { meterState } from "@/test/paywall/fixtures";
+import { translateKey as k } from "@/test/network/fixtures";
+
+const h = vi.hoisted(() => ({
+  session: null as { user: { id: string } } | null,
+  track: vi.fn(),
+  consent: true,
+}));
+
+vi.mock("react-i18next", async () => (await import("@/test/network/fixtures")).reactI18nextStub());
+vi.mock("@/hooks/useAuth", () => ({ useAuth: () => ({ session: h.session }) }));
+vi.mock("@tanstack/react-router", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@tanstack/react-router")>()),
+  Link: ({
+    to,
+    search,
+    children,
+    ...rest
+  }: AnchorHTMLAttributes<HTMLAnchorElement> & {
+    to: string;
+    search?: Record<string, string>;
+    children?: ReactNode;
+  }) => {
+    const query = new URLSearchParams(search ?? {}).toString();
+    return (
+      <a href={query ? `${to}?${query}` : to} {...rest}>
+        {children}
+      </a>
+    );
+  },
+}));
+vi.mock("@/lib/access/metering", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/access/metering")>()),
+  useMeterQuota: () => ({ data: undefined }),
+}));
+vi.mock("@/lib/analytics/track", () => ({ track: h.track }));
+vi.mock("@/lib/ads/consent", () => ({ hasAnalyticsConsent: () => h.consent }));
+
+import { MeterBanner } from "@/components/molecules/MeterBanner";
+
+beforeEach(() => {
+  h.session = null;
+  h.consent = true;
+  h.track.mockReset();
+  window.history.replaceState({}, "", "/analizy/tekst?utm=x");
+});
+
+describe("MeterBanner - lejek", () => {
+  it("rejestracja niesie powrót na artykuł i intencję licznika", () => {
+    render(<MeterBanner meter={meterState()} />);
+    const href = screen
+      .getByRole("link", { name: k("paywall.meter.createAccount") })
+      .getAttribute("href");
+    const url = new URL(href ?? "", "https://x.test");
+    expect(url.pathname).toBe("/login");
+    expect(url.searchParams.get("mode")).toBe("signup");
+    expect(url.searchParams.get("next")).toBe("/analizy/tekst?utm=x");
+    expect(url.searchParams.get("intent")).toBe("meter");
+  });
+
+  it("klik CTA mierzy się przy zgodzie, bez zgody - nie", () => {
+    render(<MeterBanner meter={meterState()} />);
+    fireEvent.click(screen.getByRole("link", { name: k("paywall.meter.seePlans") }));
+    expect(h.track).toHaveBeenCalledWith(
+      expect.objectContaining({
+        type: "paywall_cta_click",
+        meta: expect.objectContaining({ cta: "pricing", surface: "meter" }),
+      }),
+    );
+    h.track.mockReset();
+    h.consent = false;
+    fireEvent.click(screen.getByRole("link", { name: k("paywall.meter.createAccount") }));
+    expect(h.track).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/lib/__tests__/overlayCoordinator.invite.test.ts b/src/lib/__tests__/overlayCoordinator.invite.test.ts
new file mode 100644
index 000000000..e34efb735
--- /dev/null
+++ b/src/lib/__tests__/overlayCoordinator.invite.test.ts
@@ -0,0 +1,73 @@
+// P17 (S3): odmowa zgody marketingowej (cookies) nie wygasza ZAPROSZENIA DO
+// KONTA. Popup rejestracji (`newsletter-popup`, nazwa historyczna) jest
+// zaproszeniem - czeka na zgłoszenie stanu banera i liczy się do budżetu
+// przerw, ale odmowa marketingu go nie tłumi. Inne nakładki marketingowe -
+// jak dotąd - są tłumione.
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  __resetOverlayCoordinator,
+  cancelOverlayRequest,
+  requestOverlaySlot,
+  setMarketingConsent,
+} from "@/lib/overlayCoordinator";
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-10-19T10:00:00Z"));
+  window.localStorage.clear();
+  __resetOverlayCoordinator();
+});
+afterEach(() => {
+  __resetOverlayCoordinator();
+  vi.useRealTimers();
+});
+
+describe("overlayCoordinator - zaproszenie do konta (P17)", () => {
+  it("popup rejestracji wchodzi mimo odmowy zgody marketingowej", async () => {
+    setMarketingConsent(false);
+    const granted = vi.fn();
+    void requestOverlaySlot("newsletter-popup", { marketing: true, priority: 0 }).then(granted);
+    await vi.runOnlyPendingTimersAsync();
+    expect(granted).toHaveBeenCalledTimes(1);
+  });
+
+  it("jawna flaga `invite` działa dla dowolnego slotu", async () => {
+    setMarketingConsent(false);
+    const granted = vi.fn();
+    void requestOverlaySlot("club-invite", { marketing: true, invite: true }).then(granted);
+    await vi.runOnlyPendingTimersAsync();
+    expect(granted).toHaveBeenCalledTimes(1);
+  });
+
+  it("inna nakładka marketingowa nadal jest tłumiona odmową", async () => {
+    setMarketingConsent(false);
+    const granted = vi.fn();
+    void requestOverlaySlot("builder-popup", { marketing: true }).then(granted);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(granted).not.toHaveBeenCalled();
+    cancelOverlayRequest("builder-popup");
+  });
+
+  it("zaproszenie czeka, aż baner zgód zgłosi stan", async () => {
+    const granted = vi.fn();
+    void requestOverlaySlot("newsletter-popup", { marketing: true }).then(granted);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(granted).not.toHaveBeenCalled();
+    setMarketingConsent(false);
+    await vi.runOnlyPendingTimersAsync();
+    expect(granted).toHaveBeenCalledTimes(1);
+  });
+
+  it("zaproszenie liczy się do budżetu przerw (limit dzienny)", async () => {
+    window.localStorage.setItem(
+      "overlay:budget:v1",
+      JSON.stringify({ day: "2026-10-19", count: 3, lastTs: 0 }),
+    );
+    setMarketingConsent(false);
+    const granted = vi.fn();
+    void requestOverlaySlot("newsletter-popup", { marketing: true }).then(granted);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(granted).not.toHaveBeenCalled();
+    cancelOverlayRequest("newsletter-popup");
+  });
+});
