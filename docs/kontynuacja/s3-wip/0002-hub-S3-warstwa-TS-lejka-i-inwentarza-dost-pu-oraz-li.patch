@@ -0,0 +1,30 @@
+// Server fn inwentarza dostępu huba (S3, kontrakt §5.2).
+//
+// Bramka `requireCrmStaff` (admin/editor) = bramka SQL
+// (`is_admin_or_editor()`); inwentarz nie ma kwot, więc editor dostaje pełny
+// wynik. Najemca wyłącznie z sesji - RPC nie ma parametrów. Nazwa RPC jest
+// LITERAŁEM w miejscu wywołania (bramka `generate:ts-sql-contract`).
+import { createServerFn } from "@tanstack/react-start";
+import { requireCrmStaff } from "@/integrations/supabase/require-staff";
+import type { RpcCallable } from "@/lib/revenue/rpcCallable";
+import type { AccessInventoryRead } from "./dto";
+import { parseAccessInventory } from "./parse";
+
+/** „Funkcji jeszcze nie ma w tej bazie" - okno wdrożenia, nie awaria. */
+const MISSING_SOURCE = new Set(["42883", "PGRST202"]);
+
+export const getRevenueAccessInventory = createServerFn({ method: "POST" })
+  .middleware([requireCrmStaff])
+  .handler(async ({ context }): Promise<AccessInventoryRead> => {
+    const { data: raw, error } = await (context.supabase as unknown as RpcCallable).rpc(
+      "admin_revenue_access_inventory",
+    );
+    if (error) {
+      if (error.code === "42501") return { state: "forbidden" };
+      if (error.code !== undefined && MISSING_SOURCE.has(error.code)) {
+        return { state: "unavailable" };
+      }
+      throw new Error(error.message);
+    }
+    return { state: "ready", inventory: parseAccessInventory(raw) };
+  });
diff --git a/src/lib/revenue/access/dto.ts b/src/lib/revenue/access/dto.ts
new file mode 100644
index 000000000..8c85553f2
--- /dev/null
+++ b/src/lib/revenue/access/dto.ts
@@ -0,0 +1,70 @@
+// KSZTAŁT INWENTARZA DOSTĘPU HUBA „PRZYCHÓD I LEJEK" (S3, kontrakt §5.2).
+//
+// MODUŁ CZYSTO TYPOWY - zero wartości w runtime. Inwentarz nie ma kwot, więc
+// admin i editor dostają ten sam wynik (SPEC §2.5: Dostęp - pełny dla obu).
+import type { PaywallHitReason } from "@/lib/revenue/limits";
+
+/** Tryb reguły `content_access.mode`. */
+export type AccessInventoryMode = "public" | "members" | "paid" | "password";
+/** Polityka licznika `content_access.metering_policy`. */
+export type AccessInventoryPolicy = "inherit" | "metered" | "exempt";
+/** Typ treści z regułą (`access_entity_type`). */
+export type AccessInventoryEntity = "post" | "page" | "media";
+
+/** Jedna komórka: typ × tryb × próg rangi × polityka licznika. */
+export interface AccessInventoryRow {
+  entityType: AccessInventoryEntity;
+  mode: AccessInventoryMode;
+  minTierRank: number;
+  meteringPolicy: AccessInventoryPolicy;
+  count: number;
+}
+
+/** Warstwa najemcy i to, czy da się ją dziś kupić. */
+export interface AccessInventoryTier {
+  key: string;
+  rank: number;
+  active: boolean;
+  pricingVisible: boolean;
+  /** `auto` | `contact` | `none` (`tierCtaMode`); `null` = brak ustawienia. */
+  ctaMode: string | null;
+  /** Aktywny plan w sprzedaży + widoczna w cenniku + przycisk kasy. */
+  offerable: boolean;
+}
+
+/** Ślepe zaułki i ryzyka polityki dostępu (P14, P19, plany spoza sprzedaży). */
+export interface AccessInventoryDeadEnds {
+  /** Próg warstwy, której nie da się kupić (zalogowany za nisko bez oferty). */
+  tierWithoutOffer: number;
+  /** Treść płatna bez progu, ceny jednorazowej i planu w sprzedaży. */
+  paidWithoutOffer: number;
+  /** Reguły wskazujące plan nieaktywny, wycofany albo usunięty. */
+  danglingPlans: number;
+  /** Treści z progiem objęte licznikiem - P19 wyłącza z nich licznik. */
+  meteredTierGated: number;
+}
+
+export interface AccessInventoryHits {
+  reason: PaywallHitReason;
+  accounts: number;
+  visitors: number;
+  hits: number;
+}
+
+export interface AccessInventoryDto {
+  computedAt: string;
+  total: number;
+  rows: AccessInventoryRow[];
+  byMode: Record<AccessInventoryMode, number>;
+  tiers: AccessInventoryTier[];
+  deadEnds: AccessInventoryDeadEnds;
+  /** Powody uderzeń w paywall z ostatnich 30 dni. */
+  hits30d: AccessInventoryHits[];
+}
+
+export type AccessInventoryRead =
+  | { state: "ready"; inventory: AccessInventoryDto }
+  /** 42501 - rola bez dostępu do inwentarza (autor). */
+  | { state: "forbidden" }
+  /** Funkcji jeszcze nie ma w bazie (migracja w drodze). */
+  | { state: "unavailable" };
diff --git a/src/lib/revenue/access/parse.ts b/src/lib/revenue/access/parse.ts
new file mode 100644
index 000000000..fb7ff46e6
--- /dev/null
+++ b/src/lib/revenue/access/parse.ts
@@ -0,0 +1,162 @@
+// JSONB `admin_revenue_access_inventory` -> `AccessInventoryDto`.
+//
+// Parser RZUCA przy złym kształcie (jak lejek i zdrowie e-mail): zero
+// w inwentarzu jest wynikiem („0 ślepych zaułków"), więc pole brakujące albo
+// zdeformowane nie może po cichu zamienić się w zero.
+import { PAYWALL_HIT_REASONS, type PaywallHitReason } from "@/lib/revenue/limits";
+import type {
+  AccessInventoryDto,
+  AccessInventoryEntity,
+  AccessInventoryHits,
+  AccessInventoryMode,
+  AccessInventoryPolicy,
+  AccessInventoryRow,
+  AccessInventoryTier,
+} from "./dto";
+
+// rpc-shape: admin_revenue_access_inventory
+export const ACCESS_INVENTORY_KEYS = {
+  root: ["computed_at", "total", "rows", "by_mode", "tiers", "dead_ends", "hits_30d"],
+  row: ["entity_type", "mode", "min_tier_rank", "metering_policy", "count"],
+  tier: ["key", "rank", "active", "pricing_visible", "cta_mode", "offerable"],
+  deadEnds: ["tier_without_offer", "paid_without_offer", "dangling_plans", "metered_tier_gated"],
+  hits: ["reason", "accounts", "visitors", "hits"],
+} as const;
+
+export const ACCESS_MODES: readonly AccessInventoryMode[] = [
+  "public",
+  "members",
+  "paid",
+  "password",
+];
+const POLICIES: readonly AccessInventoryPolicy[] = ["inherit", "metered", "exempt"];
+const ENTITIES: readonly AccessInventoryEntity[] = ["post", "page", "media"];
+
+export class AccessInventoryShapeError extends Error {
+  readonly path: string;
+
+  constructor(path: string, reason: string) {
+    super(`admin_revenue_access_inventory: ${path} - ${reason}`);
+    this.name = "AccessInventoryShapeError";
+    this.path = path;
+  }
+}
+
+type Bag = Readonly<Record<string, unknown>>;
+
+function isBag(value: unknown): value is Bag {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function fail(path: string, reason: string): never {
+  throw new AccessInventoryShapeError(path, reason);
+}
+
+function count(source: Bag, path: string, key: string): number {
+  if (!(key in source)) fail(`${path}${key}`, "brak pola");
+  const value = source[key];
+  const parsed =
+    typeof value === "number"
+      ? value
+      : typeof value === "string" && /^\d+$/.test(value.trim())
+        ? Number(value)
+        : Number.NaN;
+  if (!Number.isSafeInteger(parsed) || parsed < 0) {
+    fail(`${path}${key}`, "oczekiwano liczby całkowitej >= 0");
+  }
+  return parsed;
+}
+
+function flag(source: Bag, path: string, key: string): boolean {
+  const value = source[key];
+  if (typeof value !== "boolean") fail(`${path}${key}`, "oczekiwano boolean");
+  return value;
+}
+
+function member<T extends string>(value: unknown, allowed: readonly T[], path: string): T {
+  if (typeof value !== "string" || !(allowed as readonly string[]).includes(value)) {
+    fail(path, `oczekiwano jednej z: ${allowed.join(", ")}`);
+  }
+  return value as T;
+}
+
+function array(source: Bag, key: string): readonly unknown[] {
+  const value = source[key];
+  if (!Array.isArray(value)) fail(key, "oczekiwano tablicy");
+  return value;
+}
+
+function rows(raw: Bag): AccessInventoryRow[] {
+  return array(raw, "rows").map((entry, i) => {
+    const path = `rows[${i}].`;
+    if (!isBag(entry)) fail(path, "oczekiwano obiektu");
+    return {
+      entityType: member(entry.entity_type, ENTITIES, `${path}entity_type`),
+      mode: member(entry.mode, ACCESS_MODES, `${path}mode`),
+      minTierRank: count(entry, path, "min_tier_rank"),
+      meteringPolicy: member(entry.metering_policy, POLICIES, `${path}metering_policy`),
+      count: count(entry, path, "count"),
+    };
+  });
+}
+
+function tiers(raw: Bag): AccessInventoryTier[] {
+  return array(raw, "tiers").map((entry, i) => {
+    const path = `tiers[${i}].`;
+    if (!isBag(entry) || typeof entry.key !== "string") fail(`${path}key`, "oczekiwano napisu");
+    const cta = entry.cta_mode;
+    if (cta !== null && typeof cta !== "string") fail(`${path}cta_mode`, "oczekiwano napisu");
+    return {
+      key: entry.key,
+      rank: count(entry, path, "rank"),
+      active: flag(entry, path, "active"),
+      pricingVisible: flag(entry, path, "pricing_visible"),
+      ctaMode: (cta as string | null) ?? null,
+      offerable: flag(entry, path, "offerable"),
+    };
+  });
+}
+
+function hits(raw: Bag): AccessInventoryHits[] {
+  return array(raw, "hits_30d").map((entry, i) => {
+    const path = `hits_30d[${i}].`;
+    if (!isBag(entry)) fail(path, "oczekiwano obiektu");
+    return {
+      reason: member<PaywallHitReason>(entry.reason, PAYWALL_HIT_REASONS, `${path}reason`),
+      accounts: count(entry, path, "accounts"),
+      visitors: count(entry, path, "visitors"),
+      hits: count(entry, path, "hits"),
+    };
+  });
+}
+
+export function parseAccessInventory(raw: unknown): AccessInventoryDto {
+  if (!isBag(raw)) fail("$", "oczekiwano obiektu");
+  const computedAt = raw.computed_at;
+  if (typeof computedAt !== "string" || Number.isNaN(Date.parse(computedAt))) {
+    fail("computed_at", "oczekiwano znacznika czasu ISO");
+  }
+  const byModeRaw = raw.by_mode;
+  if (!isBag(byModeRaw)) fail("by_mode", "oczekiwano obiektu");
+  const deadRaw = raw.dead_ends;
+  if (!isBag(deadRaw)) fail("dead_ends", "oczekiwano obiektu");
+  return {
+    computedAt,
+    total: count(raw, "", "total"),
+    rows: rows(raw),
+    byMode: {
+      public: count(byModeRaw, "by_mode.", "public"),
+      members: count(byModeRaw, "by_mode.", "members"),
+      paid: count(byModeRaw, "by_mode.", "paid"),
+      password: count(byModeRaw, "by_mode.", "password"),
+    },
+    tiers: tiers(raw),
+    deadEnds: {
+      tierWithoutOffer: count(deadRaw, "dead_ends.", "tier_without_offer"),
+      paidWithoutOffer: count(deadRaw, "dead_ends.", "paid_without_offer"),
+      danglingPlans: count(deadRaw, "dead_ends.", "dangling_plans"),
+      meteredTierGated: count(deadRaw, "dead_ends.", "metered_tier_gated"),
+    },
+    hits30d: hits(raw),
+  };
+}
