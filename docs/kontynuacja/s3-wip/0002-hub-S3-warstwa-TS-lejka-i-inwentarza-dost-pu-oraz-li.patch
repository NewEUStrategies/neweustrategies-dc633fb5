+// `queryOptions` lejka (S3, §5.4): klucz z fabryki I0 z segmentem i torem,
+// świeżość zależna od domknięcia okna, wyłączenie bez najemcy.
+import { keepPreviousData } from "@tanstack/react-query";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { revenueKeys } from "@/lib/revenue/keys";
+
+const h = vi.hoisted(() => ({ getRevenueFunnel: vi.fn() }));
+
+vi.mock("@/lib/revenue/funnel/funnel.functions", () => ({
+  getRevenueFunnel: h.getRevenueFunnel,
+}));
+
+import {
+  FUNNEL_GC_MS,
+  FUNNEL_STALE_COMPLETE_MS,
+  FUNNEL_STALE_OPEN_MS,
+  revenueFunnelQueryOptions,
+} from "@/lib/revenue/funnel/queries";
+
+const TENANT = "tenant-1";
+
+function range(complete: boolean) {
+  return {
+    period: "month" as const,
+    current: { sinceIso: "2026-09-01T00:00:00.000Z", untilIso: "2026-10-01T00:00:00.000Z" },
+    complete,
+  };
+}
+
+beforeEach(() => {
+  h.getRevenueFunnel.mockReset();
+  h.getRevenueFunnel.mockResolvedValue({ state: "forbidden" });
+});
+
+describe("revenueFunnelQueryOptions", () => {
+  it("klucz = revenueKeys.query('funnel', najemca, okno, {segment, track})", () => {
+    const options = revenueFunnelQueryOptions(TENANT, range(false), {
+      segment: "b2c_reduced",
+      track: "sales",
+    });
+    expect(options.queryKey).toEqual(
+      revenueKeys.query("funnel", TENANT, range(false), { segment: "b2c_reduced", track: "sales" }),
+    );
+    // Prefiks reguł szyny (`funK`) trafia w każde okno i tor.
+    expect(options.queryKey.slice(0, 3)).toEqual(revenueKeys.domainTenant("funnel", TENANT));
+  });
+
+  it("domyślny segment i tor są w kluczu jawnie (ten sam odczyt = ten sam klucz)", () => {
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).queryKey).toEqual(
+      revenueFunnelQueryOptions(TENANT, range(false), { segment: "all", track: "all" }).queryKey,
+    );
+  });
+
+  it("okno otwarte 60 s, domknięte 30 min; gc 10 min; jedno ponowienie", () => {
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).staleTime).toBe(FUNNEL_STALE_OPEN_MS);
+    expect(revenueFunnelQueryOptions(TENANT, range(true)).staleTime).toBe(FUNNEL_STALE_COMPLETE_MS);
+    expect(FUNNEL_STALE_OPEN_MS).toBe(60_000);
+    expect(FUNNEL_STALE_COMPLETE_MS).toBe(30 * 60_000);
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).gcTime).toBe(FUNNEL_GC_MS);
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).retry).toBe(1);
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).placeholderData).toBe(keepPreviousData);
+  });
+
+  it("bez najemcy zapytanie jest wyłączone", () => {
+    expect(revenueFunnelQueryOptions(null, range(false)).enabled).toBe(false);
+    expect(revenueFunnelQueryOptions(TENANT, range(false)).enabled).toBe(true);
+  });
+
+  it("queryFn woła server fn z granicami okna, segmentem i torem", async () => {
+    const options = revenueFunnelQueryOptions(TENANT, range(false), { track: "self_serve" });
+    await (options.queryFn as () => Promise<unknown>)();
+    expect(h.getRevenueFunnel).toHaveBeenCalledWith({
+      data: {
+        sinceIso: "2026-09-01T00:00:00.000Z",
+        untilIso: "2026-10-01T00:00:00.000Z",
+        segment: "all",
+        track: "self_serve",
+      },
+    });
+  });
+});
diff --git a/src/lib/revenue/funnel/dto.ts b/src/lib/revenue/funnel/dto.ts
new file mode 100644
index 000000000..eb8b33b0b
--- /dev/null
+++ b/src/lib/revenue/funnel/dto.ts
@@ -0,0 +1,105 @@
+// KSZTAŁT LEJKA CZYTELNIKA HUBA „PRZYCHÓD I LEJEK" (S3, kontrakt §4.2/§5.2).
+//
+// MODUŁ CZYSTO TYPOWY - zero wartości w runtime, więc import typu z tego
+// pliku (karty huba S7, migawka S6) nie zmienia grafu chunków.
+//
+// `null` ≠ 0. Agregat SQL (`admin_revenue_funnel`) oddaje `null` tam, gdzie
+// liczby NIE DA SIĘ policzyć: ułamek bez mianownika (nikt nie uderzył
+// w paywall, nikt nie zaczął płatności), kwoty dla roli bez prawa do kwot
+// (editor). Liczności są zawsze liczbą (0 = zmierzyliśmy zero).
+import type { MoneyByCurrency } from "@/lib/revenue/money";
+import type { PaywallHitReason } from "@/lib/revenue/limits";
+import type { RevenueSegment, RevenueTrack } from "@/lib/revenue/search";
+import type { SalesFunnelStage, SignupSource } from "./funnelStages";
+
+/** Ułamki w [0, 1]; `null` = zerowy mianownik. */
+export interface RevenueFunnelRates {
+  /** R2P: konta z okna, które zapłaciły ÷ konta z okna. */
+  registeredToPaid: number | null;
+  /** PSCR: konta, które zapłaciły po uderzeniu w paywall ÷ konta z uderzeniem. */
+  paywallConversion: number | null;
+  /** PHR: konta z uderzeniem ÷ aktywne konta. */
+  paywallHit: number | null;
+  /** CCR: zamówienia z okna opłacone ÷ zamówienia z okna. */
+  checkoutConversion: number | null;
+  /** CAR = 1 - CCR (ta sama kohorta). */
+  checkoutAbandonment: number | null;
+  /** Kody kampanii użyte w opłaconym zamówieniu ÷ kody wydane. */
+  couponRedemption: number | null;
+}
+
+export interface RevenueFunnelSignupSource {
+  source: SignupSource;
+  accounts: number;
+}
+
+export interface RevenueFunnelPaywallReason {
+  reason: PaywallHitReason;
+  accounts: number;
+  visitors: number;
+  hits: number;
+}
+
+/** Tor samoobsługowy (`_funnel_counts`). */
+export interface RevenueFunnelSelfServe {
+  accounts: number;
+  activeAccounts: number;
+  paywallHitAccounts: number;
+  paywallHitVisitors: number;
+  paywallHits: number;
+  paywallConvertedAccounts: number;
+  checkoutStarted: number;
+  checkoutPaid: number;
+  /** Zamówienia z okna bez sukcesu (= started - paid). */
+  checkoutAbandoned: number;
+  /** Z nich - sesja kasy wygasła (porzucony koszyk). */
+  checkoutExpired: number;
+  firstPayments: number;
+  registeredPaid: number;
+  signupFormViews: number;
+  signupFormSubmits: number;
+  /** Strumień zgody analitycznej - obok lejka, nigdy jako mianownik. */
+  visitorsFirstParty: number;
+  rates: RevenueFunnelRates;
+  /** Kwoty opłaconej kohorty per waluta; `null` = rola bez kwot. */
+  paidAmount: MoneyByCurrency[] | null;
+  signupSources: RevenueFunnelSignupSource[];
+  paywallReasons: RevenueFunnelPaywallReason[];
+  /** Pierwszy pomiar paywalla najemcy (ISO); `null` = jeszcze ani jednego. */
+  paywallDataSince: string | null;
+}
+
+/** Tor sprzedaży (historia etapów cyklu życia w CRM). */
+export interface RevenueFunnelSales {
+  stages: { stage: SalesFunnelStage; leads: number }[];
+  /** Zadania otwarte (bez anulowanych - D11). */
+  openTasks: number;
+  overdueTasks: number;
+  /** Zadania zamknięte w oknie. */
+  doneTasks: number;
+}
+
+export interface RevenueFunnelDto {
+  /** Echo okna `[since, until)` z bazy. */
+  since: string;
+  until: string;
+  segment: RevenueSegment;
+  track: RevenueTrack;
+  /** Czy rola widzi kwoty (admin). Editor: `false`, a `paidAmount` = `null`. */
+  amountsVisible: boolean;
+  /** `null`, gdy tor nie obejmuje samoobsługi. */
+  selfServe: RevenueFunnelSelfServe | null;
+  /** `null`, gdy tor nie obejmuje sprzedaży. */
+  sales: RevenueFunnelSales | null;
+}
+
+/**
+ * Wynik odczytu dla panelu. Odmowa roli i brak funkcji w bazie są STANAMI
+ * karty, a nie wyjątkami: ponowienie ich nie naprawi.
+ */
+export type RevenueFunnelRead =
+  | { state: "ready"; funnel: RevenueFunnelDto }
+  /** 42501 - rola bez dostępu do lejka (autor). */
+  | { state: "forbidden" }
+  /** Funkcji jeszcze nie ma w bazie (migracja w drodze). */
+  | { state: "unavailable" };
diff --git a/src/lib/revenue/funnel/funnel.functions.ts b/src/lib/revenue/funnel/funnel.functions.ts
new file mode 100644
index 000000000..daf2c303b
--- /dev/null
+++ b/src/lib/revenue/funnel/funnel.functions.ts
@@ -0,0 +1,75 @@
+// Server fn lejka czytelnika huba (S3, kontrakt §5.2).
+//
+// Bramka `requireCrmStaff` (admin/editor + aal2 dla kont z MFA) = bramka SQL
+// (`is_admin_or_editor()`): autor odpada już w middleware, a tor `sales`
+// (dane CRM) dostaje drugi czynnik tym samym middleware. Kwoty rozstrzyga
+// SQL (`paid_amount` = NULL dla editora) - serwer niczego nie dopisuje.
+// Najemca NIGDY nie idzie w parametrach - RPC bierze go z sesji
+// (`current_tenant_id()`), a klient użytkownika (`context.supabase`) niesie
+// tę sesję.
+//
+// Nazwa RPC jest LITERAŁEM w miejscu wywołania: bramka
+// `generate:ts-sql-contract` czyta ją ze źródła i sprawdza grant dla roli
+// `authenticated`. Rzutowanie na `RpcCallable` - sygnatury funkcji huba
+// dopisuje do `types.ts` dopiero I9 (N19).
+import { createServerFn } from "@tanstack/react-start";
+import { z } from "zod";
+import { requireCrmStaff } from "@/integrations/supabase/require-staff";
+import type { RpcCallable } from "@/lib/revenue/rpcCallable";
+import { REVENUE_SEGMENTS, REVENUE_TRACKS } from "@/lib/revenue/search";
+import type { RevenueFunnelRead } from "./dto";
+import { parseRevenueFunnel } from "./parse";
+
+/**
+ * Najdłuższe okno, jakie przyjmuje agregat (SQL: 22023 `window_invalid`).
+ * Ta sama wartość co `REVENUE_CUSTOM_COMPARE_MAX_DAYS` (test parytetu) -
+ * tu bez importu `window.ts`, bo ten ciągnie arytmetykę pulpitu do modułu,
+ * który przeglądarka zna tylko jako zaślepkę wywołania.
+ */
+export const FUNNEL_MAX_WINDOW_DAYS = 400;
+
+const DAY_MS = 86_400_000;
+
+/** „Funkcji jeszcze nie ma w tej bazie" - okno wdrożenia, nie awaria. */
+const MISSING_SOURCE = new Set(["42883", "PGRST202"]);
+
+const FunnelInput = z
+  .object({
+    sinceIso: z.string().datetime({ offset: true }),
+    untilIso: z.string().datetime({ offset: true }),
+    segment: z.enum(REVENUE_SEGMENTS).default("all"),
+    track: z.enum(REVENUE_TRACKS).default("all"),
+  })
+  .refine((w) => Date.parse(w.untilIso) > Date.parse(w.sinceIso), {
+    message: "window_invalid",
+  })
+  .refine(
+    (w) => Date.parse(w.untilIso) - Date.parse(w.sinceIso) <= FUNNEL_MAX_WINDOW_DAYS * DAY_MS,
+    { message: "window_invalid" },
+  );
+
+export type FunnelInput = z.input<typeof FunnelInput>;
+
+export const getRevenueFunnel = createServerFn({ method: "POST" })
+  .middleware([requireCrmStaff])
+  .validator((input: unknown) => FunnelInput.parse(input))
+  .handler(async ({ data, context }): Promise<RevenueFunnelRead> => {
+    const { data: raw, error } = await (context.supabase as unknown as RpcCallable).rpc(
+      "admin_revenue_funnel",
+      {
+        p_since: data.sinceIso,
+        p_until: data.untilIso,
+        p_segment: data.segment,
+        p_track: data.track,
+      },
+    );
+    if (error) {
+      // Odmowa roli to stan karty, nie wyjątek: ponowienie jej nie naprawi.
+      if (error.code === "42501") return { state: "forbidden" };
+      if (error.code !== undefined && MISSING_SOURCE.has(error.code)) {
+        return { state: "unavailable" };
+      }
+      throw new Error(error.message);
+    }
+    return { state: "ready", funnel: parseRevenueFunnel(raw) };
+  });
diff --git a/src/lib/revenue/funnel/funnelStages.ts b/src/lib/revenue/funnel/funnelStages.ts
new file mode 100644
index 000000000..891d7a2b4
--- /dev/null
+++ b/src/lib/revenue/funnel/funnelStages.ts
@@ -0,0 +1,156 @@
+// ETAPY LEJKA CZYTELNIKA HUBA „PRZYCHÓD I LEJEK" (S3) - kontrakt kroków,
+// źródeł rejestracji i etapów toru sprzedaży.
+//
+// JEDNO ŹRÓDŁO KOLEJNOŚCI. Mapa lejka (S7, `FunnelStageMap`), kafle kokpitu
+// i migawka BI czytają tę samą listę: inaczej każdy ekran układałby kroki po
+// swojemu, a „konwersja paywalla" w kokpicie znaczyłaby co innego niż na
+// zakładce Lejek.
+//
+// STRUMIEŃ PRZY KAŻDYM KROKU. Odwiedzający pochodzą z analityki ze zgodą
+// (`first_party`), reszta - z księgi (`lifecycle`). Iloraz przez granicę
+// strumieni dzieliłby dwie różne populacje, więc `FunnelBars` pokazuje tam
+// powód zamiast procentu (reguła `assertSameStreamRatio`, S6) - stąd pole
+// `stream` w definicji, a nie w komponencie.
+//
+// LIŚĆ BEZ IMPORTÓW RUNTIME (wyłącznie `import type`): moduł czytają serwer,
+// testy i panel; nie może wciągnąć klienta bazy ani React Query.
+import type { MetricId } from "@/lib/analytics/semantic/metrics";
+import type { StreamId } from "@/lib/analytics/semantic/streams";
+import type { RevenueFunnelDto, RevenueFunnelSelfServe } from "./dto";
+
+/** Kroki lejka samoobsługowego w kolejności mapy. */
+export const REVENUE_FUNNEL_STAGES = [
+  "visitors",
+  "accounts",
+  "paywall",
+  "checkout",
+  "paid",
+] as const;
+export type RevenueFunnelStage = (typeof REVENUE_FUNNEL_STAGES)[number];
+
+/** Liczba kroku w DTO - nazwa pola, żeby definicja nie duplikowała parsera. */
+type CountField = Extract<
+  keyof RevenueFunnelSelfServe,
+  "visitorsFirstParty" | "accounts" | "paywallHitAccounts" | "checkoutStarted" | "checkoutPaid"
+>;
+
+export interface RevenueFunnelStageDef {
+  readonly stage: RevenueFunnelStage;
+  readonly count: CountField;
+  readonly stream: Extract<StreamId, "first_party" | "lifecycle">;
+  /**
+   * Odwiedzający są obok lejka, NIGDY mianownikiem: to inna populacja
+   * (tylko osoby ze zgodą analityczną), a nie „pierwszy krok" tych samych ludzi.
+   */
+  readonly separate: boolean;
+  /** Wskaźnik rejestru S6, który opisuje przejście DO tego kroku. */
+  readonly metricId: MetricId | null;
+}
+
+export const REVENUE_FUNNEL_STAGE_DEFS: readonly RevenueFunnelStageDef[] = [
+  {
+    stage: "visitors",
+    count: "visitorsFirstParty",
+    stream: "first_party",
+    separate: true,
+    metricId: null,
+  },
+  { stage: "accounts", count: "accounts", stream: "lifecycle", separate: false, metricId: null },
+  {
+    stage: "paywall",
+    count: "paywallHitAccounts",
+    stream: "lifecycle",
+    separate: false,
+    metricId: "paywall_hit_rate",
+  },
+  // Start kasy liczy ZAMÓWIENIA, uderzenia w paywall - KONTA: iloraz tych
+  // dwóch liczb nie jest żadnym wskaźnikiem, więc krok nie ma ani udziału,
+  // ani wskaźnika. Konwersję paywalla (PSCR) pokazuje para z PHR.
+  {
+    stage: "checkout",
+    count: "checkoutStarted",
+    stream: "lifecycle",
+    separate: false,
+    metricId: null,
+  },
+  {
+    stage: "paid",
+    count: "checkoutPaid",
+    stream: "lifecycle",
+    separate: false,
+    metricId: "checkout_conversion_rate",
+  },
+];
+
+/**
+ * Źródła rejestracji z białej listy `account.registered.v1` - LUSTRO listy
+ * w migracji 20261020120000 (i w `_funnel_counts`). Test parytetu czyta obie
+ * migracje: źródło dopisane tylko tutaj dawałoby w hubie zawsze zero,
+ * dopisane tylko w SQL - surowy klucz w panelu.
+ */
+export const SIGNUP_SOURCES = [
+  "auth_page",
+  "login_popup",
+  "popup",
+  "club_gate",
+  "register_widget",
+  "paywall",
+  "pricing",
+  "checkout",
+  "club_apply",
+  "join_us_form",
+] as const;
+export type SignupSource = (typeof SIGNUP_SOURCES)[number] | "unknown";
+
+export function isSignupSource(raw: unknown): raw is SignupSource {
+  return raw === "unknown" || (SIGNUP_SOURCES as readonly unknown[]).includes(raw);
+}
+
+/** Etapy toru sprzedaży (historia `lifecycle` w CRM) w kolejności lejka. */
+export const SALES_FUNNEL_STAGES = ["lead", "mql", "sql", "opportunity", "customer"] as const;
+export type SalesFunnelStage = (typeof SALES_FUNNEL_STAGES)[number];
+
+/**
+ * Para wskaźników paywalla - zasięg (PHR) i konwersja (PSCR) zawsze razem:
+ * sam wysoki zasięg nie mówi, czy ściana sprzedaje, a sama konwersja - na
+ * jak małej próbie stoi (SPEC §2.2, zakładka Lejek).
+ */
+export const PAYWALL_PAIR_METRICS = ["paywall_hit_rate", "paywall_conversion_rate"] as const;
+
+/** Krok gotowy do narysowania (`FunnelBars`) - bez etykiety (tłumaczy panel). */
+export interface RevenueFunnelStep {
+  readonly stage: RevenueFunnelStage;
+  readonly value: number | null;
+  /** Udział w poprzednim kroku tego samego strumienia; `null` = brak mianownika. */
+  readonly rate: number | null;
+  readonly stream: RevenueFunnelStageDef["stream"];
+  readonly separate: boolean;
+  readonly metricId: MetricId | null;
+}
+
+/**
+ * Kroki lejka z DTO. Udział liczony WYŁĄCZNIE wewnątrz strumienia księgi;
+ * dla przejść, które SQL liczy kohortowo (zasięg paywalla względem AKTYWNYCH
+ * kont, konwersja kasy na kohorcie startu), bierzemy ułamek z SQL, a nie
+ * prosty iloraz sąsiednich liczb - inaczej mapa pokazywałaby inną liczbę niż
+ * kafel tego samego wskaźnika.
+ */
+export function revenueFunnelSteps(dto: RevenueFunnelDto | null): RevenueFunnelStep[] {
+  const self = dto?.selfServe ?? null;
+  return REVENUE_FUNNEL_STAGE_DEFS.map((def) => {
+    const value = self ? self[def.count] : null;
+    let rate: number | null = null;
+    if (self) {
+      if (def.stage === "paywall") rate = self.rates.paywallHit;
+      else if (def.stage === "paid") rate = self.rates.checkoutConversion;
+    }
+    return {
+      stage: def.stage,
+      value,
+      rate,
+      stream: def.stream,
+      separate: def.separate,
+      metricId: def.metricId,
+    };
+  });
+}
diff --git a/src/lib/revenue/funnel/parse.ts b/src/lib/revenue/funnel/parse.ts
new file mode 100644
index 000000000..d654ad467
--- /dev/null
+++ b/src/lib/revenue/funnel/parse.ts
@@ -0,0 +1,247 @@
+// JSONB `admin_revenue_funnel` -> `RevenueFunnelDto`, pole po polu.
+//
+// PARSER RZUCA, A NIE ZERUJE (jak `revenue/email/parse.ts`). Tu zero jest
+// WYNIKIEM („0 porzuconych kas"), a `null` znaczy „nie da się policzyć" -
+// parser, który zamienia brak albo śmieć w 0, zamazałby dokładnie tę różnicę.
+// Zły kształt to rozjazd kontraktu SQL <-> TS, więc ma być głośny.
+//
+// Wyjątek świadomy: tor. Pola samoobsługi są w odpowiedzi tylko dla toru
+// `self_serve|all`, a `sales` jest `null` dla `self_serve` - to kształt
+// kontraktu, nie brak danych, więc parser czyta tor z odpowiedzi i wymaga
+// dokładnie tych sekcji, które tor obiecuje.
+//
+// Moduł bez zależności runtime poza listami (liście bez importów): czyta go
+// też migawka huba (S6) po stronie serwera, a test parytetu porównuje
+// `FUNNEL_KEYS` z treścią migracji (`-- rpc-shape`).
+import { PAYWALL_HIT_REASONS, type PaywallHitReason } from "@/lib/revenue/limits";
+import { parseMoneyByCurrency } from "@/lib/revenue/money";
+import {
+  REVENUE_SEGMENTS,
+  REVENUE_TRACKS,
+  type RevenueSegment,
+  type RevenueTrack,
+} from "@/lib/revenue/search";
+import type {
+  RevenueFunnelDto,
+  RevenueFunnelPaywallReason,
+  RevenueFunnelSales,
+  RevenueFunnelSelfServe,
+  RevenueFunnelSignupSource,
+} from "./dto";
+import { SALES_FUNNEL_STAGES, isSignupSource, type SalesFunnelStage } from "./funnelStages";
+
+// rpc-shape: admin_revenue_funnel
+export const FUNNEL_KEYS = {
+  root: ["since", "until", "segment", "track", "amounts_visible", "sales"],
+  counts: [
+    "accounts",
+    "active_accounts",
+    "paywall_hit_accounts",
+    "paywall_hit_visitors",
+    "paywall_hits",
+    "paywall_converted_accounts",
+    "checkout_started",
+    "checkout_paid",
+    "checkout_abandoned",
+    "checkout_expired",
+    "first_payments",
+    "registered_paid",
+    "signup_form_views",
+    "signup_form_submits",
+    "visitors_first_party",
+  ],
+  fractions: [
+    "registered_to_paid_rate",
+    "paywall_conversion_rate",
+    "paywall_hit_rate",
+    "checkout_conversion_rate",
+    "checkout_abandonment_rate",
+    "coupon_redemption_rate",
+  ],
+  lists: ["paid_amount", "signup_sources", "paywall_reasons", "paywall_data_since"],
+  sales: ["stages", "open_tasks", "overdue_tasks", "done_tasks"],
+} as const;
+
+/** Rozjazd kontraktu RPC: ścieżka pola i powód. */
+export class RevenueFunnelShapeError extends Error {
+  readonly path: string;
+
+  constructor(path: string, reason: string) {
+    super(`admin_revenue_funnel: ${path} - ${reason}`);
+    this.name = "RevenueFunnelShapeError";
+    this.path = path;
+  }
+}
+
+type Bag = Readonly<Record<string, unknown>>;
+
+function isBag(value: unknown): value is Bag {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function fail(path: string, reason: string): never {
+  throw new RevenueFunnelShapeError(path, reason);
+}
+
+/**
+ * Liczba całkowita >= 0. `count(*)` to `bigint`, który przy dużych wartościach
+ * bywa napisem - napis cyfr przyjmujemy, każdy inny typ odrzucamy.
+ */
+function count(source: Bag, path: string, key: string): number {
+  if (!(key in source)) fail(`${path}${key}`, "brak pola");
+  const value = source[key];
+  const parsed =
+    typeof value === "number"
+      ? value
+      : typeof value === "string" && /^\d+$/.test(value.trim())
+        ? Number(value)
+        : Number.NaN;
+  if (!Number.isSafeInteger(parsed) || parsed < 0) {
+    fail(`${path}${key}`, "oczekiwano liczby całkowitej >= 0");
+  }
+  return parsed;
+}
+
+/** Ułamek w [0, 1] albo `null`. Numeric z SQL bywa napisem - też przyjmujemy. */
+function fraction(source: Bag, key: string): number | null {
+  if (!(key in source)) fail(key, "brak pola");
+  const value = source[key];
+  if (value === null) return null;
+  const parsed =
+    typeof value === "number"
+      ? value
+      : typeof value === "string" && value.trim() !== ""
+        ? Number(value)
+        : Number.NaN;
+  // 1,7 w polu „udział" to nie 170 %, tylko procenty zamiast ułamka po
+  // stronie SQL - odrzucamy głośno, zamiast pokazać bzdurę.
+  if (!Number.isFinite(parsed) || parsed < 0 || parsed > 1) {
+    fail(key, "oczekiwano ułamka w [0, 1] albo null");
+  }
+  return parsed;
+}
+
+function instant(source: Bag, key: string, nullable: boolean): string | null {
+  if (!(key in source)) fail(key, "brak pola");
+  const value = source[key];
+  if (value === null && nullable) return null;
+  if (typeof value !== "string" || Number.isNaN(Date.parse(value))) {
+    fail(key, "oczekiwano znacznika czasu ISO");
+  }
+  return value;
+}
+
+function oneOf<T extends string>(source: Bag, key: string, allowed: readonly T[]): T {
+  const value = source[key];
+  if (typeof value !== "string" || !(allowed as readonly string[]).includes(value)) {
+    fail(key, `oczekiwano jednej z: ${allowed.join(", ")}`);
+  }
+  return value as T;
+}
+
+function signupSources(raw: unknown): RevenueFunnelSignupSource[] {
+  if (!Array.isArray(raw)) fail("signup_sources", "oczekiwano tablicy");
+  return raw.map((entry, i) => {
+    if (!isBag(entry) || !isSignupSource(entry.source)) {
+      fail(`signup_sources[${i}].source`, "nieznane źródło rejestracji");
+    }
+    return { source: entry.source, accounts: count(entry, `signup_sources[${i}].`, "accounts") };
+  });
+}
+
+function paywallReasons(raw: unknown): RevenueFunnelPaywallReason[] {
+  if (!Array.isArray(raw)) fail("paywall_reasons", "oczekiwano tablicy");
+  return raw.map((entry, i) => {
+    const path = `paywall_reasons[${i}].`;
+    if (!isBag(entry)) fail(path, "oczekiwano obiektu");
+    if (!(PAYWALL_HIT_REASONS as readonly unknown[]).includes(entry.reason)) {
+      fail(`${path}reason`, "nieznany powód uderzenia");
+    }
+    return {
+      reason: entry.reason as PaywallHitReason,
+      accounts: count(entry, path, "accounts"),
+      visitors: count(entry, path, "visitors"),
+      hits: count(entry, path, "hits"),
+    };
+  });
+}
+
+function selfServe(raw: Bag, amountsVisible: boolean): RevenueFunnelSelfServe {
+  const c = (key: (typeof FUNNEL_KEYS.counts)[number]) => count(raw, "", key);
+  if (!("paid_amount" in raw)) fail("paid_amount", "brak pola");
+  // Kwoty: admin dostaje listę (także pustą - zmierzone zero), editor `null`.
+  // Lista zdeformowana u admina to rozjazd kontraktu, nie „brak danych".
+  const paidAmount = raw.paid_amount === null ? null : parseMoneyByCurrency(raw.paid_amount);
+  if (raw.paid_amount !== null && paidAmount === null) {
+    fail("paid_amount", "oczekiwano listy kwot per waluta");
+  }
+  return {
+    accounts: c("accounts"),
+    activeAccounts: c("active_accounts"),
+    paywallHitAccounts: c("paywall_hit_accounts"),
+    paywallHitVisitors: c("paywall_hit_visitors"),
+    paywallHits: c("paywall_hits"),
+    paywallConvertedAccounts: c("paywall_converted_accounts"),
+    checkoutStarted: c("checkout_started"),
+    checkoutPaid: c("checkout_paid"),
+    checkoutAbandoned: c("checkout_abandoned"),
+    checkoutExpired: c("checkout_expired"),
+    firstPayments: c("first_payments"),
+    registeredPaid: c("registered_paid"),
+    signupFormViews: c("signup_form_views"),
+    signupFormSubmits: c("signup_form_submits"),
+    visitorsFirstParty: c("visitors_first_party"),
+    rates: {
+      registeredToPaid: fraction(raw, "registered_to_paid_rate"),
+      paywallConversion: fraction(raw, "paywall_conversion_rate"),
+      paywallHit: fraction(raw, "paywall_hit_rate"),
+      checkoutConversion: fraction(raw, "checkout_conversion_rate"),
+      checkoutAbandonment: fraction(raw, "checkout_abandonment_rate"),
+      couponRedemption: fraction(raw, "coupon_redemption_rate"),
+    },
+    paidAmount: amountsVisible ? paidAmount : null,
+    signupSources: signupSources(raw.signup_sources),
+    paywallReasons: paywallReasons(raw.paywall_reasons),
+    paywallDataSince: instant(raw, "paywall_data_since", true),
+  };
+}
+
+function sales(raw: unknown): RevenueFunnelSales {
+  if (!isBag(raw)) fail("sales", "oczekiwano obiektu");
+  if (!Array.isArray(raw.stages)) fail("sales.stages", "oczekiwano tablicy");
+  const stages = raw.stages.map((entry, i) => {
+    const path = `sales.stages[${i}].`;
+    if (!isBag(entry) || !(SALES_FUNNEL_STAGES as readonly unknown[]).includes(entry.stage)) {
+      fail(`${path}stage`, "nieznany etap toru sprzedaży");
+    }
+    return { stage: entry.stage as SalesFunnelStage, leads: count(entry, path, "leads") };
+  });
+  return {
+    stages,
+    openTasks: count(raw, "sales.", "open_tasks"),
+    overdueTasks: count(raw, "sales.", "overdue_tasks"),
+    doneTasks: count(raw, "sales.", "done_tasks"),
+  };
+}
+
+/** Parser wyniku RPC; rzuca `RevenueFunnelShapeError` przy złym kształcie. */
+export function parseRevenueFunnel(raw: unknown): RevenueFunnelDto {
+  if (!isBag(raw)) fail("$", "oczekiwano obiektu");
+  const track: RevenueTrack = oneOf(raw, "track", REVENUE_TRACKS);
+  const segment: RevenueSegment = oneOf(raw, "segment", REVENUE_SEGMENTS);
+  if (typeof raw.amounts_visible !== "boolean") fail("amounts_visible", "oczekiwano boolean");
+  const amountsVisible = raw.amounts_visible;
+  const wantsSelf = track !== "sales";
+  const wantsSales = track !== "self_serve";
+  if (!("sales" in raw)) fail("sales", "brak pola");
+  if (!wantsSales && raw.sales !== null) fail("sales", "tor self_serve nie niesie sprzedaży");
+  return {
+    since: instant(raw, "since", false) as string,
+    until: instant(raw, "until", false) as string,
+    segment,
+    track,
+    amountsVisible,
+    selfServe: wantsSelf ? selfServe(raw, amountsVisible) : null,
+    sales: wantsSales ? sales(raw.sales) : null,
+  };
+}
