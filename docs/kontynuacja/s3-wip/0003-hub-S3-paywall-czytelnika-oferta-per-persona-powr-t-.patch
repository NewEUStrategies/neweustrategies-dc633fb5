+  it("brak czegokolwiek do kupienia: gość dostaje rejestrację, zalogowany - nic", () => {
+    const rule = accessRule({ mode: "paid", plan_ids: ["nieistniejacy"] });
+    expect(resolvePaywallOffer(rule, TIERS, CATALOG, guest).ctaKind).toBe("register");
