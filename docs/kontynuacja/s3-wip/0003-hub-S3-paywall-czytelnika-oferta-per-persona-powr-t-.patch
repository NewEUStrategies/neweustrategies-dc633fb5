+const ENTITY = "00000000-0000-4000-8000-0000000000aa";
+const BODY_SENTINEL = "TRESC-ARTYKULU-ZA-SCIANA";
+const TEASER = "Zajawka dla każdego czytelnika";
+
+const h = vi.hoisted(() => ({
