# Example environment configuration. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored and MUST NOT be committed. Only the VITE_*-prefixed
# values below are exposed to the client bundle (safe to be public). Every
# other value is a server-only secret - never add a VITE_ prefix to a secret.

# ---------------------------------------------------------------------------
# Public client config (VITE_ prefix -> bundled into the browser app)
# These are safe to expose: the publishable/anon key is gated by Supabase RLS.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-readable mirrors of the public Supabase config (no VITE_ prefix).
# Some server handlers read these instead of the VITE_ versions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Server-only secrets (injected at deploy time - NEVER commit real values,
# NEVER add a VITE_ prefix; that would leak them into the client bundle).
# ---------------------------------------------------------------------------

# Supabase service-role key - bypasses RLS. Used only by *.server.ts handlers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection string (contains the DB password).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Stripe (billing / checkout / webhooks).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ElevenLabs (text-to-speech for the /api/tts route).
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Klucz API platformy hostingowej. Uwierzytelnia gateway connectora Resend (wysylka
# kampanii i dren kolejki pocztowej) oraz zapasowego nadawce poczty platformy.
LOVABLE_API_KEY=your-platform-api-key

# Klucz API Resend przekazywany do gatewaya connectora
# (src/lib/email/provider.server.ts). Bez niego CALA poczta wychodzaca -
# kampanie, maile transakcyjne i autoryzacyjne z kolejki - spada na zapasowego
# dostawce, ktory NIE zwraca identyfikatora wiadomosci. Bez tego identyfikatora
# webhook odbicia/skargi nie ma jak skorelowac zdarzenia z odbiorca, wiec petla
# zwrotna dostarczalnosci domyka sie tylko czesciowo (patrz docs/ARCHITECTURE.md
# par. 11.3).
RESEND_API_KEY=re_xxx

# Opcjonalne nadpisanie adresu zapasowego dostawcy poczty (diagnostyka / staging).
# LOVABLE_SEND_URL=https://...

# Resend webhook signing secret (Svix). Wymagany, by platforma konsumowala
# zdarzenia dostarczalnosci (bounce / complaint / delivered) i utrzymywala
# liste wykluczen - bez niego POST /api/public/webhooks/resend zwraca 503,
# lista nie rosnie, a wskaznik zglaszania spamu moze po cichu przekroczyc
# prog 0,30% z wytycznych Google dla nadawcow masowych.
# Panel Resend -> Webhooks -> endpoint {PUBLIC_SITE_URL}/api/public/webhooks/resend,
# zdarzenia: email.sent, email.delivered, email.delivery_delayed,
# email.bounced, email.complained, email.failed.
RESEND_WEBHOOK_SECRET=whsec_xxx

# Zrodlo prawdy dla zdarzen zaangazowania newslettera (open / click).
#   first_party (domyslne) - piksel /api/public/nl-open i przekierowanie
#                            /api/public/nl-click, oba podpisane HMAC-em per
#                            (kampania, subskrybent),
#   provider               - zdarzenia email.opened / email.clicked z webhooka
#                            dostawcy poczty.
# DOKLADNIE JEDNO z tych zrodel zapisuje wiersze do newsletter_campaign_events.
# Oba mierza to samo tym samym mechanizmem (piksel obrazka, przepisany link),
# wiec gdy pisza rownolegle, kazde otwarcie liczy sie dwa razy i wskaznik
# otwarc przekracza 100%. Wartosc nieznana spada na domyslna - literowka nie
# moze wyciszyc telemetrii w OBU sciezkach. Niezaleznie od tego ustawienia
# webhook dostawcy nadal prowadzi dziennik dostarczalnosci (email_delivery_events)
# i liste wykluczen - to sa jego wlasciwe zadania.
# NEWSLETTER_ENGAGEMENT_SOURCE=first_party

# WordPress.com import API key.
WORDPRESS_COM_API_KEY=your-wordpress-com-api-key

# Web Push (VAPID) - notification delivery to browsers. Generate a P-256 pair
# with generateVapidKeys() from src/lib/notifications/webpush.server.ts.
# The public key is safe to expose (VITE_ prefix); the private key is NOT.
VAPID_PUBLIC_KEY=base64url-p256-public-key
VAPID_PRIVATE_KEY=base64url-p256-private-key
VAPID_SUBJECT=mailto:marketing@neweuropeanstrategies.com
VITE_VAPID_PUBLIC_KEY=base64url-p256-public-key

# Shared secret for /api/public/community-cron (push queue, e-mail digests,
# event + CRM reminders) - both the POST tick and the GET health probe.
#
# This is the secret the REPO scheduler uses: put the same value in the GitHub
# repository secret COMMUNITY_CRON_SECRET and set the APP_BASE_URL variable
# (see .github/workflows/scheduler.yml). The endpoint also accepts
# job_runner_settings.secret from the database, so leaving this unset is fine
# when you prefer a single DB-side secret.
#
# The primary schedule is pg_cron + pg_net -> /api/public/jobs-tick (every
# minute, secret stored in job_runner_settings); this one is the safety net and
# the bootstrap that arms the primary path. Details: docs/RUNBOOK_COMMUNITY.md.
COMMUNITY_CRON_SECRET=long-random-string

# ---------------------------------------------------------------------------
# Site URL (used to build absolute links in checkout, emails, etc.).
# The app reads the first of PUBLIC_SITE_URL / SITE_URL / URL that is set;
# in most hosting environments one of these is provided automatically.
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://your-domain.example
# SITE_URL=https://your-domain.example
# URL=https://your-domain.example

# ---------------------------------------------------------------------------
# NES Edge Cache (SSR document cache) kill switch. Unset/anything else = ON.
# Set to "off" to bypass both layers (per-isolate memory + per-colo Cache API)
# while diagnosing rendering issues; requests then always hit the full SSR
# pipeline. See src/lib/http/documentCache.server.ts.
# ---------------------------------------------------------------------------
# NES_EDGE_CACHE=off

# ---------------------------------------------------------------------------
# SSR document stream guard (src/lib/http/documentStreamGuard.server.ts):
# guarantees every text/html response body terminates. Unset = ON with the
# defaults below; set SSR_DOC_GUARD=off only while diagnosing streaming.
# ---------------------------------------------------------------------------
# SSR_DOC_GUARD=off
# SSR_DOC_GUARD_GRACE_MS=250
# SSR_DOC_GUARD_IDLE_MS=12000
# SSR_DOC_GUARD_MAX_MS=20000

# ---------------------------------------------------------------------------
# Hard deadline (ms) for anon-plane Supabase round-trips during SSR
# (src/integrations/supabase/tenant-host-fetch.ts). Frees the Workers
# subrequest slot when an upstream hangs. 0/off disables; unset = 8000.
# ---------------------------------------------------------------------------
# SSR_DB_DEADLINE_MS=8000

# ---------------------------------------------------------------------------
# Płatności (Stripe; dawniej Paddle). Wartości pochodzą wyłącznie ze zmiennych
# środowiskowych - nigdy nie zapisuj ich w kodzie. Token klienta jest publiczny
# (bundle przeglądarki), klucze API i sekrety webhooków są serwerowe.
#
# NAZWY MUSZĄ SIĘ ZGADZAĆ CO DO ZNAKU z src/lib/stripe.server.ts. Nagłówek tej
# sekcji wymieniał nazwy poprzedniego operatora jeszcze długo po migracji, przez
# co konfiguracja „z przykładu" cicho nie działała, a nocna sonda rozliczeń
# przez cały ten czas kończyła się na zielono, nie wykonując żadnego żądania.
#
# VITE_PAYMENTS_CLIENT_TOKEN: test_... w podglądzie, live_... w produkcji
#   (podmieniany przy buildzie produkcyjnym).
# STRIPE_SANDBOX_API_KEY: ten sam sekret trafia do GitHub Actions - używa go
#   nocna sonda odnowienia (.github/workflows/billing-nightly.yml).
# ---------------------------------------------------------------------------
# VITE_PAYMENTS_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SANDBOX_API_KEY=
# STRIPE_LIVE_API_KEY=
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=
# PAYMENTS_LIVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# POSWIADCZENIE HOSTA (izolacja tenanta w bazie, migracja 20260805090000).
#
# `x-tenant-host` jest DEKLARACJA klienta: przez PostgREST kazdy z kluczem anon
# poda dowolna zarejestrowana domene. Poswiadczenie to HMAC-SHA256 krawedzi nad
# `v1:<kid>:<host>:<exp>`, ktorego klient nie wytworzy - baza odroznia po nim
# ruch platformy od surowego wywolania API i tylko poswiadczonemu hostowi
# pozwala wskazac tenanta innego niz DOMOWY tenant zalogowanego wolajacego.
#
# Ten sam sekret musi trafic do Vaulta pod tym samym `kid`:
#   select public.set_tenant_host_assertion_key('edge1', '<sekret>');
#
# BEZ KLUCZA NIC SIE NIE PSUJE: nie ma szczebla VERIFIED, wiec zalogowani sa
# zawsze przypieci do tenanta domowego (degradacja w strone BEZPIECZNA).
# Klucz jest potrzebny, gdy ZALOGOWANY czlonek jednego tenanta ma czytac
# publiczna tresc DRUGIEGO tenanta. Minimum 32 znaki.
# ---------------------------------------------------------------------------
# TENANT_HOST_ASSERTION_KEY=  # openssl rand -hex 32
# TENANT_HOST_ASSERTION_KID=edge1

# ---------------------------------------------------------------------------
# Klasyfikacja hostow SEO (src/lib/http/host.ts). Listy rozdzielane przecinkami,
# kropka na poczatku opcjonalna. Kazdy wpis jest decyzja ISTOTNA dla
# bezpieczenstwa - poszerza fail-open planu crawlera albo rozluznia CSP - dlatego
# jest konfiguracja wdrozenia, a nie stala w zrodle.
#
# PREVIEW_HOST_SUFFIXES  - domeny podgladu tenanta DOMYSLNEGO (dev/staging).
# LEGACY_HOST_SUFFIXES   - domeny historyczne: 301 na origin kanoniczny
#                          + "Disallow: /" w robots.txt.
# EDITOR_HOST_SUFFIXES   - domeny edytora/iframe podgladu: bez kanonizacji,
#                          z luzniejszym CSP (frame-ancestors, unsafe-eval).
# PUBLIC_SITE_HOST       - host osadzajacy odtwarzacze zewnetrzne (Twitch
#                          wymaga zgodnosci `parent` z realnym hostem);
#                          domyslnie neweuropeanstrategies.com.
# ---------------------------------------------------------------------------
# PREVIEW_HOST_SUFFIXES=.preview.example
# LEGACY_HOST_SUFFIXES=.old-domain.example
# EDITOR_HOST_SUFFIXES=.editor.example
# PUBLIC_SITE_HOST=neweuropeanstrategies.com

# ---------------------------------------------------------------------------
# BILLING_RETURN_HOSTS - lista hostow (przecinkami), na ktore wolno odeslac
# klienta PO PLATNOSCI (`return_url` portalu klienta i sesji checkoutu,
# src/lib/billing/returnUrl.server.ts). Host spoza listy jest CICHO podmieniany
# na origin kanoniczny (PUBLIC_SITE_URL), wiec podrobiony naglowek `origin` /
# `x-forwarded-host` nie przeniesie powrotu na obca domene.
#
# Domyslnie dozwolone bez konfiguracji: origin z PUBLIC_SITE_URL (wraz z
# odpowiednikiem www/apex), hosty marki i lokalny dev (localhost, 127.0.0.1,
# ::1, *.localhost). Ta zmienna jest ODBICIEM `tenants.domain` /
# `tenants.aliases` dla wdrozen serwujacych wiecej niz jedna domene - bramka
# jest synchroniczna i celowo NIE pyta bazy (uzasadnienie w naglowku modulu).
# Kazdy wpis dopuszcza tez swoj odpowiednik www/apex.
# ---------------------------------------------------------------------------
# BILLING_RETURN_HOSTS=tenant-a.example,tenant-b.example
